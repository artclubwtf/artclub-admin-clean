{% assign meta = page.metafields.custom %}
{% assign collection = meta.uf-contents_collection.value %}

<div class="ac-uf-contents">

  {%- comment -%} HERO {%- endcomment -%}
  {% if meta.uf-contents_hero_image.value %}
    <div class="ac-uf-contents__hero">
      <img
        src="{{ meta.uf-contents_hero_image.value | image_url: width: 1600 }}"
        alt="{{ meta.uf-contents_hero_headline.value | default: page.title }}"
        loading="eager"
        class="ac-uf-contents__hero-img">
      <div class="ac-uf-contents__hero-overlay">
        <div class="ac-uf-contents__hero-text">
          {% if meta.uf-contents_hero_kicker.value %}
            <p class="ac-uf-contents__kicker">{{ meta.uf-contents_hero_kicker.value }}</p>
          {% endif %}
          <h1 class="ac-uf-contents__h1">{{ meta.uf-contents_hero_headline.value | default: page.title }}</h1>
          {% if meta.uf-contents_hero_subtext.value %}
            <p class="ac-uf-contents__subtext">{{ meta.uf-contents_hero_subtext.value }}</p>
          {% endif %}
          {% if collection %}
            <a href="{{ collection.url }}" class="ac-uf-contents__hero-btn">Alle Werke entdecken</a>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  {%- comment -%} TRUST BAR {%- endcomment -%}
  {% if meta.uf-contents_stats.value %}
    {% assign stats = meta.uf-contents_stats.value | parse_json %}
    <div class="ac-uf-contents__trustbar">
      {% for stat in stats %}
        <div class="ac-uf-contents__trust-item">
          <span class="ac-uf-contents__trust-value">{{ stat.value }}</span>
          <span class="ac-uf-contents__trust-label">{{ stat.label }}</span>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {%- comment -%} INTRO TEXT (über Produkte) {%- endcomment -%}
  {% if meta.uf-contents_body_text_1.value %}
    <div class="ac-uf-contents__intro-text">
      <div class="ac-uf-contents__intro-inner">
        {{ meta.uf-contents_body_text_1.value | newline_to_br }}
      </div>
    </div>
  {% endif %}

  {%- comment -%} PRODUCT GRID {%- endcomment -%}
  {% if collection %}
    <div class="ac-uf-contents__grid-wrap">
      <div class="ac-uf-contents__grid-header">
        <p class="ac-uf-contents__section-label">{{ collection.title }}</p>
        <a href="{{ collection.url }}" class="ac-uf-contents__grid-all">Alle ansehen →</a>
      </div>
      <div class="ac-uf-contents__grid">
        {% for product in collection.products limit: 8 %}
          <a href="{{ product.url }}" class="ac-uf-contents__product">
            <div class="ac-uf-contents__product-img-wrap">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title }}"
                  loading="lazy"
                  class="ac-uf-contents__product-img">
              {% else %}
                <div class="ac-uf-contents__product-img-placeholder"></div>
              {% endif %}
              {% unless product.available %}
                <div class="ac-uf-contents__product-badge">Verkauft</div>
              {% endunless %}
            </div>
            <div class="ac-uf-contents__product-info">
              <div class="ac-uf-contents__product-top">
                <p class="ac-uf-contents__product-title">{{ product.title }}</p>
                <p class="ac-uf-contents__product-price">{{ product.price | money }}</p>
              </div>
              <p class="ac-uf-contents__product-vendor">{{ product.vendor }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
      <div class="ac-uf-contents__grid-footer">
        <a href="{{ collection.url }}" class="ac-uf-contents__load-more">Weitere Werke ansehen</a>
      </div>
    </div>
  {% endif %}

  {%- comment -%} TRUST CARDS {%- endcomment -%}
  <div class="ac-uf-contents__trust-cards">
    <div class="ac-uf-contents__trust-card">
      <div class="ac-uf-contents__trust-card-icon">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 2L12.4 7.6L18 8.4L14 12.4L14.9 18L10 15.3L5.1 18L6 12.4L2 8.4L7.6 7.6L10 2Z" stroke="#111" stroke-width="1.2" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="ac-uf-contents__trust-card-title">Kuratierte Originale</p>
      <p class="ac-uf-contents__trust-card-text">Jedes Werk handverlesen – kein Massenmarkt, nur echte künstlerische Positionen.</p>
    </div>
    <div class="ac-uf-contents__trust-card">
      <div class="ac-uf-contents__trust-card-icon">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="10" cy="10" r="8" stroke="#111" stroke-width="1.2"/>
          <path d="M10 6v4l2.5 2.5" stroke="#111" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="ac-uf-contents__trust-card-title">100 % an den Künstler</p>
      <p class="ac-uf-contents__trust-card-text">Keine Galerie-Provision. Was du zahlst, bekommt der Künstler – vollständig.</p>
    </div>
    <div class="ac-uf-contents__trust-card">
      <div class="ac-uf-contents__trust-card-icon">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="6" width="14" height="10" rx="2" stroke="#111" stroke-width="1.2"/>
          <path d="M7 6V5a3 3 0 016 0v1" stroke="#111" stroke-width="1.2"/>
        </svg>
      </div>
      <p class="ac-uf-contents__trust-card-title">Echtheitszertifikat</p>
      <p class="ac-uf-contents__trust-card-text">Jedes Werk kommt handsigniert mit Zertifikat. Kein Druck, kein Fake.</p>
    </div>
    <div class="ac-uf-contents__trust-card">
      <div class="ac-uf-contents__trust-card-icon">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 10h14M10 3l7 7-7 7" stroke="#111" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="ac-uf-contents__trust-card-title">Sichere Lieferung</p>
      <p class="ac-uf-contents__trust-card-text">Versichert verpackt, deutschlandweit. Berlin-Übergabe auf Wunsch persönlich.</p>
    </div>
  </div>

  {%- comment -%} BODY TEXT 2 (unter Produkte, uf-contents) {%- endcomment -%}
  {% if meta.uf-contents_body_text_2.value %}
    <div class="ac-uf-contents__uf-contents-text">
      <div class="ac-uf-contents__uf-contents-text-inner">
        <div class="ac-uf-contents__uf-contents-col">{{ meta.uf-contents_body_text_2.value | newline_to_br }}</div>
      </div>
    </div>
  {% endif %}

  {%- comment -%} FAQ {%- endcomment -%}
  {% if meta.uf-contents_faq.value %}
    {% assign faqs = meta.uf-contents_faq.value | parse_json %}
    <div class="ac-uf-contents__faq">
      <p class="ac-uf-contents__section-label">Häufige Fragen</p>
      {% for item in faqs %}
        <details class="ac-uf-contents__faq-item">
          <summary class="ac-uf-contents__faq-q">
            {{ item.question }}
            <span class="ac-uf-contents__faq-icon">+</span>
          </summary>
          <p class="ac-uf-contents__faq-a">{{ item.answer }}</p>
        </details>
      {% endfor %}
    </div>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for item in faqs %}
        {
          "@type": "Question",
          "name": {{ item.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ item.answer | json }}
          }
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
    </script>
  {% endif %}

  {%- comment -%} uf-contents TAGS {%- endcomment -%}
  {% if meta.uf-contents_tags_uf-contents.value %}
    <div class="ac-uf-contents__tags">
      {% for tag in meta.uf-contents_tags_uf-contents.value %}
        <span class="ac-uf-contents__tag">{{ tag }}</span>
      {% endfor %}
    </div>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "ARTCLUB", "item": "{{ shop.url }}" },
      { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": "{{ shop.url }}{{ page.url }}" }
    ]
  }
  </script>

</div>

{% schema %}
{
  "name": "uf-contents Landing Page",
  "tag": "section",
  "class": "ac-uf-contents-section",
  "settings": [],
  "presets": [{ "name": "uf-contents Landing Page" }]
}
{% endschema %}

{% stylesheet %}

.ac-uf-contents *,
.ac-uf-contents *::before,
.ac-uf-contents *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.ac-uf-contents {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  color: #111;
  background: #fff;
}

/* ─── Hero ───────────────────────────────────────── */
.ac-uf-contents__hero {
  position: relative;
  width: calc(100% - 3rem);
  margin: 1.5rem auto 0;
  height: 80vh;
  min-height: 480px;
  max-height: 720px;
  overflow: hidden;
  background: #111;
  border-radius: 20px;
}

.ac-uf-contents__hero-img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center !important;
  display: block !important;
  opacity: 0.55;
}

.ac-uf-contents__hero-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 3.5rem;
}

.ac-uf-contents__hero-text {
  max-width: 620px;
}

.ac-uf-contents__kicker {
  font-size: 11px !important;
  letter-spacing: 0.16em !important;
  text-transform: uppercase !important;
  color: rgba(255,255,255,0.55) !important;
  margin-bottom: 0.75rem !important;
  font-weight: 400 !important;
}

.ac-uf-contents__h1 {
  font-size: clamp(32px, 4.5vw, 56px) !important;
  font-weight: 300 !important;
  line-height: 1.08 !important;
  letter-spacing: -0.025em !important;
  color: #fff !important;
  margin-bottom: 1rem !important;
}

.ac-uf-contents__subtext {
  font-size: 15px !important;
  color: rgba(255,255,255,0.65) !important;
  line-height: 1.65 !important;
  margin-bottom: 2rem !important;
  max-width: 440px;
  font-weight: 400 !important;
}

.ac-uf-contents__hero-btn {
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  padding: 12px 24px !important;
  background: rgba(255,255,255,0.15) !important;
  backdrop-filter: blur(8px) !important;
  -webkit-backdrop-filter: blur(8px) !important;
  border: 1px solid rgba(255,255,255,0.3) !important;
  color: #fff !important;
  font-size: 13px !important;
  letter-spacing: 0.04em !important;
  text-decoration: none !important;
  border-radius: 100px !important;
  font-weight: 400 !important;
  transition: background 0.2s;
}
.ac-uf-contents__hero-btn:hover {
  background: rgba(255,255,255,0.25) !important;
}

/* ─── Trust Bar ──────────────────────────────────── */
.ac-uf-contents__trustbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  padding: 1.75rem 2rem;
  border-bottom: 1px solid #f0f0f0;
}

.ac-uf-contents__trust-item {
  display: flex;
  align-items: center;
  gap: 10px;
}

.ac-uf-contents__trust-value {
  font-size: 18px !important;
  font-weight: 400 !important;
  color: #111 !important;
  letter-spacing: -0.01em;
}

.ac-uf-contents__trust-label {
  font-size: 12px !important;
  color: #aaa !important;
}

/* ─── Product Grid ───────────────────────────────── */
.ac-uf-contents__grid-wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}

.ac-uf-contents__grid-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
}

.ac-uf-contents__section-label {
  font-size: 11px !important;
  letter-spacing: 0.14em !important;
  text-transform: uppercase !important;
  color: #bbb !important;
  font-weight: 400 !important;
}

.ac-uf-contents__grid-all {
  font-size: 13px !important;
  color: #111 !important;
  text-decoration: none !important;
  letter-spacing: 0.02em;
}
.ac-uf-contents__grid-all:hover {
  opacity: 0.5 !important;
}

.ac-uf-contents__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.ac-uf-contents__product {
  text-decoration: none !important;
  color: inherit !important;
  display: block;
}

.ac-uf-contents__product-img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 3/4;
  overflow: hidden;
  background: #f7f7f7;
  margin-bottom: 12px;
  border-radius: 14px;
}

.ac-uf-contents__product-img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
  transition: transform 0.5s ease;
}

.ac-uf-contents__product:hover .ac-uf-contents__product-img {
  transform: scale(1.04);
}

.ac-uf-contents__product-img-placeholder {
  width: 100%;
  height: 100%;
  background: #f2f2f2;
}

.ac-uf-contents__product-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  font-size: 10px !important;
  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
  padding: 4px 10px;
  background: rgba(0,0,0,0.75);
  color: #fff !important;
  border-radius: 100px;
}

.ac-uf-contents__product-info {
  padding: 0 2px;
}

.ac-uf-contents__product-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 3px;
}

.ac-uf-contents__product-title {
  font-size: 13px !important;
  color: #111 !important;
  font-weight: 400 !important;
  line-height: 1.3 !important;
}

.ac-uf-contents__product-price {
  font-size: 13px !important;
  color: #111 !important;
  font-weight: 400 !important;
  white-space: nowrap;
}

.ac-uf-contents__product-vendor {
  font-size: 11px !important;
  color: #aaa !important;
  letter-spacing: 0.03em;
}

.ac-uf-contents__grid-footer {
  text-align: center;
  margin-top: 2.5rem;
}

.ac-uf-contents__load-more {
  display: inline-block !important;
  padding: 12px 28px !important;
  border: 1px solid #e0e0e0 !important;
  color: #111 !important;
  font-size: 13px !important;
  letter-spacing: 0.04em !important;
  text-decoration: none !important;
  border-radius: 100px !important;
  transition: border-color 0.15s, background 0.15s;
  background: none !important;
}
.ac-uf-contents__load-more:hover {
  border-color: #111 !important;
}

/* ─── Trust Cards ────────────────────────────────── */
.ac-uf-contents__trust-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem 3.5rem;
}

.ac-uf-contents__trust-card {
  background: #f9f9f9;
  border-radius: 16px;
  padding: 1.5rem;
}

.ac-uf-contents__trust-card-icon {
  width: 36px;
  height: 36px;
  background: #fff;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
}

.ac-uf-contents__trust-card-title {
  font-size: 14px !important;
  font-weight: 500 !important;
  color: #111 !important;
  margin-bottom: 6px !important;
  line-height: 1.3 !important;
}

.ac-uf-contents__trust-card-text {
  font-size: 13px !important;
  color: #888 !important;
  line-height: 1.6 !important;
  font-weight: 400 !important;
}

/* ─── Intro Text (über Grid) ─────────────────────── */
.ac-uf-contents__intro-text {
  padding: 2.5rem 1.5rem 0;
}

.ac-uf-contents__intro-inner {
  max-width: 1200px;
  margin: 0 auto;
  font-size: 16px !important;
  line-height: 1.75 !important;
  color: #555 !important;
  font-weight: 400 !important;
  max-width: 640px;
}

/* ─── uf-contents Text Block (unter Grid) ───────────────── */
.ac-uf-contents__uf-contents-text {
  border-top: 1px solid #f0f0f0;
  padding: 3rem 1.5rem;
}

.ac-uf-contents__uf-contents-text-inner {
  max-width: 1200px;
  margin: 0 auto;
}

.ac-uf-contents__uf-contents-col {
  font-size: 14px !important;
  line-height: 1.8 !important;
  color: #aaa !important;
  font-weight: 400 !important;
  max-width: 720px;
}

/* ─── FAQ ────────────────────────────────────────── */
.ac-uf-contents__faq {
  max-width: 720px;
  margin: 0 auto;
  padding: 0 1.5rem 3.5rem;
}

.ac-uf-contents__faq .ac-uf-contents__section-label {
  margin-bottom: 1.5rem !important;
  display: block;
}

.ac-uf-contents__faq-item {
  border-bottom: 1px solid #f0f0f0 !important;
}

.ac-uf-contents__faq-q {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  padding: 1.1rem 0 !important;
  font-size: 15px !important;
  font-weight: 400 !important;
  color: #111 !important;
  cursor: pointer !important;
  list-style: none !important;
  gap: 1rem;
}
.ac-uf-contents__faq-q::-webkit-details-marker { display: none !important; }

.ac-uf-contents__faq-icon {
  font-size: 18px !important;
  font-weight: 300 !important;
  color: #ccc !important;
  flex-shrink: 0;
  transition: transform 0.2s;
  line-height: 1;
}

details[open] .ac-uf-contents__faq-icon {
  transform: rotate(45deg);
}

.ac-uf-contents__faq-a {
  font-size: 14px !important;
  line-height: 1.75 !important;
  color: #888 !important;
  padding-bottom: 1.25rem !important;
  font-weight: 400 !important;
  max-width: 600px;
}

/* ─── Tags ───────────────────────────────────────── */
.ac-uf-contents__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  max-width: 720px;
  margin: 0 auto;
  padding: 0 1.5rem 4rem;
}

.ac-uf-contents__tag {
  font-size: 11px !important;
  padding: 5px 14px !important;
  border: 1px solid #eee !important;
  border-radius: 100px !important;
  color: #bbb !important;
  white-space: nowrap !important;
  background: none !important;
  letter-spacing: 0.02em;
}

/* ─── Responsive ─────────────────────────────────── */
@media (max-width: 1024px) {
  .ac-uf-contents__grid { grid-template-columns: repeat(3, 1fr); }
  .ac-uf-contents__trust-cards { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .ac-uf-contents__hero {
    width: calc(100% - 2rem);
    margin: 1rem auto 0;
    height: 70vw;
    min-height: 320px;
    border-radius: 16px;
  }
  .ac-uf-contents__hero-overlay { padding: 2rem; }
  .ac-uf-contents__trustbar { gap: 1.25rem; flex-wrap: wrap; justify-content: flex-start; }
  .ac-uf-contents__grid { grid-template-columns: repeat(2, 1fr); }
  .ac-uf-contents__trust-cards { grid-template-columns: repeat(2, 1fr); }
  .ac-uf-contents__grid-wrap, .ac-uf-contents__trust-cards { padding-left: 1rem; padding-right: 1rem; }
}

@media (max-width: 480px) {
  .ac-uf-contents__hero { border-radius: 12px; }
  .ac-uf-contents__grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .ac-uf-contents__trust-cards { grid-template-columns: 1fr 1fr; gap: 10px; }
}

{% endstylesheet %}
