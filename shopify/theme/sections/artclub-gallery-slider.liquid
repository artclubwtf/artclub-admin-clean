{% schema %}
{
  "name": "Artclub Slider",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding oben",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding unten",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding links",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Artwork",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Artwork Image"
        },
        {
          "type": "text",
          "id": "artist_name",
          "label": "Artist Name",
          "default": "Beispiel Künstler"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link zur Produktseite"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Artwork Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Artclub Slider",
      "settings": {
        "padding_top": 20,
        "padding_bottom": 20,
        "padding_left": 40
      },
      "blocks": [
        {
          "type": "image",
          "settings": {
            "artist_name": "Wolfgang Uhlig",
            "link": "/collections/all"
          }
        },
        {
          "type": "image",
          "settings": {
            "artist_name": "Luc Dratwa",
            "link": "/collections/all"
          }
        },
        {
          "type": "image",
          "settings": {
            "artist_name": "Sebastian Magnani",
            "link": "/collections/all"
          }
        },
        {
          "type": "image",
          "settings": {
            "artist_name": "Werner Pawlok",
            "link": "/collections/all"
          }
        },
        {
          "type": "image",
          "settings": {
            "artist_name": "Claudio Gotsch",
            "link": "/collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .artclub-slider-container {
    position: relative;
    max-width: 100%;
    margin: auto;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .artclub-slider-wrapper {
    display: flex;
    gap: 16px;
    scroll-snap-type: x mandatory;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-left: {{ section.settings.padding_left }}px; /* Fixiertes Padding links */
  }

  .artclub-slider-wrapper::-webkit-scrollbar {
    display: none;
  }

  .artclub-slide {
    flex: 0 0 auto;
    width: 300px;
    height: 450px!important;
    object-fit: cover;
    scroll-snap-align: start;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease-in-out;
  }

  .artclub-slide:hover {
    width: 340px;
  }

  .artclub-slide a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .artclub-slide img {
    width: 100%;
    height: 450px!important;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease-in-out;
  }

  .artclub-slide:hover img {
    width: 100%;
    height: 450px!important;
  }

  .artclub-text {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 14px;
  }

  /* Slider Buttons */
  .slider-controls {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 10px;
  }

  .slider-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 18px;
    color: #333;
  }

  .slider-btn:hover {
    color: black;
  }
</style>

<div class="artclub-slider-container">
  <div class="artclub-slider-wrapper" id="artclubSlider">
    {% for block in section.blocks %}
      <div class="artclub-slide">
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">
        {% endif %}
        {% if block.settings.image %}
          <img src="{{ block.settings.image | img_url: 'large' }}" alt="{{ block.settings.alt_text }}">
        {% else %}
          <img src="https://via.placeholder.com/300x400?text=Artwork" alt="Platzhalter Artwork">
        {% endif %}
        <div class="artclub-text">{{ block.settings.artist_name }}</div>
        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="slider-controls">
    <button class="slider-btn" onclick="moveSlide(-1)">&#9665;</button>
    <button class="slider-btn" onclick="moveSlide(1)">&#9655;</button>
  </div>
</div>

<script>
  let slider = document.getElementById('artclubSlider');

  function moveSlide(direction) {
    let scrollAmount = 320;
    slider.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
  }

  let isDragging = false;
  let startX, scrollLeft;

  slider.addEventListener('mousedown', (e) => {
    isDragging = true;
    startX = e.pageX - slider.offsetLeft;
    scrollLeft = slider.scrollLeft;
  });

  slider.addEventListener('mouseleave', () => isDragging = false);
  slider.addEventListener('mouseup', () => isDragging = false);
  slider.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    e.preventDefault();
    let x = e.pageX - slider.offsetLeft;
    let walk = (x - startX) * 2;
    slider.scrollLeft = scrollLeft - walk;
  });

  slider.addEventListener('touchstart', (e) => {
    startX = e.touches[0].pageX - slider.offsetLeft;
    scrollLeft = slider.scrollLeft;
  }, { passive: true });

  slider.addEventListener('touchmove', (e) => {
    let x = e.touches[0].pageX - slider.offsetLeft;
    let walk = (x - startX) * 2;
    slider.scrollLeft = scrollLeft - walk;
  }, { passive: true });
</script>
