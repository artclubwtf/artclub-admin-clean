    document.querySelectorAll('#ac-wrap [data-de]').forEach(function(el) {
      var text = el.getAttribute('data-' + lang);
      if (text) el.innerHTML = text;
    });
    document.getElementById('ac-btn-de').classList.toggle('active', lang === 'de');
    document.getElementById('ac-btn-en').classList.toggle('active', lang === 'en');
  }
</script>

