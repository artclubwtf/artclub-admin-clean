<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  #ac-wrap {
    --ac-black: #0a0a0a;
    --ac-white: #ffffff;
    --ac-bg: #f7f6f2;
    --ac-mid: #6b6b6b;
    --ac-border: #e2e1dc;
    --ac-font: 'Inter', sans-serif;
    font-family: var(--ac-font);
    font-size: 13px;
    line-height: 1.7;
    color: var(--ac-black);
    background: var(--ac-bg);
    padding: 40px;
    border-radius: 12px;
  }
  #ac-wrap * { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── TOPBAR ── */
  #ac-wrap .ac-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--ac-border);
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 12px;
  }
  #ac-wrap .ac-logo {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ac-black);
  }
  #ac-wrap .ac-lang-toggle {
    display: flex;
    border: 1px solid var(--ac-border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--ac-white);
  }
  #ac-wrap .ac-lang-btn {
    background: transparent;
    border: none;
    color: var(--ac-mid);
    font-family: var(--ac-font);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 6px 14px;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.15s;
  }
  #ac-wrap .ac-lang-btn.active {
    background: var(--ac-black);
    color: #ffffff;
  }

  /* ── HERO ── */
  #ac-wrap .ac-hero {
    margin-bottom: 36px;
  }
  #ac-wrap .ac-eyebrow {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ac-mid);
    margin-bottom: 12px;
    display: block;
  }
  #ac-wrap h1 {
    font-size: clamp(26px, 4vw, 42px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ac-black);
    margin-bottom: 16px;
    font-family: var(--ac-font);
  }
  #ac-wrap .ac-meta {
    font-size: 12px;
    color: var(--ac-mid);
    line-height: 1.8;
  }

  /* ── KPI ROW ── */
  #ac-wrap .ac-kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 36px;
  }
  #ac-wrap .ac-kpi {
    background: var(--ac-white);
    border: 1px solid var(--ac-border);
    border-radius: 10px;
    padding: 16px;
  }
  #ac-wrap .ac-kpi-val {
    font-size: 26px;
    font-weight: 600;
    color: var(--ac-black);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  #ac-wrap .ac-kpi-label {
    font-size: 11px;
    color: var(--ac-mid);
    margin-top: 5px;
    line-height: 1.4;
  }

  /* ── GRID ── */
  #ac-wrap .ac-section-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ac-mid);
    margin-bottom: 14px;
    display: block;
  }
  #ac-wrap .ac-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 8px;
    margin-bottom: 40px;
  }
  #ac-wrap .ac-card {
    background: var(--ac-white);
    border: 1px solid var(--ac-border);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.15s;
    cursor: default;
  }
  #ac-wrap .ac-card:hover { border-color: #b0afab; }
  #ac-wrap .ac-card-top {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  #ac-wrap .ac-card-icon {
    width: 30px;
    height: 30px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #ac-wrap .ac-card-right { flex: 1; }
  #ac-wrap .ac-card-num {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--ac-mid);
    text-transform: uppercase;
    margin-bottom: 3px;
    display: block;
  }
  #ac-wrap .ac-card-title {
    font-size: 12px;
    font-weight: 500;
    color: var(--ac-black);
    line-height: 1.3;
  }
  #ac-wrap .ac-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  #ac-wrap .ac-pill {
    font-size: 10px;
    font-weight: 400;
    padding: 2px 8px;
    border-radius: 100px;
    line-height: 1.6;
    white-space: nowrap;
  }
  #ac-wrap .p-gray  { background: #f0efea; color: #5f5e5a; }
  #ac-wrap .p-blue  { background: #e8f1fb; color: #1a5fa0; }
  #ac-wrap .p-teal  { background: #e0f5ee; color: #0d6e54; }
  #ac-wrap .p-amber { background: #faeeda; color: #844f0b; }
  #ac-wrap .p-coral { background: #faece7; color: #943a1c; }
  #ac-wrap .p-purple{ background: #eeedfe; color: #5049b4; }
  #ac-wrap .i-blue  { background: #e8f1fb; }
  #ac-wrap .i-teal  { background: #e0f5ee; }
  #ac-wrap .i-amber { background: #faeeda; }
  #ac-wrap .i-coral { background: #faece7; }
  #ac-wrap .i-purple{ background: #eeedfe; }
  #ac-wrap .i-gray  { background: #f0efea; }

  /* ── DIVIDER ── */
  #ac-wrap .ac-divider {
    height: 1px;
    background: var(--ac-border);
    margin: 0 0 40px;
  }

  /* ── TOC ── */
  #ac-wrap .ac-toc {
    margin-bottom: 40px;
  }
  #ac-wrap .ac-toc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px 40px;
    list-style: none;
    margin-top: 12px;
  }
  #ac-wrap .ac-toc-grid a {
    color: var(--ac-black);
    text-decoration: none;
    font-size: 12px;
    display: flex;
    gap: 10px;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
    align-items: baseline;
  }
  #ac-wrap .ac-toc-grid a:hover { border-bottom-color: var(--ac-black); }
  #ac-wrap .ac-toc-num {
    font-size: 10px;
    color: var(--ac-mid);
    min-width: 26px;
    font-weight: 500;
  }

  /* ── SECTIONS ── */
  #ac-wrap .ac-section {
    border-top: 1px solid var(--ac-border);
    padding: 32px 0;
  }
  #ac-wrap .ac-section:last-of-type { border-bottom: 1px solid var(--ac-border); }
  #ac-wrap .ac-section-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 20px;
  }
  #ac-wrap .ac-s-num {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--ac-mid);
    min-width: 30px;
    text-transform: uppercase;
  }
  #ac-wrap .ac-s-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ac-black);
  }
  #ac-wrap .ac-clause {
    display: flex;
    gap: 14px;
    margin-bottom: 12px;
    padding-left: 44px;
  }
  #ac-wrap .ac-c-num {
    font-size: 11px;
    color: var(--ac-mid);
    min-width: 28px;
    flex-shrink: 0;
    padding-top: 1px;
    font-weight: 400;
  }
  #ac-wrap .ac-c-text {
    font-size: 13px;
    line-height: 1.75;
    color: #1c1c1c;
  }
  #ac-wrap .ac-c-text strong {
    font-weight: 600;
    display: block;
    margin: 10px 0 4px;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ac-black);
  }
  #ac-wrap .ac-c-text strong:first-child { margin-top: 0; }

  /* ── FOOTER ── */
  #ac-wrap .ac-footer {
    padding-top: 28px;
    font-size: 11px;
    color: var(--ac-mid);
    line-height: 1.9;
  }

  @media (max-width: 640px) {
    #ac-wrap { padding: 24px 20px; }
    #ac-wrap .ac-kpi-row { grid-template-columns: repeat(2, 1fr); }
    #ac-wrap .ac-grid { grid-template-columns: 1fr; }
    #ac-wrap .ac-toc-grid { grid-template-columns: 1fr; }
    #ac-wrap .ac-clause { padding-left: 0; }
  }
</style>

