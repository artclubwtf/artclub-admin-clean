  "settings": [
    { "type": "checkbox", "id": "show_back", "label": "Back-Link anzeigen", "default": true },
    { "type": "url", "id": "back_url", "label": "Zurück-Link (optional)", "info": "Wenn leer, wird die aktuelle Collection oder /collections/all verwendet." },
    { "type": "text", "id": "back_label", "label": "Zurück-Text", "default": "Back" },

    { "type": "text", "id": "buy_label", "label": "Buy Button Label", "default": "Buy options" },
    { "type": "text", "id": "wishlist_label", "label": "Wishlist Button Label", "default": "Save to wishlist" },
    { "type": "text", "id": "zoom_hint", "label": "Zoom Hinweis", "default": "Zum Vergrößern klicken" }
  ],
  "presets": [
    { "name": "AC Product Artwork (NoRender Modal)", "category": "ARTCLUB" }
  ]
}
