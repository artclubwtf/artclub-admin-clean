}

#ac-nav-{{ section.id }} .ac-cart.is-open .ac-cart-panel{
  transform: translateX(0) !important;
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce){
  #ac-nav-{{ section.id }} .ac-mega,
  #ac-nav-{{ section.id }} .ac-mmenu,
  #ac-nav-{{ section.id }} .ac-mpanel,
  #ac-nav-{{ section.id }} .ac-cart,
  #ac-nav-{{ section.id }} .ac-cart-bg,
  #ac-nav-{{ section.id }} .ac-cart-panel{
    transition: none !important;
  }
}

#ac-nav-{{ section.id }} .ac-ic{
  width:17px !important;
  height:17px !important;
  display:block !important;
}

/* Make badge overlay the icon (Apple-like) */
