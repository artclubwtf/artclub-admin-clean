  transform: translateX(10px) !important;
  transition: opacity .16s ease, transform .22s cubic-bezier(.2,.8,.2,1) !important;
  pointer-events: none !important;
  position: absolute !important;
  left: 14px !important;
  right: 14px !important;
  top: 64px !important;     /* unter top bar */
  bottom: 18px !important;
  margin-top: 0 !important;
}

#ac-nav-{{ section.id }} .ac-mpanel.is-active{
  opacity: 1 !important;
  transform: translateX(0) !important;
  pointer-events: auto !important;
}

#ac-nav-{{ section.id }} .ac-mmenu{
  position: fixed !important;
  inset: 0 !important;
}

/* Container für absolute Panels */
#ac-nav-{{ section.id }} .ac-mmenu{ position: fixed !important; }
/* ===== Cart drawer (animated) ===== */
#ac-nav-{{ section.id }} .ac-cart{
  opacity: 0 !important;
  pointer-events: none !important;
  transition: opacity .18s ease !important;
}

#ac-nav-{{ section.id }} .ac-cart.is-open{
  opacity: 1 !important;
  pointer-events: auto !important;
}

#ac-nav-{{ section.id }} .ac-cart-bg{
  opacity: 0 !important;
  transition: opacity .18s ease !important;
}

#ac-nav-{{ section.id }} .ac-cart.is-open .ac-cart-bg{
  opacity: 1 !important;
}

#ac-nav-{{ section.id }} .ac-cart-panel{
  transform: translateX(18px) !important;
  transition: transform .24s cubic-bezier(.2,.8,.2,1) !important;
