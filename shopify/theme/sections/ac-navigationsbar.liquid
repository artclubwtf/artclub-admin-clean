}


</style>

<div class="ac-nav-spacer-{{ section.id }}"><br></div>
<script>
(function(){
  var nav = document.getElementById('ac-nav-{{ section.id }}');
  var spacer = document.querySelector('.ac-nav-spacer-{{ section.id }}');
  if(!nav || !spacer) return;

  var last = 0;
  function sync(){
    var h = Math.ceil(nav.getBoundingClientRect().height);
    if(!h || h === last) return;
    last = h;
    spacer.style.height = h + 'px';
    document.documentElement.style.setProperty('--ac-nav-h', h + 'px');
  }

  sync();

  if (window.ResizeObserver) {
    new ResizeObserver(sync).observe(nav);
  }
  window.addEventListener('resize', sync, { passive: true });

  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(sync).catch(function(){});
  }

  setTimeout(sync, 250);
})();
</script>

{% schema %}
{
  "name": "AC Apple Navbar",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo-Bild",
      "info": "SVG, PNG oder WebP empfohlen"
    },
