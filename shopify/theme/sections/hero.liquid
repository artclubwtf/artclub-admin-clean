{%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: calc({{ section.settings.padding_top }}px * 0.75);
      padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

  .hero-image-padding{
    position:relative;

    width: 100%;

  }

  .hero-image-image{
    height:{{ section.settings.hero-height }}rem;
    width: 100%;
  }

  .hero-image-image img{
    width: 100%;
    max-width: 100%;
    aspect-ratio: 21 / 9;
    border-radius: 0;
    object-fit: cover;
  }

  .hero-image-container{
    position:absolute;
    top:0;
    left:0;
    right: 0;
    bottom: 0;
    padding: 1.5rem 0 1.5rem 0;
    width: 100%;
    height:{{ section.settings.hero-height }}rem;
    background-color: #000000{{ section.settings.overlay }}!important;
    border-radius: 0;
    display: flex;
    align-items: end;
    justify-content: center;

  }

  .hero-heading-buttons{
    color: white;
  }

  .button-wrap{
    display: grid; 
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    grid-column-gap: 10px;
    grid-row-gap: 10px;
    text-align: center;
  }

  @media (min-width: 760px){
    .button-wrap{
      display: grid; 
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      grid-column-gap: 10px;
      grid-row-gap: 10px;
      width: 100%;
    }
  }

    @media (max-width: 760px){
      .hero-image-image img{
    width: 100%;
    max-width: 100%;
    aspect-ratio: 3/4;
    border-radius: 0;
    object-fit: cover;
  }
  }
  
{%- endstyle -%}

<section class="color-{{ section.settings.color_scheme }} gradient">
  <a href="{{ section.settings.link }}">
  <div class="section-{{ section.id }}-padding">
    <div class="hero-image-padding">
      <div class="hero-image-image">
          <picture>
            <source media="(min-width:769px)" srcset="{{ section.settings.image | img_url: '1920x' }}">
            <source media="(max-width:768px)" srcset="{{ section.settings.image-mobile | img_url: '1920x' }}">
            <img src="{{ section.settings.image | img_url: '1920x' }}" width="auto" height="auto">
          </picture>
      </div>
        
    </div>
  </div>
    </a>
    
</section>

{% schema %}
{
  "name": "hero",
  "class": "section",
  "settings": [
  {
    "type": "color_scheme",
    "id": "color_scheme",
    "label": "t:sections.all.colors.label",
    "default": "scheme-1"
  },
  {
    "type": "color_scheme",
    "id": "color_scheme_banner",
    "label": "color scheme banner",
    "default": "scheme-1"
  },
  {
    "type": "header",
    "content": "t:sections.all.padding.section_padding_heading"
  },
  {
    "type": "image_picker",
    "id": "image",
    "label": "Bild"
  },
  {
    "type": "image_picker",
    "id": "image-mobile",
    "label": "Mobiles Bild"
  },
  {
    "type": "range",
    "id": "padding_top",
    "min": 0,
    "max": 100,
    "step": 4,
    "unit": "px",
    "label": "t:sections.all.padding.padding_top",
    "default": 40
  },
  {
    "type": "range",
    "id": "padding_bottom",
    "min": 0,
    "max": 100,
    "step": 4,
    "unit": "px",
    "label": "t:sections.all.padding.padding_bottom",
    "default": 52
  },
  {
    "type": "url",
    "id": "link",
    "label": "url button link"
  }
  ],
  "presets": [
    {
      "name": "Hero-image"
    }
  ]
}
{% endschema %}
