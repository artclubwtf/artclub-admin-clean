.about-page .about-gallery-cta {
  padding: 80px 40px !important;
  text-align: center !important;
  color: #ffffff !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  gap: 28px !important;
}
.about-page .about-gallery-cta h2 {
  font-size: 44px !important;
  font-weight: 400 !important;
  letter-spacing: -0.02em !important;
  line-height: 1.1 !important;
  max-width: 600px !important;
  color: #ffffff !important;
}

/* ── RESPONSIVE — Tablet ── */
@media (max-width: 900px) {
  .about-page .about-hero__grid {
    grid-template-columns: repeat(2, 1fr) !important;
    grid-template-rows: auto !important;
    height: auto !important;
  }
  .about-page .about-hero__grid-item--1,
  .about-page .about-hero__grid-item--2,
  .about-page .about-hero__grid-item--3,
  .about-page .about-hero__grid-item--4,
  .about-page .about-hero__grid-item--5 {
    grid-column: auto !important;
    grid-row: auto !important;
  }
  .about-page .about-hero__grid-item img {
    min-height: 200px !important;
  }
  .about-page .about-hero__headline {
    font-size: 36px !important;
  }
  .about-page .about-stats {
    gap: 40px !important;
    flex-wrap: wrap !important;
  }
  .about-page .about-stats__number {
    font-size: 40px !important;
  }
  .about-page .about-mission {
    grid-template-columns: 1fr !important;
  }
  .about-page .about-mission--reverse {
    direction: ltr !important;
  }
  .about-page .about-mission__headline {
    font-size: 24px !important;
  }
  .about-page .about-cta-headline h2 {
    font-size: 40px !important;
  }
  .about-page .about-story {
    grid-template-columns: 1fr !important;
  }
  .about-page .about-features {
    grid-template-columns: 1fr !important;
  }
  .about-page .about-app {
    grid-template-columns: 1fr !important;
  }
  .about-page .about-app__headline {
    font-size: 32px !important;
  }
  .about-page .about-gallery-cta h2 {
    font-size: 34px !important;
  }
}

/* ── RESPONSIVE — Mobile ── */
@media (max-width: 600px) {
  .about-page .about-hero {
    padding: 40px 20px 0 !important;
  }
  .about-page .about-hero__headline {
    font-size: 28px !important;
  }
  .about-page .about-stats {
    padding: 40px 20px !important;
    gap: 32px !important;
    justify-content: flex-start !important;
  }
  .about-page .about-stats__number {
    font-size: 36px !important;
  }
  .about-page .about-mission__content {
    padding: 40px 20px !important;
  }
  .about-page .about-mission__headline {
    font-size: 22px !important;
  }
  .about-page .about-cta-headline {
    padding: 60px 20px !important;
  }
  .about-page .about-cta-headline h2 {
    font-size: 32px !important;
  }
  .about-page .about-story {
    padding: 0 20px 60px !important;
  }
  .about-page .about-story__headline {
    font-size: 22px !important;
  }
  .about-page .about-features {
    padding: 60px 20px !important;
  }
  .about-page .about-team {
    padding: 60px 20px !important;
  }
  .about-page .about-team__grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }
  .about-page .about-team__headline {
    font-size: 24px !important;
  }
  .about-page .about-app__content {
    padding: 40px 20px !important;
  }
  .about-page .about-app__headline {
    font-size: 28px !important;
  }
  .about-page .about-press {
    padding: 60px 20px !important;
  }
  .about-page .about-press__grid {
    grid-template-columns: 1fr !important;
  }
  .about-page .about-press__headline {
    font-size: 24px !important;
  }
  .about-page .about-gallery-cta {
    padding: 60px 20px !important;
  }
  .about-page .about-gallery-cta h2 {
    font-size: 28px !important;
  }
}

