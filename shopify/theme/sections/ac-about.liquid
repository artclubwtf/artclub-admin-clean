<section class="about-page" data-section-id="{{ section.id }}">

  {%- comment -%} ── 1. HERO ── {%- endcomment -%}
  <div class="about-hero">
    <p class="about-hero__label">{{ section.settings.hero_label }}</p>
    <h1 class="about-hero__headline">{{ section.settings.hero_headline }}</h1>
    <div class="about-hero__grid">
      {%- for i in (1..5) -%}
        {%- assign img_key = 'hero_image_' | append: i -%}
        {%- if section.settings[img_key] != blank -%}
          <div class="about-hero__grid-item about-hero__grid-item--{{ i }}">
            <img src="{{ section.settings[img_key] | img_url: '800x' }}" alt="Hero artwork {{ i }}" loading="lazy">
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ── 2. STATS ── {%- endcomment -%}
  {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
  {%- if stat_blocks.size > 0 -%}
  <div class="about-stats">
    {%- for block in stat_blocks -%}
      <div class="about-stats__item" {{ block.shopify_attributes }}>
        <span class="about-stats__number">{{ block.settings.number }}</span>
        <span class="about-stats__label">{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
  {%- endif -%}

  {%- comment -%} ── 3. MISSION BLOCKS ── {%- endcomment -%}
  {%- assign mission_blocks = section.blocks | where: 'type', 'mission' -%}
  {%- if mission_blocks.size > 0 -%}
  <div class="about-missions">
    {%- for block in mission_blocks -%}
      <div class="about-mission {% if forloop.even %}about-mission--reverse{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="about-mission__image">
            <img src="{{ block.settings.image | img_url: '700x' }}" alt="{{ block.settings.headline }}" loading="lazy">
          </div>
        {%- endif -%}
        <div class="about-mission__content">
          {%- if block.settings.eyebrow != blank -%}
            <p class="about-mission__eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="about-mission__headline">{{ block.settings.headline }}</h2>
          <p class="about-mission__text">{{ block.settings.text }}</p>
          {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
            <a href="{{ block.settings.link_url }}" class="about-link">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- endif -%}

  {%- comment -%} ── 4. BIG CTA HEADLINE ── {%- endcomment -%}
  {%- if section.settings.cta_headline != blank -%}
  <div class="about-cta-headline">
    <h2>{{ section.settings.cta_headline }}</h2>
  </div>
  {%- endif -%}

  {%- comment -%} ── 5. OUR STORY ── {%- endcomment -%}
  <div class="about-story">
    {%- if section.settings.story_image != blank -%}
      <div class="about-story__image">
        <img src="{{ section.settings.story_image | img_url: '900x' }}" alt="{{ section.settings.story_headline }}" loading="lazy">
      </div>
    {%- endif -%}
    <div class="about-story__content">
      <h2 class="about-story__headline">{{ section.settings.story_headline }}</h2>
      <div class="about-story__text">{{ section.settings.story_text }}</div>
      {%- if section.settings.story_link_label != blank and section.settings.story_link_url != blank -%}
        <a href="{{ section.settings.story_link_url }}" class="about-link">{{ section.settings.story_link_label }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── 6. WHAT WE DO ── {%- endcomment -%}
  {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
  <div class="about-features">
    <div class="about-features__intro">
      <h2 class="about-features__headline">{{ section.settings.features_headline }}</h2>
      <p class="about-features__text">{{ section.settings.features_text }}</p>
    </div>
    {%- if feature_blocks.size > 0 -%}
    <div class="about-features__list">
      {%- for block in feature_blocks -%}
        <div class="about-features__item" {{ block.shopify_attributes }}>
          <h3 class="about-features__item-title">{{ block.settings.title }}</h3>
          <p class="about-features__item-text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>

  {%- comment -%} ── 7. OUR TEAM ── {%- endcomment -%}
  {%- assign team_blocks = section.blocks | where: 'type', 'team_member' -%}
  <div class="about-team">
    <div class="about-team__header">
      <h2 class="about-team__headline">{{ section.settings.team_headline }}</h2>
      <p class="about-team__text">{{ section.settings.team_text }}</p>
    </div>
    {%- if team_blocks.size > 0 -%}
    <div class="about-team__grid">
      {%- for block in team_blocks -%}
        <div class="about-team__member" {{ block.shopify_attributes }}>
          {%- if block.settings.photo != blank -%}
            <div class="about-team__photo" style="--bg: {{ block.settings.bg_color }};">
              <img src="{{ block.settings.photo | img_url: '400x400', crop: 'center' }}" alt="{{ block.settings.name }}" loading="lazy">
            </div>
          {%- endif -%}
          <p class="about-team__name">{{ block.settings.name }}</p>
          <p class="about-team__role">{{ block.settings.role }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}
    {%- if section.settings.team_careers_label != blank and section.settings.team_careers_url != blank -%}
    <div class="about-team__footer">
      <p>{{ section.settings.team_careers_text }}</p>
      <a href="{{ section.settings.team_careers_url }}" class="about-link about-link--light">{{ section.settings.team_careers_label }}</a>
    </div>
    {%- endif -%}
  </div>

  {%- comment -%} ── 8. APP CTA ── {%- endcomment -%}
  {%- if section.settings.app_headline != blank -%}
  <div class="about-app">
    <div class="about-app__phone">
      {%- if section.settings.app_phone_image != blank -%}
        <img src="{{ section.settings.app_phone_image | img_url: '400x' }}" alt="App screenshot" loading="lazy">
      {%- endif -%}
    </div>
    <div class="about-app__content">
      <h2 class="about-app__headline">{{ section.settings.app_headline }}</h2>
      {%- if section.settings.app_qr_image != blank -%}
        <img class="about-app__qr" src="{{ section.settings.app_qr_image | img_url: '200x' }}" alt="QR code" loading="lazy">
      {%- endif -%}
      {%- if section.settings.app_store_url != blank -%}
        <a href="{{ section.settings.app_store_url }}" class="about-btn about-btn--dark">{{ section.settings.app_btn_label | default: 'Download' }}</a>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ── 9. PRESS / IN THE MEDIA ── {%- endcomment -%}
  {%- assign press_blocks = section.blocks | where: 'type', 'press' -%}
  {%- if press_blocks.size > 0 -%}
  <div class="about-press">
    <h2 class="about-press__headline">{{ section.settings.press_headline }}</h2>
    <div class="about-press__grid">
      {%- for block in press_blocks -%}
        <div class="about-press__item" {{ block.shopify_attributes }}>
          {%- if block.settings.publication != blank -%}
            <p class="about-press__publication">{{ block.settings.publication }}</p>
          {%- endif -%}
          {%- if block.settings.date != blank -%}
            <p class="about-press__date">{{ block.settings.date }}</p>
          {%- endif -%}
          <p class="about-press__title">
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}">{{ block.settings.title }}</a>
            {%- else -%}
              {{ block.settings.title }}
            {%- endif -%}
          </p>
          <p class="about-press__excerpt">{{ block.settings.excerpt }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.press_contact_text != blank -%}
    <div class="about-press__contact">
      <span>{{ section.settings.press_contact_text }}</span>
      {%- if section.settings.press_contact_email != blank -%}
        <a href="mailto:{{ section.settings.press_contact_email }}">{{ section.settings.press_contact_email }}</a>
      {%- endif -%}
      {%- if section.settings.press_btn_label != blank and section.settings.press_btn_url != blank -%}
        <a href="{{ section.settings.press_btn_url }}" class="about-btn about-btn--dark">{{ section.settings.press_btn_label }}</a>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
  {%- endif -%}

  {%- comment -%} ── 10. GALLERY CTA BANNER ── {%- endcomment -%}
  {%- if section.settings.gallery_cta_headline != blank -%}
  <div class="about-gallery-cta" style="background-image: {{ section.settings.gallery_cta_gradient }};">
    <h2>{{ section.settings.gallery_cta_headline }}</h2>
    {%- if section.settings.gallery_cta_btn_label != blank and section.settings.gallery_cta_btn_url != blank -%}
      <a href="{{ section.settings.gallery_cta_btn_url }}" class="about-btn about-btn--outline">{{ section.settings.gallery_cta_btn_label }}</a>
    {%- endif -%}
  </div>
  {%- endif -%}

</section>

<style>
