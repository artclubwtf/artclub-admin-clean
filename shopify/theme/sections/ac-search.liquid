    { "type": "range", "id": "mosaic_gap", "label": "Mosaic gap (px)", "min": 6, "max": 24, "step": 2, "default": 12 }
  ],
  "presets": [{ "name": "AC Search (Instagram)", "category": "ARTCLUB" }]
}
