                <textarea id="artist_dna_expression_influences" rows="4" class="ac-input">{{ customer.metafields.custom.artist_dna_expression_influences }}</textarea>

                <label>Techniken / Materialien – warum?</label>
                <textarea id="artist_dna_expression_techniques" rows="4" class="ac-input">{{ customer.metafields.custom.artist_dna_expression_techniques }}</textarea>

                <label>Ziel meiner Werke (Denkanstoß, Emotionen, Ästhetik)</label>
