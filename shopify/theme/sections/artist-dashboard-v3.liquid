{% comment %} ARTCLUB — Artist Dashboard (Social Links: Add/Delete) {% endcomment %}

<style>
  :root {
    --ink: #0b0c0f;
    --bg: #f5f6f8;
    --muted: #6b7280;
    --line: rgba(0, 0, 0, 0.08);
    --card: rgba(255, 255, 255, 0.6);
    --glass: blur(18px) saturate(120%);
    --brand: #0a84ff;
    --brand2: #34c759;
    --warn: #ffd60a;
    --err: #ff453a;
    --r-lg: 22px;
    --r-sm: 12px;
    --shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d0e10;
      --ink: #e5e7eb;
      --muted: #9aa0a6;
      --line: rgba(255, 255, 255, 0.08);
      --card: rgba(22, 22, 24, 0.7);
    }
  }

  .ac-wrap {
    font-family: -apple-system, BlinkMacSystemFont, Inter, system-ui, sans-serif;
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 24px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem;
  }

  .ac-topbar { display: none; }
  @media (max-width: 980px) {
    .ac-topbar {
      position: sticky; top: 0; z-index: 8;
      display: flex; align-items: center; justify-content: space-between;
      background: var(--bg);
      padding: 12px 16px;
      border-bottom: 1px solid var(--line);
    }
    .ac-top-title { font-weight: 800; }
    .ac-top-sub { font-size: 12px; color: var(--muted); }
  }

  .ac-sidebar {
    position: sticky; top: 28px; align-self: start;
    display: flex; flex-direction: column; gap: 16px;
    border: 1px solid var(--line); border-radius: var(--r-lg);
    background: var(--card); backdrop-filter: var(--glass); box-shadow: var(--shadow);
    padding: 16px;
  }
  .ac-profile {
    display: flex; gap: 12px; align-items: center;
    border: 1px solid var(--line); border-radius: 16px;
    padding: 12px; background: rgba(255, 255, 255, 0.35);
  }
  @media (prefers-color-scheme: dark) { .ac-profile { background: rgba(0, 0, 0, 0.25); } }
  .ac-avatar {
    width: 40px; height: 40px; border-radius: 10px;
    display: grid; place-items: center; font-weight: 800;
    background: linear-gradient(135deg, var(--brand), var(--brand2)); color: #fff;
  }
  .ac-name { font-weight: 700; }
  .ac-mail { color: var(--muted); font-size: 12px; }

  .ac-nav { display: flex; flex-direction: column; gap: 8px; }
  .ac-nav-item {
    appearance: none; border: 1px solid var(--line); background: transparent;
    padding: 10px 12px; border-radius: 12px; text-align: left;
    font-weight: 600; cursor: pointer; color: var(--ink);
  }
  .ac-nav-item:hover { border-color: var(--brand); }
  .ac-nav-item.is-active {
    background: linear-gradient(135deg, var(--brand), var(--brand2));
    color: #fff; border-color: transparent;
  }

  .ac-sidecard {
    border: 1px solid var(--line); border-radius: 16px; padding: 12px;
    background: rgba(255, 255, 255, 0.35);
  }
  @media (prefers-color-scheme: dark) { .ac-sidecard { background: rgba(0, 0, 0, 0.25); } }
  .ac-sidecard-title { font-weight: 700; margin-bottom: 6px; }
  .ac-kv {
    display: flex; justify-content: space-between; gap: 8px;
    padding: 8px 0; border-bottom: 1px dashed var(--line);
  }
  .ac-kv:last-child { border-bottom: 0; }

  .ac-main { display: flex; flex-direction: column; gap: 18px; }
  .ac-card {
    border: 1px solid var(--line); border-radius: var(--r-lg);
    background: var(--card); backdrop-filter: var(--glass); box-shadow: var(--shadow);
    opacity: 0.95; transform: translateY(6px);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .ac-card.is-active { opacity: 1; transform: none; }
  .ac-card-head {
    padding: 16px 18px; border-bottom: 1px solid var(--line);
    display: flex; justify-content: space-between; gap: 12px; align-items: center;
  }
  .ac-card-head h2 { margin: 0; font-size: 18px; }
  .ac-card-body { padding: 18px; }

  .ac-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .ac-grid.three { grid-template-columns: repeat(3, 1fr); }
  .ac-span-12 { grid-column: 1 / -1; }

  label { font-weight: 700; color: var(--muted); margin-bottom: 6px; display: block; }

  .ac-box {
    border: 1px solid var(--line); border-radius: 14px; background: rgba(255, 255, 255, 0.4); padding: 12px;
  }
  @media (prefers-color-scheme: dark) { .ac-box { background: rgba(0, 0, 0, 0.25); } }

  .ac-line { padding: 8px 0; border-bottom: 1px dashed var(--line); }

  .ac-links { list-style: none; margin: 0; padding: 0; }
  .ac-links li { margin: 6px 0; }
  .ac-links a { color: #0a84ff; text-decoration: none; }
  .ac-links a:hover { text-decoration: underline; }

  .ac-note {
    border: 1px dashed var(--line); border-radius: 12px; padding: 12px;
    color: var(--muted); margin-bottom: 12px;
  }

  .ac-btn {
    appearance: none; border: 1px solid var(--line); background: #fff;
    padding: 10px 14px; border-radius: 12px; cursor: pointer; font-weight: 700;
  }
  .ac-btn-primary {
    background: linear-gradient(135deg, var(--brand), var(--brand2));
    color: #fff; border-color: transparent;
  }
  .ac-edit-toggle {
    appearance: none; border: 1px solid var(--line); background: #fff;
    padding: 8px 12px; border-radius: 10px; cursor: pointer; font-weight: 600;
  }
  .ac-edit { margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--line); }

  .ac-input {
    width: 100%; border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; background: #fff;
  }
  .ac-hint { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; }

  .ac-savebar {
    position: sticky; bottom: 12px; display: flex; gap: 12px; align-items: center; justify-content: space-between;
    background: var(--card); backdrop-filter: var(--glass);
    border: 1px solid var(--line); border-radius: 14px; padding: 10px 12px;
  }
  .ac-feedback { border-radius: 10px; padding: 8px 10px; font-weight: 700; }
  .ac-feedback.success { background: #d9fdd3; }
  .ac-feedback.error { background: #ffd7d4; }

  /* Social links editor */
  .ac-links-editor { border: 1px dashed var(--line); border-radius: 12px; padding: 12px; }
  .ac-link-item {
    display: flex; gap: 8px; align-items: center; justify-content: space-between;
    padding: 8px 10px; border: 1px solid var(--line); border-radius: 10px; background: #fff; margin-bottom: 8px;
  }
  .ac-link-url { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ac-links-add { display: flex; gap: 8px; margin-top: 8px; }
  .ac-remove { border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 6px 8px; cursor: pointer; }

  /* Status + mobile tabbar */
  .ac-badge { display: inline-block; padding: 8px 12px; border-radius: 999px; font-weight: 800; }
  .ac-badge.ok { background: #d9fdd3; color: #093; }
  .ac-badge.warn { background: #fff5c2; color: #775d00; }
  .ac-badge.err { background: #ffd7d4; color: #7a0000; }
  .ac-badge.muted { background: #e5e7eb; color: #374151; }

  .ac-tabbar { display: none; }
  .ac-tab {
    appearance: none; background: #fff; border: 1px solid var(--line); border-radius: 12px;
    flex: 1 1 0; padding: 8px 6px; display: flex; flex-direction: column; align-items: center; gap: 4px;
    font-size: 11px; color: #222;
  }
  .ac-tab.is-active {
    background: linear-gradient(135deg, var(--brand), var(--brand2)); color: #fff; border-color: transparent;
  }

  @media (max-width: 980px) {
    .ac-wrap { grid-template-columns: 1fr; gap: 12px; padding: 0 0 72px; }
    .ac-sidebar { display: none; }
    .ac-grid, .ac-grid.three { grid-template-columns: 1fr; gap: 12px; }
    .ac-card { border-radius: 18px; transform: none; opacity: 1; }
    .ac-card-head { padding: 12px 14px; }
    .ac-card-body { padding: 14px; }
    .ac-tabbar {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 9;
      display: flex; gap: 8px; padding: 10px 12px; background: var(--bg); border-top: 1px solid var(--line);
    }
    .section-artist-dashboard ~ .shopify-section { display: none !important; }
  }
  @media (max-width: 380px) { .ac-tab span { display: none; } }

  /* DNA Pills / Progress / Wizard */
  .ac-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px; border-radius: 999px; font-weight: 800; font-size: 12px;
    border: 1px solid var(--line); background: #fff; color: var(--ink);
  }
  .ac-pill-ok { background: #d9fdd3; border-color: transparent; color: #0a5f2c; }
  .ac-pill-warn { background: #fff5c2; border-color: transparent; color: #6a5300; }
  .ac-pill-err { background: #ffd7d4; border-color: transparent; color: #7a0000; }
  .ac-pill-muted { background: #e5e7eb; color: #374151; border-color: transparent; }
  .ac-nav-item .ac-pill { margin-left: auto; }

  .ac-progress { width: 160px; height: 8px; border-radius: 999px; background: rgba(0,0,0,.08); overflow: hidden; }
  @media (max-width: 980px) { .ac-progress { width: 120px; } }
  .ac-progress-bar { height: 100%; background: linear-gradient(135deg, var(--brand), var(--brand2)); }

  .ac-stepper { display: flex; align-items: center; gap: 10px; }
  .ac-step { display: flex; align-items: center; gap: 6px; font-weight: 700; color: var(--muted); }
  .ac-step.is-active { color: var(--ink); }
  .ac-dot {
    width: 22px; height: 22px; border-radius: 999px; display: grid; place-items: center;
    background: #e5e7eb; color: #111; font-size: 12px; font-weight: 800;
  }
  .ac-step.is-active .ac-dot { background: linear-gradient(135deg, var(--brand), var(--brand2)); color: #fff; }
  .ac-step-line { height: 2px; flex: 1; background: rgba(0,0,0,.08); }

  .ac-wizard { display: flex; flex-direction: column; gap: 16px; }
  .ac-pane { display: none; }
  .ac-pane.is-active { display: block; }
  .ac-wiz-actions { display: flex; gap: 8px; justify-content: space-between; margin-top: 8px; }
  .ac-btn.secondary { background: #fff; }
  .ac-pane h3 { margin: .25rem 0 .5rem; font-size: 16px; }
  .ac-pane .ac-hint { margin-top: 4px; }
</style>

{% if customer %}
  {% assign role = customer.metafields.custom.role | downcase | default: '' %}
  {% if role == 'artist' %}
    <section id="artistDashboard" class="section-artist-dashboard ac-wrap" data-customer-id="{{ customer.id }}">
      <header class="ac-topbar">
        <div>
          <div class="ac-top-title">{{ section.settings.title | default: 'Künstler Dashboard' }}</div>
          <div class="ac-top-sub">{{ section.settings.subtitle | default: 'Verwalten & Analysieren' }}</div>
        </div>
        <div class="ac-top-actions">
          {% assign status_raw = customer.metafields.custom.kunstler_status | default: 'Unbekannt' %}
          {% assign status = status_raw | downcase %}
          <span class="ac-badge {% if status == 'aktiv' %}ok{% elsif status == 'pending' or status == 'wartend' %}warn{% elsif status == 'inaktiv' %}err{% else %}muted{% endif %}">
            {{- status_raw | capitalize -}}
          </span>
        </div>
      </header>

      <!-- Sidebar -->
      <aside class="ac-sidebar">
        <div class="ac-profile">
          <div class="ac-avatar" aria-hidden="true">{{ customer.first_name | slice: 0, 1 | upcase }}</div>
          <div class="ac-profile-meta">
            <div class="ac-name">{{ customer.first_name }} {{ customer.last_name }}</div>
            <div class="ac-mail">{{ customer.email }}</div>
          </div>
        </div>

        <nav class="ac-nav" role="navigation" aria-label="Sektionen">
          <button class="ac-nav-item is-active" data-target="sec-overview">Übersicht</button>
          <button class="ac-nav-item" data-target="sec-stammdaten">Stammdaten</button>
          <button class="ac-nav-item" data-target="sec-kunst">Künstlerische Infos</button>
          <button class="ac-nav-item" data-target="sec-dna">
            Artist DNA
            <span id="dnaSideBadge" class="ac-pill ac-pill-muted" aria-label="Vervollständigung">0%</span>
          </button>
          <button class="ac-nav-item" data-target="sec-marketing">Marketing</button>
          <button class="ac-nav-item" data-target="sec-vertrag">Vertrag & Auszahlung</button>
          <button class="ac-nav-item" data-target="sec-docs">Dokumente</button>
          <button class="ac-nav-item" data-target="sec-contact">Kontakt</button>
          <button class="ac-nav-item" data-target="sec-status">Status</button>
        </nav>


        <div class="ac-sidecard">
          <div class="ac-sidecard-title">Konditionen</div>
          <div class="ac-kv">
            <span>Originale</span>
            <strong>
              {% assign k_orig = customer.metafields.custom.kunstleranteil_originalwerke %}
              {{- k_orig | default: '—' -}}{% if k_orig %}%{% endif %}
            </strong>
          </div>
          <div class="ac-kv">
            <span>Drucke</span>
            <strong>
              {% assign k_dr = customer.metafields.custom.kunstleranteil_drucke %}
              {{- k_dr | default: '—' -}}{% if k_dr %}%{% endif %}
            </strong>
          </div>
        </div>
      </aside>

      <!-- Main -->
      <main class="ac-main" id="acPanels">#

        {%- comment -%} ====== OVERVIEW (Startseite) ====== {%- endcomment -%}
        {%- assign dna_pct = customer.metafields.custom.artist_dna_completion | default: '0' -%}
        {%- assign dna_pct_num = dna_pct | plus: 0 -%}

        {%- assign links_raw = customer.metafields.custom.social_media_links -%}
        {%- assign links_count = 0 -%}
        {%- if links_raw and links_raw.value -%}
          {%- if links_raw.type == 'list.link' -%}
            {%- assign links_count = links_raw.value.size -%}
          {%- else -%}
            {%- assign parsed = links_raw.value | parse_json -%}
            {%- if parsed -%}
              {%- assign links_count = parsed.size -%}
            {%- else -%}
              {%- assign links_count = links_raw.value | split: '\n' | size -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}

        {%- assign mfiles = customer.metafields.custom.kunstler_bilder_fur_marketing_co -%}
        {%- assign assets_count = 0 -%}
        {%- if mfiles and mfiles.value -%}
          {%- if mfiles.type == 'list.file_reference' -%}
            {%- assign assets_count = mfiles.value.size -%}
          {%- else -%}
            {%- assign parsed = mfiles.value | parse_json -%}
            {%- if parsed -%}{%- assign assets_count = parsed.size -%}{%- endif -%}
          {%- endif -%}
        {%- endif -%}

        {%- assign has_bank_name = customer.metafields.custom.bankdaten_name -%}
        {%- assign has_bank_iban = customer.metafields.custom.bankdaten_iban -%}
        {%- assign has_bank_stnr = customer.metafields.custom.bankdaten_steuernummer -%}
        {%- assign bank_ok = false -%}
        {%- if has_bank_name and has_bank_name != blank and has_bank_iban and has_bank_iban != blank and has_bank_stnr and has_bank_stnr != blank -%}
          {%- assign bank_ok = true -%}
        {%- endif -%}

        <section id="sec-overview" class="ac-card is-active" data-tab="overview">
          <header class="ac-card-head">
            <h2>Artist Dashboard 1.0 (BETA)</h2>
            <div class="ac-stepper" aria-label="Fortschritt">
              <div class="ac-step is-active"><div class="ac-dot">●</div><div>Start</div></div>
              <div class="ac-step-line"></div>
              <div class="ac-step"><div class="ac-dot">●</div><div>Pflege</div></div>
              <div class="ac-step-line"></div>
              <div class="ac-step"><div class="ac-dot">●</div><div>Launch</div></div>
            </div>
          </header>

          <div class="ac-card-body">
            <!-- Hero -->
            <div class="ac-box" style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
              <div>
                <div style="font-weight:800;font-size:50px!important">Willkommen, {{ customer.first_name }}!</div>
                <div class="ac-hint">Hier siehst du Status, KPIs und nächste Schritte auf einen Blick.</div>
              </div>
              <div>
                <span class="ac-badge {% if status == 'aktiv' %}ok{% elsif status == 'pending' or status == 'wartend' %}warn{% elsif status == 'inaktiv' %}err{% else %}muted{% endif %}">
                  {{ status_raw | capitalize }}
                </span>
              </div>
            </div>

            <!-- KPIs -->
            <div class="ac-grid three" style="margin-top:12px">
              <div class="ac-box">
                <label>Artist DNA</label>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
                  <div class="ac-progress" style="flex:1"><div class="ac-progress-bar" style="width: {{ dna_pct_num }}%"></div></div>
                  <span class="ac-pill {% if dna_pct_num >= 80 %}ac-pill-ok{% elsif dna_pct_num >= 40 %}ac-pill-warn{% elsif dna_pct_num > 0 %}ac-pill-err{% else %}ac-pill-muted{% endif %}">
                    {{ dna_pct_num }}%
                  </span>
                </div>
                <div class="ac-hint">Vervollständige dein Profil für bessere Sichtbarkeit.</div>
              </div>

              <div class="ac-box">
                <label>Social Links</label>
                <div style="display:flex;align-items:center;justify-content:space-between">
                  <strong style="font-size:20px">{{ links_count }}</strong>
                  <button class="ac-btn" data-jump="sec-stammdaten">Verwalten</button>
                </div>
                <div class="ac-hint">Instagram, TikTok, Website …</div>
              </div>

              <div class="ac-box">
                <label>Marketing-Uploads</label>
                <div style="display:flex;align-items:center;justify-content:space-between">
                  <strong style="font-size:20px">{{ assets_count }}</strong>
                  <button class="ac-btn" data-jump="sec-docs">Hochladen</button>
                </div>
                <div class="ac-hint">Pressefotos, Reels, Clips.</div>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="ac-box" style="margin-top:12px">
              <label>Schnellzugriff</label>
              <div style="display:flex;flex-wrap:wrap;gap:8px">
                <button class="ac-btn ac-btn-primary" data-jump="sec-dna">Artist DNA fortsetzen</button>
                <button class="ac-btn" data-jump="sec-stammdaten">Biografie bearbeiten</button>
                <button class="ac-btn" data-jump="sec-kunst">Künstlerische Infos</button>
                <button class="ac-btn" data-jump="sec-vertrag">Bankdaten prüfen</button>
                <button class="ac-btn" data-jump="sec-docs">Marketing-Uploads</button>
                <button class="ac-btn" data-jump="sec-contact">Team kontaktieren</button>
              </div>
            </div>

            <!-- Checkliste / Nächste Schritte -->
            <div class="ac-grid">
              <div class="ac-box">
                <label>To-do Checkliste</label>
                <ul class="ac-links" style="margin-top:6px">
                  <li>
                    {% if dna_pct_num >= 50 %}
                      <span class="ac-pill ac-pill-ok">✓</span> Mindmap freigeschaltet ({{ dna_pct_num }}%)
                    {% else %}
                      <span class="ac-pill ac-pill-warn">!</span> Artist DNA auf mind. 50% bringen
                      <button class="ac-btn" data-jump="sec-dna" style="margin-left:8px">Jetzt ausfüllen</button>
                    {% endif %}
                  </li>
                  <li>
                    {% if links_count > 0 %}
                      <span class="ac-pill ac-pill-ok">✓</span> Social Links hinterlegt ({{ links_count }})
                    {% else %}
                      <span class="ac-pill ac-pill-err">•</span> Social Links hinzufügen
                      <button class="ac-btn" data-jump="sec-stammdaten" style="margin-left:8px">Hinzufügen</button>
                    {% endif %}
                  </li>
                  <li>
                    {% if assets_count > 0 %}
                      <span class="ac-pill ac-pill-ok">✓</span> Marketing-Assets hochgeladen ({{ assets_count }})
                    {% else %}
                      <span class="ac-pill ac-pill-err">•</span> Marketing-Assets hochladen
                      <button class="ac-btn" data-jump="sec-docs" style="margin-left:8px">Upload</button>
                    {% endif %}
                  </li>
                  <li>
                    {% if bank_ok %}
                      <span class="ac-pill ac-pill-ok">✓</span> Bankdaten vollständig
                    {% else %}
                      <span class="ac-pill ac-pill-err">•</span> Bankdaten vervollständigen
                      <button class="ac-btn" data-jump="sec-vertrag" style="margin-left:8px">Prüfen</button>
                    {% endif %}
                  </li>
                </ul>
              </div>

              <div class="ac-box">
                <label>Hinweise</label>
                <div class="ac-note" style="margin-top:6px">
                  • Je vollständiger dein Profil, desto höher deine Sichtbarkeit in ARTCLUB-Kurationslisten und Marketing. <br>
                  • Uploads: Bilder bis 20 MB, Videos bis 1 GB. <br>
                  • Verträge werden hier nicht angezeigt – nutze „Kontakt“, wenn du Unterlagen brauchst.
                </div>
              </div>
            </div>


                    <!-- Version / Logs -->
<div class="ac-box" style="margin-top:18px">
  <label>Version & Hinweise</label>
  <div class="ac-note" style="margin-top:6px">
    <strong>ARTCLUB Artist Dashboard — Beta v1.0</strong><br>
    Dieses Dashboard befindet sich aktuell noch in der <em>Beta-Phase</em>. 
    Manche Funktionen können eingeschränkt oder fehlerhaft sein.<br><br>
    Wir arbeiten kontinuierlich an Verbesserungen. 
    Die nächsten Versionen mit zusätzlichen Features und Bugfixes erscheinen so schnell wie möglich.
  </div>
</div>
          </div>
        </section>


        <!-- STAMMDATEN -->
        <section id="sec-stammdaten" class="ac-card is-active" data-tab="stammdaten">
          <header class="ac-card-head">
            <h2>Stammdaten</h2>
            <!-- toggelt Bio UND Links-Editor -->
            <button type="button" class="ac-edit-toggle" data-target="stammdaten-edit,linksEditor">Bearbeiten</button>
          </header>

          <div class="ac-card-body">
            <div class="ac-grid">
              <!-- BIO -->
              <div class="ac-cell">
                <label>Biografie</label>
                <div class="ac-box" data-display-for="biography">
                  {% assign bio = customer.metafields.custom.biography %}
                  {% if bio and bio.value %}
                    {% if bio.type contains 'rich_text' %}
                      {{ bio | metafield_tag }}
                    {% else %}
                      {{ bio.value | newline_to_br }}
                    {% endif %}
                  {% else %}
                    <em>Noch keine Biografie hinterlegt</em>
                  {% endif %}
