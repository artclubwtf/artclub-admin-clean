        <!-- STATUS -->
        <section id="sec-status" class="ac-card" data-tab="status">
          <header class="ac-card-head"><h2>Status</h2></header>
          <div class="ac-card-body ac-center">
            <div class="ac-badge {% if status == 'aktiv' %}ok{% elsif status == 'pending' or status == 'wartend' %}warn{% elsif status == 'inaktiv' %}err{% else %}muted{% endif %}">
              {{ status_raw | capitalize }}
