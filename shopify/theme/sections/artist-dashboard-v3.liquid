        <script>
          (() => {
            const shop = '{{ shop.permanent_domain }}';
            const customerId = '{{ customer.id }}';
            const SAVE_URL = 'https://v0-shopify-vercel-project.vercel.app/api/update-artist-profile';

            // DOM
            const wiz = document.getElementById('dnaWizard');
            const panes = [...document.querySelectorAll('#dnaWizard .ac-pane')];
            const prevBtn = document.getElementById('dnaPrevBtn');
            const nextBtn = document.getElementById('dnaNextBtn');
            const saveBtn = document.getElementById('saveDnaBtn');
            const saveDraftBtn = document.getElementById('dnaSaveDraftBtn');
            const stepper = document.getElementById('dnaStepper');
            const msg = document.getElementById('dnaMsg');
            const badgeTop = document.getElementById('dnaProgressBadge');
            const badgeSide = document.getElementById('dnaSideBadge');
            const bar = document.getElementById('dnaProgressBar');
            const moodEl = document.getElementById('dna_moodboard');

            // IDs der Textfelder
            const DNA_FIELDS = [
              'artist_dna_identity_who','artist_dna_identity_features','artist_dna_identity_motivation','artist_dna_identity_message',
              'artist_dna_story_my_story','artist_dna_story_personal_experience','artist_dna_story_overarching_message',
              'artist_dna_social_presentation','artist_dna_social_platforms','artist_dna_social_content_types','artist_dna_social_community_interaction',
              'artist_dna_visual_elements','artist_dna_visual_presentation','artist_dna_visual_techniques',
              'artist_dna_audience_who','artist_dna_audience_viewers','artist_dna_audience_motivation','artist_dna_audience_values',
              'artist_dna_expression_perception','artist_dna_expression_influences','artist_dna_expression_techniques','artist_dna_expression_goal'
            ];
            const $ = id => document.getElementById(id);

            /* Stepper */
            function renderStepper() {
              stepper.innerHTML = '';
              panes.forEach((p, i) => {
                const n = i + 1, t = p.dataset.title || ('Step ' + n);
                const node = document.createElement('div');
                node.className = 'ac-step' + (p.classList.contains('is-active') ? ' is-active' : '');
                node.innerHTML = `<div class="ac-dot">${n}</div><div>${t}</div>`;
                node.addEventListener('click', () => goto(n));
                stepper.appendChild(node);
                if (i < panes.length - 1) {
                  const line = document.createElement('div');
                  line.className = 'ac-step-line';
                  stepper.appendChild(line);
                }
              });
            }
            function goto(step) {
              const idx = Math.max(1, Math.min(step, panes.length));
              panes.forEach((p, i) => p.classList.toggle('is-active', i === idx - 1));
              wiz.dataset.step = String(idx);
              prevBtn.style.visibility = idx === 1 ? 'hidden' : 'visible';
              nextBtn.style.visibility = idx === panes.length ? 'hidden' : 'visible';
              renderStepper();
              updateProgressUI();
            }

            /* Autosave */
            const LS = `ac_dna_full_${customerId}`;
            function loadDraft() {
              try {
                const x = JSON.parse(localStorage.getItem(LS) || '{}');
                DNA_FIELDS.forEach(id => { if (x[id]) $(id).value = x[id]; });
                if (x.dna_moodboard && moodEl) moodEl.value = x.dna_moodboard;
              } catch {}
            }
            function saveDraftToLS() {
              const out = {};
              DNA_FIELDS.forEach(id => out[id] = ($(id)?.value || ''));
              out.dna_moodboard = (moodEl?.value || '');
              localStorage.setItem(LS, JSON.stringify(out));
              toast('Entwurf gespeichert','success');
            }
            function bindInputs() {
              [...DNA_FIELDS.map($), moodEl].forEach(el => {
                if (!el) return;
                el.addEventListener('input', () => { localStorage.setItem('__dirty','1'); updateProgressUI(); });
              });
            }

            /* Progress */
            function computeProgress() {
              const TEXT_MIN = 1;
              const MB_MIN_1 = 1;
              const MB_MIN_2 = 3;

              let done = 0, total = 0;
              DNA_FIELDS.forEach(id => {
                total += 1;
                const v = (document.getElementById(id)?.value || '').trim();
                if (v.length >= TEXT_MIN) done += 1;
              });

              const mb = (document.getElementById('dna_moodboard')?.value || '')
                .split(/\r?\n/).map(s => s.trim()).filter(Boolean);
              total += 2;
              if (mb.length >= MB_MIN_1) done += 1;
              if (mb.length >= MB_MIN_2) done += 1;

              const pct = Math.max(0, Math.min(100, Math.round((done / total) * 100)));
              return pct;
            }
            function setPill(el, pct) {
              if (!el) return;
              el.textContent = pct + '%';
              el.classList.remove('ac-pill-muted','ac-pill-warn','ac-pill-err','ac-pill-ok','ok','warn','muted');
              if (pct >= 80) el.classList.add('ac-pill-ok','ok');
              else if (pct >= 40) el.classList.add('ac-pill-warn','warn');
              else if (pct > 0) el.classList.add('ac-pill-err');
              else el.classList.add('ac-pill-muted','muted');
            }
            function updateProgressUI() {
              const pct = computeProgress();
              if (bar) bar.style.width = pct + '%';
              setPill(badgeTop, pct);
              setPill(badgeSide, pct);
              return pct;
            }

            /* Save to backend */
            function toast(t, type) {
              if (!msg) return;
              msg.textContent = t;
              msg.className = 'ac-feedback ' + (type || '');
              msg.style.display = t ? 'block' : 'none';
            }
            async function saveAll() {
              try {
                toast('Speichere…');
                const pct = updateProgressUI();
                const payload = { customerId };
                DNA_FIELDS.forEach(id => payload[`metafields[custom.${id}]`] = ($(id)?.value || '').trim());
                const mb = (moodEl?.value || '').split(/\r?\n/).map(s => s.trim()).filter(Boolean);
                if (mb.length) payload['metafields[custom.artist_dna_moodboard]'] = JSON.stringify(mb);
                payload['metafields[custom.artist_dna_completion]'] = String(pct);

                const res = await fetch(SAVE_URL, {
                  method: 'POST',
                  headers: { 'Content-Type':'application/json', 'X-Shop-Domain':'{{ shop.permanent_domain }}', 'X-Customer-Id':'{{ customer.id }}' },
                  body: JSON.stringify(payload)
                });
                const json = await res.json();
                if (!res.ok || !json.success) throw new Error(json.error || ('HTTP ' + res.status));

                localStorage.removeItem(LS);
                localStorage.removeItem('__dirty');
                toast('✓ Artist DNA gespeichert','success');
              } catch (e) {
                console.error(e);
                toast('Fehler: ' + e.message,'error');
              }
            }

            /* Events */
            prevBtn.addEventListener('click', () => goto(Number(wiz.dataset.step) - 1));
            nextBtn.addEventListener('click', () => goto(Number(wiz.dataset.step) + 1));
            saveBtn.addEventListener('click', saveAll);
            saveDraftBtn.addEventListener('click', saveDraftToLS);

            // init
            loadDraft();
            bindInputs();
            renderStepper();
            goto(1);
          })();
        </script>

        <!-- DOKUMENTE -->
        <section id="sec-docs" class="ac-card" data-tab="docs">
          <header class="ac-card-head"><h2>Dokumente & Verträge</h2></header>
          <div class="ac-card-body">
            <div class="ac-note">
              Aus Sicherheitsgründen werden Verträge in deinem Konto nicht angezeigt. Wenn du Unterlagen benötigst,
              kannst du sie hier anfordern.
            </div>
            <button class="ac-btn ac-btn-primary" type="button" id="requestDocsBtn">Unterlagen anfragen</button>
          </div>

          {%- comment -%} === Marketing Uploads (list.file_reference) === {%- endcomment -%}
          <header class="ac-card-head">
            <h2>Marketing-Uploads</h2>
            <small class="ac-hint">Bilder (≤20 MB) & Videos (≤1 GB).</small>
          </header>

          <div class="ac-card-body">
            {% assign mfiles = customer.metafields.custom.kunstler_bilder_fur_marketing_co %}
            {% assign file_items = null %}
            {% if mfiles and mfiles.value %}
              {% if mfiles.type == 'list.file_reference' %}
                {% assign file_items = mfiles.value %}
              {% else %}
                {% assign parsed = mfiles.value | parse_json %}
                {% if parsed %}{% assign file_items = parsed %}{% endif %}
              {% endif %}
            {% endif %}

            <div id="acAssets" class="ac-assets" data-shop="{{ shop.permanent_domain }}" data-customer="{{ customer.id }}">
              <div id="assetGrid" class="ac-asset-grid">
                {% if file_items and file_items.size > 0 %}
                  {% for f in file_items %}
                    {% assign gid = f.id | default: f %}
                    <div class="ac-asset" data-gid="{{ gid }}">
                      {% if f.preview and f.preview.image and f.preview.image.url %}
                        <img src="{{ f.preview.image.url | img_url: '360x' }}" alt="">
                      {% elsif f.image and f.image.url %}
                        <img src="{{ f.image.url | img_url: '360x' }}" alt="">
                      {% else %}
                        <div class="ac-asset-fallback">Datei</div>
                      {% endif %}
                      <button type="button" class="ac-remove" data-gid="{{ gid }}">Entfernen</button>
                    </div>
                  {% endfor %}
                {% endif %}
              </div>

              <div id="dropzone" class="ac-drop">
                <div><strong>Zieh Dateien hierher</strong> oder</div>
                <input id="assetInput" type="file" multiple accept="image/*,video/*">
                <button type="button" class="ac-btn ac-btn-primary" id="pickFilesBtn">Dateien auswählen</button>
              </div>

              <div class="ac-savebar" style="margin-top:12px">
                <div id="assetMsg" class="ac-feedback" style="display:none"></div>
                <button id="saveAssetsBtn" class="ac-btn ac-btn-primary">Dateien speichern</button>
              </div>
            </div>
          </div>

          <style>
            .ac-asset-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
            @media (max-width: 980px) { .ac-asset-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
            .ac-asset { position: relative; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #fff; }
            .ac-asset img { display: block; width: 100%; height: 160px; object-fit: cover; }
            .ac-asset-fallback { display: grid; place-items: center; height: 160px; color: var(--muted); font-weight: 700; }
            .ac-asset .ac-remove {
              position: absolute; top: 8px; right: 8px; background: #fff; border: 1px solid var(--line);
              border-radius: 8px; padding: 6px 8px; cursor: pointer;
            }
            .ac-drop {
              display: grid; place-items: center; border: 2px dashed var(--line); border-radius: 12px;
              padding: 16px; background: rgba(255, 255, 255, 0.6); gap: 8px; text-align: center;
            }
            .ac-drop.drag { background: #eef6ff; border-color: #0a84ff; }
            .ac-drop input[type='file'] { display: none; }
          </style>

          <script>
            (() => {
              const wrap = document.getElementById('acAssets');
              if (!wrap) return;

              const shop = wrap.dataset.shop;
              const customerId = wrap.dataset.customer;
              const grid = document.getElementById('assetGrid');
              const dz = document.getElementById('dropzone');
              const pickBtn = document.getElementById('pickFilesBtn');
              const fileInput = document.getElementById('assetInput');
              const msg = document.getElementById('assetMsg');
              const saveBtn = document.getElementById('saveAssetsBtn');

              // lokale State: Array von GIDs (bereits vorhanden)
              let assetGids = [...grid.querySelectorAll('.ac-asset')].map(n => n.dataset.gid);

              function setMsg(t, type) {
                msg.textContent = t;
                msg.className = 'ac-feedback ' + (type || '');
                msg.style.display = t ? 'block' : 'none';
              }
              function addThumb(gid, url) {
                const c = document.createElement('div');
                c.className = 'ac-asset';
                c.dataset.gid = gid;
                c.innerHTML =
                  (url ? `<img src="${url}" alt="" />` : `<div class="ac-asset-fallback">Datei</div>`) +
                  `<button type="button" class="ac-remove" data-gid="${gid}">Entfernen</button>`;
                grid.prepend(c);
                c.querySelector('.ac-remove').addEventListener('click', onRemove);
              }
              function onRemove(e) {
                const gid = e.currentTarget.dataset.gid;
                assetGids = assetGids.filter(x => x !== gid);
                e.currentTarget.closest('.ac-asset')?.remove();
              }
              grid.querySelectorAll('.ac-remove').forEach(b => b.addEventListener('click', onRemove));

              function normFiles(list) {
                return Array.from(list || []).filter(f => f && (f.type.startsWith('image/') || f.type.startsWith('video/')));
              }

              // Drag & Drop
              ['dragenter', 'dragover'].forEach(ev =>
                dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add('drag'); }, { passive: false })
              );
              ['dragleave', 'drop'].forEach(ev =>
                dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove('drag'); }, { passive: false })
              );
              dz.addEventListener('drop', async e => {
                const files = normFiles(e.dataTransfer.files);
                if (files.length) await uploadFiles(files);
              });
              pickBtn.addEventListener('click', () => fileInput.click());
              fileInput.addEventListener('change', async e => {
                const files = normFiles(e.target.files);
                if (files.length) await uploadFiles(files);
                e.target.value = '';
              });

              async function uploadFiles(files) {
                for (const f of files) {
                  try {
                    setMsg(`Lade hoch: ${f.name}`, '');

                    // 1) Datei an unseren Server (multipart/form-data)
                    const fd = new FormData();
                    fd.append('file', f);

                    const upRes = await fetch('https://v0-shopify-vercel-project.vercel.app/api/blob/create-upload-url', {
                      method: 'POST',
                      body: fd
                    });
                    const upJson = await upRes.json();
                    if (!upRes.ok || !upJson.success) throw new Error(upJson.error || 'Upload failed');

                    const publicUrl = upJson.publicUrl;

                    // 2) In Shopify als File anlegen
                    const finRes = await fetch('https://v0-shopify-vercel-project.vercel.app/api/artist-assets/finalize', {
                      method: 'POST',
                      headers: { 'Content-Type':'application/json' },
                      body: JSON.stringify({
                        shop: '{{ shop.permanent_domain }}',
                        customerId: '{{ customer.id }}',
                        blobUrl: publicUrl,
                        contentType: f.type
                      })
                    });
                    const finJson = await finRes.json();
                    if (!finRes.ok || !finJson.success) throw new Error(finJson.error || 'Finalize failed');

                    const { fileId, previewUrl } = finJson;
                    if (!assetGids.includes(fileId)) assetGids.push(fileId);
                    addThumb(fileId, previewUrl || publicUrl);
                    setMsg(`✓ Hochgeladen: ${f.name}`, 'success');
                  } catch (err) {
                    console.error(err);
                    setMsg(`Fehler: ${f.name} – ${err.message}`, 'error');
                  }
                }
              }

              // Speichert die Liste als list.file_reference
              saveBtn.addEventListener('click', async () => {
                try {
                  setMsg('Speichere…', '');
                  const payload = {
                    customerId,
                    'metafields[custom.kunstler_bilder_fur_marketing_co]': JSON.stringify(assetGids),
                  };
                  const res = await fetch('https://v0-shopify-vercel-project.vercel.app/api/update-artist-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Shop-Domain': shop, 'X-Customer-Id': customerId },
                    body: JSON.stringify(payload),
                  });
                  const json = await res.json();
                  if (!res.ok || !json.success) throw new Error(json.error || 'HTTP ' + res.status);
                  setMsg('✓ Dateien gespeichert', 'success');
                } catch (err) {
                  console.error(err);
                  setMsg('Fehler beim Speichern: ' + err.message, 'error');
                }
              });
            })();
          </script>
        </section>

        <!-- KONTAKT -->
        <section id="sec-contact" class="ac-card" data-tab="kontakt">
          <header class="ac-card-head"><h2>Kontakt zum Team</h2></header>
          <div class="ac-card-body">
            {% form 'contact' %}
              {% if form.posted_successfully? %}
                <div class="ac-feedback success">Danke! Wir melden uns kurzfristig.</div>
              {% elsif form.errors %}
                <div class="ac-feedback error">Bitte prüfe deine Eingaben.</div>
              {% endif %}

              <div class="ac-grid">
                <div class="ac-cell">
                  <label for="ContactFormName">Dein Name</label>
                  <input id="ContactFormName" name="contact[name]" type="text" class="ac-input" value="{{ customer.name }}" required>
                </div>
                <div class="ac-cell">
                  <label for="ContactFormEmail">E-Mail</label>
                  <input id="ContactFormEmail" name="contact[email]" type="email" class="ac-input" value="{{ customer.email }}" required>
                </div>
                <div class="ac-cell ac-span-12">
                  <label for="ContactFormMessage">Nachricht</label>
                  <textarea id="ContactFormMessage" name="contact[body]" rows="5" class="ac-input" required>Hallo ARTCLUB Team,

bitte sendet mir meine Verträge/Dokumente zu.
Kundennummer: {{ customer.id }}
E-Mail: {{ customer.email }}

Danke!</textarea>
