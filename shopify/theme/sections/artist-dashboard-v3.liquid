    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const dash = document.getElementById('artistDashboard');
        if (!dash) return;

        /* NAV */
        const panels = [...dash.querySelectorAll('.ac-card')];
        const sideBtns = [...dash.querySelectorAll('.ac-nav-item')];
        const tabBtns = [...dash.querySelectorAll('.ac-tabbar .ac-tab')];

        function show(id) {
          panels.forEach(p => {
            const a = p.id === id;
            p.classList.toggle('is-active', a);
            p.style.display = a ? 'block' : 'none';
          });
          sideBtns.forEach(b => b.classList.toggle('is-active', b.dataset.target === id));
          tabBtns.forEach(b => b.classList.toggle('is-active', b.dataset.target === id));
        }

        show('sec-overview'); // Overview ist Standard
        sideBtns.forEach(b => b.addEventListener('click', () => show(b.dataset.target)));
        tabBtns.forEach(b => b.addEventListener('click', () => show(b.dataset.target)));
        dash.querySelector('#requestDocsBtn')?.addEventListener('click', () => show('sec-contact'));

        dash.querySelectorAll('[data-jump]').forEach(btn => {
          btn.addEventListener('click', () => show(btn.dataset.jump));
        });


        /* Edit toggles — supports comma-separated ids */
        dash.querySelectorAll('.ac-edit-toggle').forEach(btn => {
          btn.addEventListener('click', () => {
            const ids = (btn.dataset.target || '').split(',').map(s => s.trim()).filter(Boolean);
            const els = ids.map(id => dash.querySelector('#' + id)).filter(Boolean);
            const allOpen = els.every(el => el.style.display === 'block');
            els.forEach(el => el.style.display = allOpen ? 'none' : 'block');
            btn.textContent = allOpen ? 'Bearbeiten' : 'Fertig';
          });
        });

        /* Social links editor */
        const linksEditor = dash.querySelector('#linksEditor');
        const linksEditList = dash.querySelector('#linksEditList');
        const linksDisplayList = dash.querySelector('#linksDisplayList');
        const linksDisplayBox = dash.querySelector('#linksDisplayBox');
        const linksEmptyNote = dash.querySelector('#linksEmptyNote');
        const newLinkInput = dash.querySelector('#newLinkInput');
        const addLinkBtn = dash.querySelector('#addLinkBtn');

        function parseInitialLinks() {
          const raw = (linksEditor?.dataset.initial || '').trim();
          if (!raw) return [];
          return raw.split(/\r?\n/).map(s => s.trim()).filter(Boolean);
        }
        let linkState = parseInitialLinks();

        function escapeHtml(s) {
          return s.replace(/[&<>"']/g, m => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m]));
        }
        function normalizeUrl(u) {
          let s = (u || '').trim();
          if (!s) return '';
          if (!/^https?:\/\//i.test(s)) s = 'https://' + s;
          try { new URL(s); return s; } catch { return ''; }
        }
        function renderEditList() {
          linksEditList.innerHTML = '';
          if (!linkState.length) {
            linksEditList.innerHTML = '<div class="ac-hint">Noch keine Links. Füge einen Link hinzu.</div>';
            return;
          }
          linkState.forEach((url, idx) => {
            const row = document.createElement('div');
            row.className = 'ac-link-item';
            row.innerHTML = `<div class="ac-link-url">${escapeHtml(url)}</div><button type="button" class="ac-remove" data-i="${idx}">Entfernen</button>`;
            linksEditList.appendChild(row);
          });
          linksEditList.querySelectorAll('.ac-remove').forEach(b => {
            b.addEventListener('click', () => {
              const i = Number(b.dataset.i);
              linkState.splice(i, 1);
              renderEditList();
              renderDisplayList();
            });
          });
        }
        function ensureDisplayList() {
          if (!linksDisplayList) {
            const ul = document.createElement('ul');
            ul.className = 'ac-links';
            ul.id = 'linksDisplayList';
            linksDisplayBox?.appendChild(ul);
            return ul;
          }
          return linksDisplayList;
        }
        function renderDisplayList() {
          const ul = ensureDisplayList();
          ul.innerHTML = '';
          if (!linkState.length) {
            if (linksEmptyNote) linksEmptyNote.style.display = 'inline';
            return;
          }
          if (linksEmptyNote) linksEmptyNote.style.display = 'none';
          linkState.forEach(url => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = url; a.target = '_blank'; a.rel = 'noopener'; a.textContent = url;
            li.appendChild(a); ul.appendChild(li);
          });
        }
        renderEditList();
        renderDisplayList();

        addLinkBtn?.addEventListener('click', () => {
          const n = normalizeUrl(newLinkInput.value);
          if (!n) { newLinkInput.focus(); return; }
          if (!linkState.includes(n)) linkState.push(n);
          newLinkInput.value = '';
          renderEditList();
          renderDisplayList();
        });

        /* Save */
        const saveBtn = dash.querySelector('#saveButton');
        const feedback = dash.querySelector('#formFeedback');
        const SAVE_URL = 'https://v0-shopify-vercel-project.vercel.app/api/update-artist-profile';
        const val = sel => dash.querySelector(sel)?.value?.trim() || '';
        function setFeedback(msg, type) {
          feedback.textContent = msg;
          feedback.className = 'ac-feedback ' + (type || '');
          feedback.style.display = msg ? 'block' : 'none';
        }
        function linksAsNewlines() { return linkState.join('\n'); }

        async function doSave() {
          setFeedback('', '');
          saveBtn.disabled = true;
          saveBtn.textContent = 'Speichere…';
          const payload = {
            customerId: dash.dataset.customerId,
            'metafields[custom.biography]': val('#biography'),
            'metafields[custom.social_media_links]': linksAsNewlines(),
            'metafields[custom.kunstler_fragen_stil]': val('#kuenstler_fragen_stil'),
            'metafields[custom.kunstler_fragen_kunstart]': val('#kuenstler_fragen_kunstart'),
            'metafields[custom.kunstler_kunstmedien]': val('#kuenstler_kunstmedien'),
            'metafields[custom.bankdaten_name]': val('#bankdaten_name'),
            'metafields[custom.bankdaten_iban]': val('#bankdaten_iban'),
            'metafields[custom.bankdaten_steuernummer]': val('#bankdaten_steuernummer'),
          };
          try {
            const res = await fetch(SAVE_URL, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-Shop-Domain': '{{ shop.permanent_domain }}',
                'X-Customer-Id': '{{ customer.id }}',
              },
              body: JSON.stringify(payload),
              credentials: 'omit',
            });
            const json = await res.json();
            if (!res.ok || !json.success) throw new Error(json.error || 'HTTP ' + res.status);

            // Update UI
            const bioEl = dash.querySelector('[data-display-for="biography"]');
            if (bioEl) {
              bioEl.innerHTML =
                (payload['metafields[custom.biography]'] || '').replace(/\n/g, '<br>') ||
                '<em>Noch keine Biografie hinterlegt</em>';
            }
            renderDisplayList();
            const txtMap = {
              kunstler_fragen_stil: 'metafields[custom.kunstler_fragen_stil]',
              kunstler_fragen_kunstart: 'metafields[custom.kunstler_fragen_kunstart]',
              kunstler_kunstmedien: 'metafields[custom.kunstler_kunstmedien]',
              bankdaten_name: 'metafields[custom.bankdaten_name]',
              bankdaten_steuernummer: 'metafields[custom.bankdaten_steuernummer]',
            };
            Object.keys(txtMap).forEach(k => {
              const el = dash.querySelector(`[data-display-for="${k}"]`);
              const v = payload[txtMap[k]];
              if (el) el.textContent = v || '—';
            });
            if (payload['metafields[custom.bankdaten_iban]'] !== undefined) {
              const ibanEl = dash.querySelector('[data-display-for="bankdaten_iban"]');
              if (ibanEl) {
                const raw = (payload['metafields[custom.bankdaten_iban]'] || '').replaceAll(' ', '').replaceAll('-', '');
                ibanEl.textContent = raw ? `${raw.slice(0, 4)}••••••••••••••${raw.slice(-4)}` : '—';
              }
            }
            setFeedback('✓ Änderungen erfolgreich gespeichert', 'success');
          } catch (err) {
            setFeedback('Fehler beim Speichern: ' + err.message, 'error');
            console.error(err);
          } finally {
            saveBtn.disabled = false;
            saveBtn.textContent = 'Alle Änderungen speichern';
          }
        }
        dash.querySelector('#saveButton')?.addEventListener('click', doSave);
      });
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const dnaPanelBadge = document.getElementById('dnaProgressBadge');
        const dnaNavBadge = document.getElementById('dnaSideBadge');

        function syncDnaBadge() {
          if (!dnaPanelBadge || !dnaNavBadge) return;
          dnaNavBadge.textContent = dnaPanelBadge.textContent;
          dnaNavBadge.className = dnaPanelBadge.className;
        }

        // einmal beim Laden
        syncDnaBadge();

        // wenn der Prozentwert im DNA-Script aktualisiert wird:
        const mo = new MutationObserver(syncDnaBadge);
        if (dnaPanelBadge) mo.observe(dnaPanelBadge, { childList: true, characterData: true, subtree: true });

        // zusätzlich beim Tabwechsel updaten
        document.querySelectorAll('.ac-nav-item, .ac-tabbar .ac-tab')
          .forEach(b => b.addEventListener('click', syncDnaBadge));
      });
    </script>

    <script>
      (function(){
        const btn   = document.getElementById('openDnaMapBtn');
        const modal = document.getElementById('dnaModal');
        const closeBtn = document.getElementById('dnaModalClose');

        // Fallback: wenn etwas fehlt, still aussteigen
        if (!btn || !modal) return;

        // Zugriff auf die Progress-Funktionen aus dem DNA-Script
        // computeProgress() und updateProgressUI() sind dort definiert – falls nicht, fallback auf Badge.
        function currentPct(){
          try {
            if (typeof computeProgress === 'function') return computeProgress();
            const badge = document.getElementById('dnaProgressBadge');
            const n = parseInt((badge?.textContent || '0').replace('%',''), 10);
            return isNaN(n) ? 0 : n;
          } catch(e){ return 0; }
        }

        function openModal(){
          const pct = currentPct();
          if (pct < 50) {
            btn.disabled = true;
            btn.classList.remove('ac-btn-primary');
            btn.textContent = 'Mindmap ab 50% Profil (erst ausfüllen)';
            setTimeout(() => { btn.disabled = false; }, 1200);
            return;
          }
          modal.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        }

        function closeModal(){
          modal.classList.remove('is-open');
          document.body.style.overflow = '';
        }

        btn.addEventListener('click', openModal);
        closeBtn?.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      })();
    </script>


  {% else %}
    <p>Kein Künstlerzugang für dieses Konto.</p>
  {% endif %}
{% else %}
  <p>Bitte einloggen, um das Künstler-Dashboard zu sehen.</p>
{% endif %}

