                      {% assign parsed = sl.value | parse_json %}
                      {% if parsed %}{% assign links_array = parsed %}{% else %}{% assign links_array = sl.value | split: '\n' %}{% endif %}
                    {% endif %}
                  {% endif %}

                  {% if links_array and links_array.size > 0 %}
                    <ul class="ac-links" id="linksDisplayList">
                      {% for item in links_array %}
                        {% assign url = item.url | default: item | strip %}
                        {% if url != blank %}
                          <li><a href="{{ url }}" target="_blank" rel="noopener">{{ url }}</a></li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% else %}
                    <em id="linksEmptyNote">Keine Social Links hinterlegt</em>
                  {% endif %}
                </div>

                {%- comment -%} sichere Rohwerte in data-Attribut (kein Output) {%- endcomment -%}
                {% capture initial_links %}
