        <!-- Save Bar -->
        <div class="ac-savebar">
          <div id="formFeedback" class="ac-feedback" style="display:none"></div>
          <button id="saveButton" class="ac-btn ac-btn-primary">Alle Änderungen speichern</button>
        </div>
      </main>

      <!-- Artist DNA Mindmap Modal -->
      <style>
        .dna-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.55)}
        .dna-modal.is-open{display:flex}
        .dna-sheet{width:min(1100px,95vw);max-height:90vh;overflow:auto;border-radius:18px;background:var(--bg);padding:16px;border:1px solid var(--line);box-shadow:0 30px 80px rgba(0,0,0,.35)}
        .dna-sheet-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
