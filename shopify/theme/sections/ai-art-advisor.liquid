  <script>
    (function() {
      const sectionId = "{{ section.id }}";
      const root = document.getElementById("acai-chat-" + sectionId);
      if (!root) return;

      const endpoint = "{{ section.settings.ai_endpoint | escape }}";

      const launcher = root.querySelector("[data-acai-open]");
      const overlay = root.querySelector("[data-acai-overlay]");
      const closeButtons = root.querySelectorAll("[data-acai-close]");
      const chatThread = root.querySelector(".acai-chat-thread");
      const inputEl = root.querySelector("#acai-input-" + sectionId);
      const submitBtn = root.querySelector("#acai-submit-" + sectionId);
      const exampleBtns = root.querySelectorAll(".acai-example-btn");

      const imageBtn = root.querySelector("#acai-image-button-" + sectionId);
      const imageInput = root.querySelector("#acai-image-input-" + sectionId);

      let isOpen = false;
      let isSending = false;
      let chatHistory = [];
      let selectedImageDataUrl = null;

      function lockScroll(lock) {
        const method = lock ? "add" : "remove";
        document.documentElement.classList[method]("acai-no-scroll");
        document.body.classList[method]("acai-no-scroll");
      }

      function openOverlay() {
        if (isOpen) return;
        isOpen = true;
        overlay.classList.add("acai-overlay--visible");
        overlay.setAttribute("aria-hidden", "false");
        lockScroll(true);
        window.setTimeout(function() {
          if (inputEl) inputEl.focus();
        }, 50);
      }

      function closeOverlay() {
        if (!isOpen) return;
        isOpen = false;
        overlay.classList.remove("acai-overlay--visible");
        overlay.setAttribute("aria-hidden", "true");
        lockScroll(false);
      }

      function escapeHtml(str) {
        if (typeof str !== "string") return "";
        return str
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function appendUserMessage(text, imageUrl) {
        const wrapper = document.createElement("div");
        wrapper.className = "acai-message acai-message--user acai-message--enter";

        const safeText = escapeHtml(text);

        wrapper.innerHTML = `
          <div class="acai-avatar acai-avatar--user">DU</div>
          <div class="acai-bubble">
            <p>${safeText}</p>
            ${imageUrl ? `<img src="${imageUrl}" alt="Dein Bild" class="acai-user-image">` : ""}
          </div>
        `;
        chatThread.appendChild(wrapper);
        chatThread.scrollTop = chatThread.scrollHeight;
      }

      function appendAssistantLoading() {
        const wrapper = document.createElement("div");
        wrapper.className = "acai-message acai-message--assistant acai-message--loading acai-message--enter";
        wrapper.innerHTML = `
          <div class="acai-avatar acai-avatar--assistant">AC</div>
          <div class="acai-bubble">
            <div class="acai-loading">
              <span>Denke nach</span>
              <span class="acai-dot"></span>
              <span class="acai-dot"></span>
              <span class="acai-dot"></span>
            </div>
          </div>
        `;
        chatThread.appendChild(wrapper);
        chatThread.scrollTop = chatThread.scrollHeight;
        return wrapper;
      }

      function appendAssistantMessage(data) {
        const wrapper = document.createElement("div");
        wrapper.className = "acai-message acai-message--assistant acai-message--enter";

        const explanation = data && data.explanation
          ? data.explanation
          : "Hier sind einige Werke, die zu deiner Beschreibung passen könnten:";

        let productsHtml = "";
        if (data && Array.isArray(data.products) && data.products.length > 0) {
          const cards = data.products.map(function(p) {
            const handle = p.handle || "";
            const title = p.title || "";
            const artist = p.artist || "";
            const reason = p.reason || "";
            const imageUrl = p.imageUrl || "";
            const href = handle ? "/products/" + encodeURIComponent(handle) : "#";

            return `
              <a class="acai-product-card" href="${href}">
                <div class="acai-product-card__image-wrap">
                  ${imageUrl ? `<img class="acai-product-card__image" src="${imageUrl}" alt="${escapeHtml(title)}" loading="lazy">` : ""}
                </div>
                <div class="acai-product-card__body">
                  <div class="acai-product-card__title">${escapeHtml(title)}</div>
                  ${artist ? `<div class="acai-product-card__artist">${escapeHtml(artist)}</div>` : ""}
                  ${reason ? `<div class="acai-product-card__reason">${escapeHtml(reason)}</div>` : ""}
                </div>
              </a>
            `;
          }).join("");

          productsHtml = `<div class="acai-products">${cards}</div>`;
        }

        wrapper.innerHTML = `
          <div class="acai-avatar acai-avatar--assistant">AC</div>
          <div class="acai-bubble">
            <p>${escapeHtml(explanation)}</p>
            ${productsHtml}
          </div>
        `;

        chatThread.appendChild(wrapper);
        chatThread.scrollTop = chatThread.scrollHeight;
      }

      function handleImageFile(file) {
        if (!file) {
          selectedImageDataUrl = null;
          return;
        }
        const reader = new FileReader();
        reader.onload = function(e) {
          selectedImageDataUrl = e.target.result;
        };
        reader.readAsDataURL(file);
      }

      async function handleSend(query) {
        const trimmed = (query || "").trim();
        if (!trimmed || !endpoint || isSending) return;

        openOverlay();
        isSending = true;
        submitBtn.classList.add("acai-submit--loading");

        // Snapshot des aktuell ausgewählten Bildes – nur für diese Nachricht
        const imageForThisMessage = selectedImageDataUrl;

        appendUserMessage(trimmed, imageForThisMessage);
        chatHistory.push({ role: "user", content: trimmed });

        const loadingMessage = appendAssistantLoading();

        try {
          const res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              query: trimmed,
              history: chatHistory.slice(-6),
              imageDataUrl: imageForThisMessage || null
            })
          });

          const data = await res.json().catch(function() { return null; });

          if (loadingMessage && loadingMessage.parentNode) {
            loadingMessage.parentNode.removeChild(loadingMessage);
          }

          if (!res.ok || !data) {
            const fallback = {
              explanation: "Es ist ein Fehler aufgetreten. Versuch es bitte später erneut oder formuliere deine Anfrage etwas kürzer.",
              products: []
            };
            appendAssistantMessage(fallback);
            chatHistory.push({ role: "assistant", content: fallback.explanation });
          } else {
            appendAssistantMessage(data);

            let summary = "";
            if (data.explanation) {
              summary = data.explanation;
            } else if (Array.isArray(data.products) && data.products.length > 0) {
              const titles = data.products
                .map(function(p) { return p && p.title ? String(p.title) : ""; })
                .filter(Boolean)
                .join(", ");
              if (titles) {
                summary = "Empfohlene Werke: " + titles;
              }
            }
            if (summary) {
              chatHistory.push({ role: "assistant", content: summary });
            }
          }
        } catch (err) {
          console.error("ACAI error", err);
          if (loadingMessage && loadingMessage.parentNode) {
            loadingMessage.parentNode.removeChild(loadingMessage);
          }
          const fallback = {
            explanation: "Ich konnte gerade keine Empfehlung laden. Bitte versuch es gleich noch einmal.",
            products: []
          };
          appendAssistantMessage(fallback);
          chatHistory.push({ role: "assistant", content: fallback.explanation });
        } finally {
          isSending = false;
          submitBtn.classList.remove("acai-submit--loading");
          // Bild nur für diese Nachricht nutzen, danach zurücksetzen
          selectedImageDataUrl = null;
        }
      }

      /* Event wiring */

      if (launcher) {
        launcher.addEventListener("click", function() {
          openOverlay();
        });
      }

      closeButtons.forEach(function(btn) {
        btn.addEventListener("click", function() {
          closeOverlay();
        });
      });

      overlay.addEventListener("click", function(e) {
        if (e.target === overlay || e.target.classList.contains("acai-overlay__backdrop")) {
          closeOverlay();
        }
      });

      document.addEventListener("keydown", function(e) {
        if (e.key === "Escape") {
          closeOverlay();
        }
      });

      if (submitBtn && inputEl) {
        submitBtn.addEventListener("click", function() {
          const value = inputEl.value;
          inputEl.value = "";
          handleSend(value);
        });

        inputEl.addEventListener("keydown", function(e) {
          if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            const value = inputEl.value;
            inputEl.value = "";
            handleSend(value);
          }
        });

        if (inputEl) {
          // Höhe automatisch an Text anpassen
          const autoResize = function () {
            inputEl.style.height = "auto";
            inputEl.style.height = inputEl.scrollHeight + "px";
            chatThread.scrollTop = chatThread.scrollHeight;
          };

          inputEl.addEventListener("input", autoResize);
          // einmal initial
          autoResize();
        }

      }

      if (exampleBtns && exampleBtns.length) {
        exampleBtns.forEach(function(btn) {
          btn.addEventListener("click", function() {
            const text = btn.getAttribute("data-example") || "";
            if (inputEl) {
              inputEl.value = text;
              inputEl.focus();
            }
          });
        });
      }

      if (imageBtn && imageInput) {
        imageBtn.addEventListener("click", function() {
          imageInput.click();
        });

        imageInput.addEventListener("change", function() {
          const file = imageInput.files && imageInput.files[0];
          handleImageFile(file);
        });
      }
    })();
  </script>

