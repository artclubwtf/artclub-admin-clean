{% comment %}
  AC Apple Navbar – Artclub
  - Logo links
  - Mitte: Artworks (Link) + beliebig viele Meta-Menüs (mit Mega-Dropdown & A–Z)
  - Rechts: About, Suche, Warenkorb
{% endcomment %}

<header class="ac-apple-nav" role="banner">
  <style>
    .ac-apple-nav {
      position: relative !important;
      z-index: 50 !important;
      width: 100% !important;
      background: #ffffff !important;
      border-bottom: 1px solid rgba(0,0,0,0.04) !important;
      font-size: 13px !important;
      line-height: 1 !important;
    }

    .ac-apple-nav__inner {
      max-width: 980px !important;
      margin: 0 auto !important;
      padding: 12px 24px !important;
      display: grid !important;
      grid-template-columns: auto 1fr auto !important;
      align-items: center !important;
      gap: 24px !important;
    }

    /* Logo */

    .ac-apple-nav__logo {
      display: flex !important;
      align-items: center !important;
      gap: 6px !important;
    }

    .ac-apple-nav__logo-link {
      display: inline-flex !important;
      align-items: center !important;
      text-decoration: none !important;
      color: #111111 !important;
    }

    .ac-apple-nav__logo-icon {
      width: 16px !important;
      height: 16px !important;
      border-radius: 3px !important;
      background: #111111 !important;
      display: inline-block !important;
    }

    .ac-apple-nav__logo-text {
      font-size: 13px !important;
      font-weight: 600 !important;
      letter-spacing: .06em !important;
      text-transform: lowercase !important;
    }

    /* Mitte: Menüzeile */

    .ac-apple-nav__menu {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 24px !important;
    }

    .ac-apple-nav__item {
      position: relative !important;
    }

    .ac-apple-nav__link {
      text-decoration: none !important;
      color: #111111 !important;
      opacity: .9 !important;
      padding: 4px 0 !important;
      display: inline-flex !important;
      align-items: center !important;
      transition: opacity .16s ease !important;
      white-space: nowrap !important;
      cursor: pointer !important;
    }

    .ac-apple-nav__link:hover,
    .ac-apple-nav__link:focus {
      opacity: 1 !important;
    }

    /* Rechts: Icons */

    .ac-apple-nav__actions {
      display: flex !important;
      align-items: center !important;
      gap: 18px !important;
      justify-content: flex-end !important;
    }

    .ac-apple-nav__icon-btn {
      border: none !important;
      background: transparent !important;
      padding: 0 !important;
      margin: 0 !important;
      cursor: pointer !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .ac-apple-nav__icon {
      width: 15px !important;
      height: 15px !important;
      display: block !important;
    }

    .ac-apple-nav__cart-count {
      position: relative !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 17px !important;
      height: 17px !important;
      border-radius: 999px !important;
      background: #111111 !important;
      color: #ffffff !important;
      font-size: 10px !important;
      margin-left: 4px !important;
    }

    /* Mega-Menü für Meta-Listen */





    .ac-apple-nav__mega {
      position: absolute !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      top: 100% !important;
      margin-top: 0 !important;
      min-width: 720px !important;
      background: #f5f5f7 !important;
      padding: 32px 56px 40px !important;
      border-bottom-left-radius: 24px !important;
      border-bottom-right-radius: 24px !important;
    }

    .ac-apple-nav__mega-inner {
      display: grid !important;
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 2fr) !important;
      gap: 24px !important;
    }

    .ac-apple-nav__mega-heading {
      font-size: 11px !important;
      text-transform: uppercase !important;
      letter-spacing: .12em !important;
      opacity: .6 !important;
      margin-bottom: 10px !important;
    }

    /* A–Z Filter & Liste */

    .ac-meta-list-block__alpha {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 4px !important;
      margin-bottom: 8px !important;
    }

    .ac-meta-list-block__alpha-btn {
      border: none !important;
      background: transparent !important;
      padding: 0 4px !important;
      font-size: 11px !important;
      cursor: pointer !important;
      opacity: .6 !important;
    }

    .ac-meta-list-block__alpha-btn.is-active {
      opacity: 1 !important;
      text-decoration: underline !important;
    }

    .ac-meta-list-block__items {
      max-height: 260px !important;
      overflow-y: auto !important;
      padding-right: 4px !important;
    }

    .ac-meta-list-block__item a {
      display: block !important;
      font-size: 13px !important;
      text-decoration: none !important;
      color: #111111 !important;
      opacity: .85 !important;
      margin-bottom: 4px !important;
    }

    .ac-meta-list-block__item a:hover {
      opacity: 1 !important;
    }

    /* Mobile: kann vorerst vom normalen Header kommen */

    @media (max-width: 960px) {
      .ac-apple-nav__inner {
        display: none !important;
      }
    }

