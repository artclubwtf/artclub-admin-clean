{% comment %}
ARTCLUB FILES — Blog Overview (Editorial) + Tag Filters
- Light mode, magazine grid
- Tag filter pills automatically built from current page's articles
- No external libraries
{% endcomment %}

<section class="ac-blog">
  <div class="ac-blog__wrap" data-ac-blog>

    <header class="ac-blog__head">
      <div class="ac-blog__kicker">{{ section.settings.kicker }}</div>
      <h1 class="ac-blog__title">
        {% if section.settings.title != blank %}
          {{ section.settings.title }}
        {% else %}
          {{ blog.title }}
        {% endif %}
      </h1>
      {% if section.settings.sub != blank %}
        <p class="ac-blog__sub">{{ section.settings.sub }}</p>
      {% endif %}
    </header>

    {%- comment -%}
      Build unique tag list from current page articles
    {%- endcomment -%}
{% assign all_tags = "" %}

{% for article in blog.articles %}
  {% for tag in article.tags %}
    {% assign all_tags = all_tags | append: tag | append: "," %}
  {% endfor %}
{% endfor %}


{% assign tags = all_tags | split: "," | uniq %}


{% assign categories = "All|Berlin|Artists|Collecting|Galleries|Culture|Trends|Office" | split: "|" %}

<div class="ac-blog__filters" data-ac-filters>
  {% for c in categories %}
    {% assign key = c | downcase %}
    <button class="ac-pill {% if forloop.first %}is-active{% endif %}" type="button" data-ac-cat="{{ key }}">
      {{ c }}
    </button>
  {% endfor %}
</div>


    <div class="ac-blog__grid" data-ac-grid>
      {% for article in blog.articles %}
        {% assign cats = "all," %}

{% for t in article.tags %}
  {% assign tt = t | downcase | strip %}

  {% if tt contains "berlin" %}
    {% assign cats = cats | append: "berlin," %}
  {% endif %}

  {% if tt contains "artist" or tt contains "emerging" %}
    {% assign cats = cats | append: "artists," %}
  {% endif %}

  {% if tt contains "collect" %}
    {% assign cats = cats | append: "collecting," %}
  {% endif %}

  {% if tt contains "galler" or tt contains "art spaces" %}
    {% assign cats = cats | append: "galleries," %}
  {% endif %}

  {% if tt contains "culture" or tt contains "curation" or tt contains "art curation" %}
    {% assign cats = cats | append: "culture," %}
  {% endif %}

  {% if tt contains "trend" or tt contains "2025" or tt contains "technology" %}
    {% assign cats = cats | append: "trends," %}
  {% endif %}

  {% if tt contains "office" or tt contains "workplace" or tt contains "corporate" or tt contains "leasing" %}
    {% assign cats = cats | append: "office," %}
  {% endif %}
{% endfor %}

        {% assign tags_join = article.tags | join: "||" %}
<article class="ac-card"
  data-ac-item
  data-ac-cats="{{ cats | escape }}"
  data-ac-tags="{{ tags_join | escape }}">

          <a class="ac-card__link" href="{{ article.url }}">
            {% if article.image %}
              <div class="ac-card__media">
                <img
                  src="{{ article.image | image_url: width: 1400 }}"
                  alt="{{ article.image.alt | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}

            <div class="ac-card__body">
              <div class="ac-card__meta">
                <span class="ac-card__author">
                  {% if article.author != blank %}{{ article.author }}{% else %}{{ section.settings.fallback_author }}{% endif %}
                </span>
                <span class="ac-card__dot">•</span>
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%d.%m.%Y' }}
                </time>
              </div>

              <h2 class="ac-card__title">{{ article.title }}</h2>

              {% assign excerpt = article.excerpt_or_content | strip_html | strip %}
              {% if excerpt != blank %}
                <p class="ac-card__excerpt">{{ excerpt | truncate: 140 }}</p>
              {% endif %}

              {% if article.tags.size > 0 %}
                <div class="ac-card__tags">
                  {% for t in article.tags limit: 4 %}
                    <span class="ac-card__tag">{{ t }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div class="ac-blog__pager">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}

  </div>

  <style>
    /* ===== Blog shell (Light editorial) ===== */
    .ac-blog{ background:#ffffff !important; color:#0b0b0c !important; }
    .ac-blog *{ box-sizing:border-box !important; }
    .ac-blog__wrap{ max-width:1180px !important; margin:0 auto !important; padding:42px 22px 96px !important; }

    .ac-blog__kicker{ font-size:12px !important; letter-spacing:.18em !important; text-transform:uppercase !important; color:rgba(11,11,12,.62) !important; margin:0 0 14px !important; }
    .ac-blog__title{ font-size:clamp(32px, 4vw, 56px) !important; line-height:1.06 !important; letter-spacing:-0.02em !important; margin:0 0 12px !important; font-weight:800 !important; }
    .ac-blog__sub{ font-size:16px !important; line-height:1.6 !important; color:rgba(11,11,12,.72) !important; max-width:860px !important; margin:0 0 22px !important; }

    /* ===== Filters ===== */
    .ac-blog__filters{ display:flex !important; flex-wrap:wrap !important; gap:10px !important; padding:18px 0 24px !important; border-top:1px solid rgba(11,11,12,.10) !important; border-bottom:1px solid rgba(11,11,12,.10) !important; margin:22px 0 26px !important; }
    .ac-pill{
      border:1px solid rgba(11,11,12,.16) !important;
      background:#fff !important;
      color:#0b0b0c !important;
      padding:10px 12px !important;
      font-size:12px !important;
      letter-spacing:.12em !important;
      text-transform:uppercase !important;
      cursor:pointer !important;
      line-height:1 !important;
    }
    .ac-pill:hover{ background:rgba(11,11,12,.04) !important; }
    .ac-pill.is-active{ background:#0b0b0c !important; color:#fff !important; border-color:#0b0b0c !important; }

    /* ===== Grid ===== */
    .ac-blog__grid{
      display:grid !important;
      grid-template-columns:repeat(12, minmax(0, 1fr)) !important;
      gap:18px !important;
    }

    /* Card layout: 3-up desktop, 2-up tablet, 1-up mobile */
    .ac-card{
      grid-column:span 4 !important;
      border:1px solid rgba(11,11,12,.10) !important;
      background:#fff !important;
      overflow:hidden !important;
    }
    @media (max-width: 980px){ .ac-card{ grid-column:span 6 !important; } }
    @media (max-width: 640px){ .ac-card{ grid-column:span 12 !important; } }

    .ac-card__link{ display:block !important; color:inherit !important; text-decoration:none !important; }
    .ac-card__media{ width:100% !important; aspect-ratio: 16 / 10 !important; background:rgba(11,11,12,.04) !important; overflow:hidden !important; }
    .ac-card__media img{ width:100% !important; height:100% !important; object-fit:cover !important; display:block !important; }

    .ac-card__body{ padding:16px 16px 18px !important; }
    .ac-card__meta{ display:flex !important; gap:10px !important; align-items:center !important; flex-wrap:wrap !important; font-size:12px !important; color:rgba(11,11,12,.60) !important; margin:0 0 10px !important; }
    .ac-card__dot{ opacity:.6 !important; }

    .ac-card__title{ font-size:18px !important; line-height:1.25 !important; letter-spacing:-0.01em !important; margin:0 0 10px !important; font-weight:800 !important; }
    .ac-card__excerpt{ margin:0 0 12px !important; font-size:14px !important; line-height:1.65 !important; color:rgba(11,11,12,.75) !important; }

    .ac-card__tags{ display:flex !important; gap:8px !important; flex-wrap:wrap !important; margin:0 !important; }
    .ac-card__tag{
      font-size:11px !important;
      letter-spacing:.10em !important;
      text-transform:uppercase !important;
      color:rgba(11,11,12,.62) !important;
      border:1px solid rgba(11,11,12,.12) !important;
      padding:6px 8px !important;
      background:#fff !important;
    }

    /* Pagination */
    .ac-blog__pager{ margin-top:28px !important; }
  </style>

  <script>
(function(){
  const root = document.querySelector("[data-ac-blog]");
  if (!root) return;

  const filterBar = root.querySelector("[data-ac-filters]");
  const items = Array.from(root.querySelectorAll("[data-ac-item]"));
  if (!filterBar || !items.length) return;

  function setActive(btn){
    filterBar.querySelectorAll(".ac-pill").forEach(b => b.classList.remove("is-active"));
    btn.classList.add("is-active");
  }

  function match(item, cat){
    if (cat === "all") return true;
    const cats = (item.getAttribute("data-ac-cats") || "");
    return cats.split(",").map(s => (s||"").trim()).includes(cat);
  }

  filterBar.addEventListener("click", (e) => {
    const btn = e.target.closest(".ac-pill");
    if (!btn) return;

    const cat = btn.getAttribute("data-ac-cat") || "all";
    setActive(btn);

    items.forEach((it) => {
      it.style.display = match(it, cat) ? "" : "none";
    });
  });
})();

  </script>
</section>

{% schema %}
{
  "name": "Blog – Overview",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "ARTCLUB FILES" },
    { "type": "text", "id": "title", "label": "Title (optional)", "default": "." },
    { "type": "text", "id": "sub", "label": "Subline", "default": "Independent writing on contemporary art, collecting, and the Berlin ecosystem." },
    { "type": "text", "id": "fallback_author", "label": "Fallback author", "default": "ARTCLUB" }
  ],
  "presets": [
    { "name": "Blog – Editorial Overview + Tag Filters (ARTCLUB)" }
  ]
}
{% endschema %}
