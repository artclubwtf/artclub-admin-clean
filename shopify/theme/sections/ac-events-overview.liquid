{% comment %}
AC Events Overview — Apple-like (v1)
- Lists metaobject entries of type "events" (per your screenshot / URL: metaobjects/events)
- ARTCLUB cards -> link to metaobject page (single)
- ALÉA cards -> link directly to alea_url (ticket link)
Fields:
- alea_artclub, alea_url, beginn, ende, titel, beschreibung, kuenstler (@kuenstler refs), cover
{% endcomment %}

<section id="ac-events-{{ section.id }}" class="ac-events">
  <style>
    /* ===== Scoped, Apple-clean ===== */
    #ac-events-{{ section.id }}{background:#fff;color:#111;padding:34px 0 96px;}
    #ac-events-{{ section.id }} *{box-sizing:border-box;}
    #ac-events-{{ section.id }} a{color:inherit;text-decoration:none;}
    #ac-events-{{ section.id }} .ac-wrap{max-width:1100px;margin:0 auto;padding:0 18px;}

    #ac-events-{{ section.id }} .ac-head{display:flex;flex-direction:column;gap:10px;margin-bottom:18px;}
    #ac-events-{{ section.id }} .ac-kicker{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#6b6b70;}
    #ac-events-{{ section.id }} .ac-title{
      font-size:56px;line-height:1.02;margin:0;font-weight:850;letter-spacing:-.03em;
    }
    #ac-events-{{ section.id }} .ac-sub{margin:0;font-size:15px;line-height:1.6;color:#1c1c1f;opacity:.9;max-width:62ch;}
    @media(max-width:768px){
      #ac-events-{{ section.id }} .ac-title{font-size:36px;}
    }

    /* Controls */
    #ac-events-{{ section.id }} .ac-controls{
      display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
      margin:18px 0 18px;
    }
    #ac-events-{{ section.id }} .ac-seg{
      display:inline-flex;gap:6px;align-items:center;
      border:1px solid rgba(17,17,17,.12);
      border-radius:999px;padding:6px;background:rgba(17,17,17,.03);
    }
    #ac-events-{{ section.id }} .ac-seg button{
      border:0;background:transparent;color:#111;cursor:pointer;
      padding:8px 12px;border-radius:999px;
      font-size:12px;font-weight:850;letter-spacing:-.01em;
      opacity:.7;
    }
    #ac-events-{{ section.id }} .ac-seg button[aria-pressed="true"]{
      background:#fff;opacity:1;border:1px solid rgba(17,17,17,.12);
      box-shadow:0 8px 22px rgba(0,0,0,.06);
    }

    #ac-events-{{ section.id }} .ac-search{
      position:relative;flex:1;min-width:240px;max-width:420px;
    }
    #ac-events-{{ section.id }} .ac-search input{
      width:100% !important;height:42px !important;min-height:42px !important;
      border-radius:14px !important;border:1px solid rgba(17,17,17,.12) !important;
      padding:0 12px 0 38px !important;font-size:14px !important;outline:none !important;
      background:rgba(17,17,17,.03) !important;box-shadow:none !important;
      -webkit-appearance:none !important;appearance:none !important;
    }
    #ac-events-{{ section.id }} .ac-search input:focus{background:#fff !important;border-color:rgba(17,17,17,.35) !important;}
    #ac-events-{{ section.id }} .ac-search .ac-ico{
      position:absolute;left:12px;top:50%;transform:translateY(-50%);
      opacity:.55;font-size:14px;pointer-events:none;
    }

    /* Grid */
    #ac-events-{{ section.id }} .ac-grid{
      display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
      gap:14px;
    }
    @media(max-width:980px){ #ac-events-{{ section.id }} .ac-grid{grid-template-columns:repeat(2,minmax(0,1fr));} }
    @media(max-width:620px){ #ac-events-{{ section.id }} .ac-grid{grid-template-columns:minmax(0,1fr);} }

    /* Card */
    #ac-events-{{ section.id }} .ac-card{
      border-radius:22px;overflow:hidden;
      border:1px solid rgba(17,17,17,.10);
      background:rgba(17,17,17,.02);
      transition:transform .18s ease, background .18s ease, border-color .18s ease;
      display:flex;flex-direction:column;min-height:100%;
    }
    #ac-events-{{ section.id }} .ac-card:hover{
      transform:translateY(-2px);
      background:rgba(17,17,17,.03);
      border-color:rgba(17,17,17,.16);
    }

    #ac-events-{{ section.id }} .ac-media{
      background:#f5f5f7;
      aspect-ratio:16/10;
      overflow:hidden;
    }
    #ac-events-{{ section.id }} .ac-media img{width:100%;height:100%;object-fit:cover;display:block;}
    @media(max-width:620px){
      #ac-events-{{ section.id }} .ac-media{aspect-ratio:4/5;}
    }

    #ac-events-{{ section.id }} .ac-in{padding:14px 14px 16px;display:flex;flex-direction:column;gap:10px;flex:1;}
    #ac-events-{{ section.id }} .ac-toprow{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;}
    #ac-events-{{ section.id }} .ac-badge{
      display:inline-flex;align-items:center;gap:8px;
      border:1px solid rgba(17,17,17,.12);
      border-radius:999px;padding:7px 10px;background:rgba(255,255,255,.85);
      font-size:11px;font-weight:850;letter-spacing:.08em;text-transform:uppercase;
    }
    #ac-events-{{ section.id }} .ac-badge--alea{background:#111;color:#fff;border-color:#111;}
    #ac-events-{{ section.id }} .ac-badge--free{background:rgba(17,17,17,.06);}

    #ac-events-{{ section.id }} .ac-h{
      margin:0;font-size:18px;line-height:1.15;font-weight:900;letter-spacing:-.015em;
    }
    #ac-events-{{ section.id }} .ac-meta{
      display:flex;flex-wrap:wrap;gap:8px;margin-top:2px;
      color:#6b6b70;font-size:12px;line-height:1.3;
    }
    #ac-events-{{ section.id }} .ac-dot{opacity:.5}
    #ac-events-{{ section.id }} .ac-ex{
      margin:0;color:#1c1c1f;opacity:.9;font-size:13px;line-height:1.55;
    }
    #ac-events-{{ section.id }} .ac-art{
      margin-top:auto;font-size:12px;color:#6b6b70;line-height:1.35;
      border-top:1px solid rgba(17,17,17,.08);padding-top:10px;
    }

    #ac-events-{{ section.id }} .ac-empty{
      padding:18px 0;color:#6b6b70;font-size:13px;
    }
  </style>

  {%- assign events = shop.metaobjects.events.values -%}
  {%- assign is_de = false -%}
  {%- if request.locale.iso_code contains 'de' -%}{%- assign is_de = true -%}{%- endif -%}

  <div class="ac-wrap" data-ac-events-root>
    <div class="ac-head">
      <div class="ac-kicker">{{ section.settings.kicker }}</div>
      <h1 class="ac-title">{{ section.settings.title }}</h1>
      {% if section.settings.subtitle != blank %}
        <p class="ac-sub">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="ac-controls">
      <div class="ac-seg" role="group" aria-label="Event filter">
        <button type="button" data-ac-filter="all" aria-pressed="true">{{ section.settings.filter_all }}</button>
        <button type="button" data-ac-filter="artclub" aria-pressed="false">{{ section.settings.filter_artclub }}</button>
        <button type="button" data-ac-filter="alea" aria-pressed="false">{{ section.settings.filter_alea }}</button>
      </div>

      {% if section.settings.show_search %}
        <div class="ac-search">
          <span class="ac-ico">⌕</span>
          <input type="search" placeholder="{{ section.settings.search_placeholder }}" autocomplete="off" data-ac-search>
        </div>
      {% endif %}
    </div>

    {% if events == blank or events.size == 0 %}
      <div class="ac-empty">{{ section.settings.empty_text }}</div>
    {% else %}
      <div class="ac-grid" data-ac-grid>
        {% for e in events %}
          {%- assign kind = e.alea_artclub.value | default: 'artclub' | downcase | strip -%}
          {%- assign is_alea = false -%}
          {%- if kind contains 'alea' -%}{%- assign is_alea = true -%}{%- endif -%}

          {%- assign title = e.titel.value | default: e.system.title | default: e.system.handle | default: 'Event' -%}
          {%- assign starts_at = e.beginn.value -%}
          {%- assign ends_at = e.ende.value -%}
          {%- assign cover = e.cover.value -%}

          {%- assign alea_url = e.alea_url.value | default: '' -%}
          {%- assign page_url = e.system.url | default: '' -%}

          {%- assign href = page_url -%}
          {%- if is_alea and alea_url != blank -%}{%- assign href = alea_url -%}{%- endif -%}

          {%- assign desc = e.beschreibung.value | default: '' -%}
          {%- assign desc_clean = desc | strip_html | strip -%}

          {%- assign artists = e.kuenstler.value -%}
          {%- capture artists_line -%}
            {%- if artists != blank -%}
              {%- for a in artists limit: 3 -%}
                {%- assign a_name = a.name | default: a.system.title | default: a.system.handle -%}
                {{ a_name }}{% unless forloop.last %}, {% endunless %}
              {%- endfor -%}
              {%- if artists.size > 3 -%}…{%- endif -%}
            {%- endif -%}
          {%- endcapture -%}

          {%- capture blob -%}
            {{ title }} {{ desc_clean }} {{ artists_line }}
          {%- endcapture -%}

          <a
            class="ac-card"
            href="{{ href }}"
            data-kind="{% if is_alea %}alea{% else %}artclub{% endif %}"
            data-start-ts="{% if starts_at != blank %}{{ starts_at | date: '%s' }}{% else %}0{% endif %}"
            data-blob="{{ blob | strip | escape }}"
          >
            <div class="ac-media">
              {% if cover != blank %}
                {{ cover | image_url: width: 1800 | image_tag: loading: 'lazy', alt: title }}
              {% else %}
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#6b6b70;font-size:12px;">
                  No cover
                </div>
              {% endif %}
            </div>

            <div class="ac-in">
              <div class="ac-toprow">
                {% if is_alea %}
                  <span class="ac-badge ac-badge--alea">ALÉA</span>
                {% else %}
                  <span class="ac-badge">ARTCLUB</span>
                {% endif %}

                {% if is_alea %}
                  <span class="ac-badge ac-badge--alea">Tickets</span>
                {% else %}
                  <span class="ac-badge ac-badge--free">Free RSVP</span>
                {% endif %}
              </div>

              <div>
                <p class="ac-h">{{ title }}</p>

                <div class="ac-meta">
                  {% if starts_at != blank %}
                    <span>
                      {% if is_de %}
                        {{ starts_at | date: "%d.%m.%Y" }} · {{ starts_at | date: "%H:%M" }}
                      {% else %}
                        {{ starts_at | date: "%b %d, %Y" }} · {{ starts_at | date: "%H:%M" }}
                      {% endif %}
                    </span>
                  {% endif %}
                  {% if ends_at != blank %}
                    <span class="ac-dot">•</span>
                    <span>
                      {% if is_de %}
                        {{ ends_at | date: "%H:%M" }}
                      {% else %}
                        {{ ends_at | date: "%H:%M" }}
                      {% endif %}
                    </span>
                  {% endif %}
                </div>
              </div>

              {% if desc_clean != blank %}
                <p class="ac-ex">{{ desc_clean | truncate: 140 }}</p>
              {% endif %}

              {% if artists != blank %}
                <div class="ac-art">
                  <strong style="color:#111;font-weight:850;">{% if is_de %}Künstler:innen{% else %}Artists{% endif %}:</strong>
                  {{ artists_line | strip }}
                </div>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>

      <div class="ac-empty" data-ac-empty style="display:none;">{{ section.settings.empty_search_text }}</div>
    {% endif %}
  </div>

  <script>
    (function(){
      var root = document.querySelector('#ac-events-{{ section.id }} [data-ac-events-root]');
      if(!root) return;

      var grid = root.querySelector('[data-ac-grid]');
      var empty = root.querySelector('[data-ac-empty]');
      var cards = grid ? Array.prototype.slice.call(grid.querySelectorAll('.ac-card')) : [];
      if(!grid || !cards.length) return;

      // Sort by start timestamp asc (upcoming first; unknowns at end)
      cards.sort(function(a,b){
        var ta = parseInt(a.getAttribute('data-start-ts') || '0', 10);
        var tb = parseInt(b.getAttribute('data-start-ts') || '0', 10);
        if(ta === 0 && tb === 0) return 0;
        if(ta === 0) return 1;
        if(tb === 0) return -1;
        return ta - tb;
      });
      cards.forEach(function(c){ grid.appendChild(c); });

      // Filter + search
      var filter = 'all';
      var q = '';

      function apply(){
        var shown = 0;
        cards.forEach(function(c){
          var kind = c.getAttribute('data-kind') || 'artclub';
          var blob = (c.getAttribute('data-blob') || '').toLowerCase();

          var okKind = (filter === 'all') || (kind === filter);
          var okQ = (!q) || (blob.indexOf(q) !== -1);

          var ok = okKind && okQ;
          c.style.display = ok ? '' : 'none';
          if(ok) shown++;
        });
        if(empty) empty.style.display = shown ? 'none' : '';
      }

      // Segmented buttons
      root.querySelectorAll('[data-ac-filter]').forEach(function(btn){
        btn.addEventListener('click', function(){
          filter = btn.getAttribute('data-ac-filter') || 'all';
          root.querySelectorAll('[data-ac-filter]').forEach(function(b){
            b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
          });
          apply();
        });
      });

      // Search
      var input = root.querySelector('[data-ac-search]');
      if(input){
        var t = null;
        input.addEventListener('input', function(){
          var v = (input.value || '').trim().toLowerCase();
          if(t) clearTimeout(t);
          t = setTimeout(function(){ q = v; apply(); }, 120);
        });
      }

      apply();
    })();
  </script>
</section>

{% schema %}
{
  "name": "AC Events Overview",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "ARTCLUB" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Events" },
    { "type": "textarea", "id": "subtitle", "label": "Untertitel", "default": "ALÉA nights and ARTCLUB community events — curated, clean, Berlin-first." },

    { "type": "checkbox", "id": "show_search", "label": "Suche anzeigen", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search by title, artist, keyword…" },

    { "type": "text", "id": "filter_all", "label": "Filter: All", "default": "All" },
    { "type": "text", "id": "filter_artclub", "label": "Filter: ARTCLUB", "default": "ARTCLUB" },
    { "type": "text", "id": "filter_alea", "label": "Filter: ALÉA", "default": "ALÉA" },

    { "type": "text", "id": "empty_text", "label": "Empty state (no events)", "default": "No events published yet." },
    { "type": "text", "id": "empty_search_text", "label": "Empty state (search)", "default": "No events match your search." }
  ],
  "presets": [
    { "name": "AC Events Overview (Apple)", "category": "ARTCLUB" }
  ]
}
{% endschema %}
