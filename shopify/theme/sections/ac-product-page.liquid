{% comment %}
  AC Product Artwork — Figma PDP (final + TEXT FIX)
  Fixes:
  - description no longer collapses into a super-narrow column (overrides theme max-width on p)
  - unwraps hard line-breaks in plain-text metafield (keeps paragraphs via double line breaks)
  - product.description (HTML) stays HTML and gets clean paragraph spacing
{% endcomment %}

<section
  id="ac-pdp-figma-{{ section.id }}"
  class="ac-pdp-figma"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
>
  <style>
    {% render 'ac-pdp-figma-base-styles', section_id: section.id, avatar_font_weight: 600 %}

    /* ===== Figma Stage ===== */
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__hero{
      --ac-gap:26px; --ac-stage-w:860px; --ac-stage-h:clamp(520px, 72vh, 760px);
      display:grid !important;
      grid-template-columns:minmax(0,1fr) minmax(0,var(--ac-stage-w)) minmax(0,1fr) !important;
      gap:var(--ac-gap) !important;
      align-items:stretch !important;
      margin-top:10px !important;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__rail{
      background:#efeff2 !important;
      height:var(--ac-stage-h) !important;
      min-height:var(--ac-stage-h) !important;
      border-radius:0 !important;
      display:flex !important;
      align-items:flex-end !important;
      justify-content:flex-end !important;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__rail--left{ grid-column:1 !important; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__media{ grid-column:2 !important; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__rail--right{ grid-column:3 !important; }

    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__media{
      height:var(--ac-stage-h) !important;
      min-height:var(--ac-stage-h) !important;
      background:#fff !important;
      border:none !important;
      overflow:hidden !important;
      cursor:zoom-in !important;
      display:flex !important;
      align-items:center !important;
      justify-content:center !important;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__media img{
      height:100% !important;
      width:auto !important;
      max-height:100% !important;
      max-width:100% !important;
      object-fit:contain !important;
      display:block !important;
    }

    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__zoomHint{
      margin:16px !important;
      font-size:12px !important;
      padding:8px 12px !important;
      border-radius:999px !important;
      background:rgba(255,255,255,0.92) !important;
      border:1px solid rgba(0,0,0,0.08) !important;
      color:#0b0b0c !important;
      opacity:.92 !important;
      backdrop-filter:blur(8px) !important;
      -webkit-backdrop-filter:blur(8px) !important;
      cursor:pointer !important;
    }

    /* ===== Below text aligned to center stage ===== */
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__below{
      display:grid !important;
      grid-template-columns:minmax(0,1fr) minmax(0,860px) minmax(0,1fr) !important;
      gap:26px !important;
      margin-top:22px !important;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__body{ margin:0; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__desc{
      font-size:16px !important;
      line-height:1.65 !important;
      color:#141417 !important;
      opacity:.92 !important;

      /* CRITICAL: defeat theme "narrow text" rules */
      width:100% !important;
      max-width:none !important;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__desc *{
      max-width:none !important;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__desc p{
      margin:0 0 16px !important;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__desc p:last-child{
      margin-bottom:0 !important;
    }

    /* ===== Zoom overlay ===== */
    #ac-pdp-figma-{{ section.id }} .ac-pdp-zoom{
      position:fixed; inset:0; background:rgba(0,0,0,0.9);
      display:none; align-items:center; justify-content:center; z-index:9999; padding:20px;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-zoom.is-active{ display:flex; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-zoom__img{ max-width:95vw; max-height:95vh; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-zoom__img img{ display:block; max-width:100%; max-height:95vh; object-fit:contain; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-zoom__close{
      position:fixed; top:18px; right:22px; width:44px; height:44px; border-radius:999px;
      border:1px solid rgba(255,255,255,0.18); background:rgba(0,0,0,0.25); color:#fff; font-size:20px;
      display:flex; align-items:center; justify-content:center; cursor:pointer;
    }

    /* ===== Buy popup ===== */
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy{
      position:fixed; inset:0; background:rgba(0,0,0,0.46);
      display:none; align-items:center; justify-content:center; z-index:9998; padding:20px;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy.is-active{ display:flex; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy__panel{
      width:100%; max-width:520px; background:#fff; border-radius:18px;
      padding:22px 22px 18px; max-height:90vh; overflow:auto; border:1px solid rgba(0,0,0,0.08);
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy__head{
      display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:10px;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy__title{ margin:0; font-size:16px; font-weight:650; color:#0b0b0c; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy__close{
      width:36px; height:36px; border-radius:999px; border:1px solid rgba(0,0,0,0.10); background:#fff; cursor:pointer;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy__subtitle{ margin:0 0 10px; font-size:12px; color:#6b6b70; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy__price{ margin:0 0 14px; font-size:16px; font-weight:650; color:#0b0b0c; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy select{
      width:100%; border-radius:12px; border:1px solid rgba(0,0,0,0.10); padding:10px 12px; font-size:14px; background:#fff;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy__add{
      margin-top:14px; width:100%; height:44px; border-radius:999px; border:none; background:#0b0b0c;
      color:#fff; font-size:14px; font-weight:650; cursor:pointer;
      transition:transform .16s ease, box-shadow .16s ease, background .16s ease;
    }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy__add:hover{ transform:translateY(-1px); box-shadow:0 12px 28px rgba(0,0,0,0.14); background:#000; }
    #ac-pdp-figma-{{ section.id }} .ac-pdp-buy__note{ margin:10px 0 0; font-size:12px; color:#6b6b70; }

    /* ===== Mobile ===== */
    @media (max-width:920px){
      #ac-pdp-figma-{{ section.id }}.ac-pdp-figma{ padding:40px 0 70px; }
      #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__top{ flex-direction:column; gap:14px; }
      #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__actions{ margin-top:0; }

      #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__hero{
        grid-template-columns:1fr !important;
        --ac-stage-w:100%;
        --ac-stage-h:clamp(420px, 66vh, 560px);
        gap:14px !important;
      }
      #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__rail{ display:none !important; }
      #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__media{ grid-column:1 !important; }

      #ac-pdp-figma-{{ section.id }} .ac-pdp-figma__below{ grid-template-columns:1fr !important; gap:0 !important; }
    }
  </style>

  <div class="ac-pdp-figma__wrap">
    {%- assign back_url = section.settings.back_url -%}
    {%- if back_url == blank and collection -%}{%- assign back_url = collection.url -%}{%- endif -%}
    {%- if back_url == blank -%}{%- assign back_url = '/collections/all' -%}{%- endif -%}

    <div class="ac-pdp-figma__top">
      <div>
        {% if section.settings.show_back %}
          <a class="ac-pdp-figma__back" href="{{ back_url }}"><span aria-hidden="true">←</span>{{ section.settings.back_label }}</a>
        {% endif %}

        <h1 class="ac-pdp-figma__title">{{ product.title }}</h1>

        {%- assign artist_name = product.metafields.custom.kuenstler_text | default: product.vendor -%}
        {%- assign artist_avatar = product.metafields.custom.kuenstler_avatar -%}
        <div class="ac-pdp-figma__artistRow">
          <div class="ac-pdp-figma__avatar" aria-hidden="true">
            {% if artist_avatar != blank %}
              {{ artist_avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: artist_name }}
            {% else %}
              <div class="ac-pdp-figma__avatarFallback">{{ artist_name | slice: 0, 1 | upcase }}</div>
            {% endif %}
          </div>
          {% if artist_name != blank %}<div class="ac-pdp-figma__artistName">{{ artist_name }}</div>{% endif %}
        </div>
      </div>

      <div class="ac-pdp-figma__actions">
        <button type="button" class="ac-pdp-figma__iconBtn" aria-label="{{ section.settings.wishlist_label }}" aria-pressed="false" data-ac-wishlist-toggle>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 20.5s-7-4.3-9.4-8.2C.6 8.7 2.6 5.5 6 5.5c1.9 0 3.3 1 4 2.1.7-1.1 2.1-2.1 4-2.1 3.4 0 5.4 3.2 3.4 6.8C19 16.2 12 20.5 12 20.5z" stroke="#0b0b0c" stroke-width="1.6" fill="transparent" />
          </svg>
        </button>

        <button type="button" data-artp-open="artp-modal-{{ section.id }}" class="ac-pdp-figma__pillBtn" data-ac-buy-trigger>{{ section.settings.buy_label }}</button>
  

  {%- assign art_default_img = product.featured_media | default: product.media.first -%}
  {%- assign art_default_src = art_default_img | image_url: width: 1600 -%}
  <div class="artp-modal" id="artp-modal-{{ section.id }}" aria-hidden="true">


    <div class="artp-modal__backdrop" data-artp-close></div>

    <div
      class="artp-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-label="{{ product.title | escape }}"
      tabindex="-1"
    >
      <button type="button" class="artp-modal__close" data-artp-close aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      <div class="artp__grid" data-artp data-section-id="{{ section.id }}">
        <!-- LEFT: Room previews -->
        <div class="artp__left">
          {% if section.blocks.size > 0 %}
            <div class="artp-room">
              {% for b in section.blocks %}
                {% if b.type == 'room' and b.settings.image != blank %}
                  <figure
                    class="artp-room__item{% if forloop.first %} is-active{% endif %}"
                    data-room-idx="{{ forloop.index0 }}"
                    style="--zl:{{ b.settings.zone_left }}%;--zt:{{ b.settings.zone_top }}%;--zw:{{ b.settings.zone_width }}%;--zh:{{ b.settings.zone_height }}%;"
                    data-zone-realw="{{ b.settings.zone_realw_cm }}"
                    data-shadow-deg="{{ b.settings.shadow_deg | times: 10 }}"
                    data-shadow-dist="{{ b.settings.shadow_dist_cm }}"
                    data-shadow-blur="{{ b.settings.shadow_blur_cm }}"
                    data-shadow-op="{{ b.settings.shadow_opacity | divided_by: 100.0 }}"
                    data-zone-visible="{{ b.settings.show_zone | default: true }}"
                    data-art-border="{{ b.settings.art_border }}"
                    data-art-border-color="{{ b.settings.art_border_color }}"
                  >
                    {{
                      b.settings.image
                      | image_url: width: 2200
                      | image_tag: loading: 'lazy', class: 'artp-room__bg', alt: product.title
                    }}

                    <div class="artp-wallzone" aria-hidden="true">
                      <span class="artp-wallzone__label">Wandbereich</span>
                    </div>

                    {% if art_default_src %}
                      <img data-art-img src="{{ art_default_src }}" alt="{{ product.title | escape }}" class="artp-art">
                      <!-- Visual Overlays -->
                      <div class="artp-frame" data-frame hidden></div>
                      <div class="artp-acryl" data-acryl hidden></div>
                    {% endif %}
                  </figure>
                {% endif %}
              {% endfor %}
            </div>
            <!-- Zoom Pane -->

            {% if section.blocks.size > 1 %}
              <div class="artp-room__thumbs">
                {% for b in section.blocks %}
                  {% if b.type == 'room' and b.settings.image != blank %}
                    <button
                      class="artp-room__thumb{% if forloop.first %} is-active{% endif %}"
                      data-room-go="{{ forloop.index0 }}"
                    >
                      {{ b.settings.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: product.title }}
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          {% else %}
            <div class="artp-gallery">
              {% for media in product.media %}
                <figure class="artp-gallery__item">{{ media | media_tag }}</figure>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <!-- RIGHT: Slim info panel -->
        <!-- Stepper (Option A) -->
        <!-- RIGHT: Apple-like Configurator -->
<div class="artp-config" data-ac-config>
    <button type="button" class="artp-config__close" data-artp-close>
  ← Zurück
</button>
  <div class="artp-config__group" data-group="model">
    <div class="artp-config__head">
      <div class="artp-config__kicker">Ausführung</div>
      <div class="artp-config__title">Was passt zu dir?</div>
    </div>
    <div class="artp-choicegrid" data-model-choices></div>
  </div>

  <div class="artp-config__group" data-group="finish" hidden>
    <div class="artp-config__head">
      <div class="artp-config__kicker">Finish</div>
      <div class="artp-config__title">Rahmen / Oberfläche</div>
    </div>
    <div class="artp-choicegrid" data-finish-choices></div>
  </div>

  <div class="artp-config__group" data-group="size" hidden>
    <div class="artp-config__head">
      <div class="artp-config__kicker">Größe</div>
      <div class="artp-config__title">Welche Size?</div>
    </div>
    <div class="artp-choicegrid" data-size-choices></div>
  </div>

</div>

<!-- Sticky Add-to-cart bar (Apple style) -->
<div class="artp-stickybar" data-stickybar>
  <div class="artp-stickybar__meta">
    <div class="artp-stickybar__title">{{ product.title }}</div>
    <div class="artp-stickybar__sub" data-selection-summary>Bitte auswählen</div>
  </div>

  <!-- keep internal inputs for your preview logic -->
  <input type="hidden" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id-input-original>
  <input type="hidden" value="" data-variant-id-input-edition>

  <form method="post" action="/cart/add" class="artp-stickybar__form" data-atc-form>
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-atc-variant>
    <button class="artp-atc" type="submit" disabled data-atc-btn>
      <span>Add to Cart</span>
      <span class="artp-atc__price" data-atc-price></span>
    </button>
  </form>
</div>

      </div>
    </div>
  </div>
      </div>
    </div>

    <div class="ac-pdp-figma__hero">
      <div class="ac-pdp-figma__rail ac-pdp-figma__rail--left" aria-hidden="true"></div>

      <div class="ac-pdp-figma__media" data-ac-zoom-trigger>
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 2400 | image_tag: loading: 'lazy', alt: product.title }}
        {% endif %}
      </div>

      <div class="ac-pdp-figma__rail ac-pdp-figma__rail--right" aria-hidden="true">
        <button type="button" class="ac-pdp-figma__zoomHint" data-ac-zoom-trigger>{{ section.settings.zoom_hint }}</button>
      </div>
    </div>

    {%- comment -%} ===== TEXT: prefer plain-text metafield, else use HTML description ===== {%- endcomment -%}
    {%- assign werk_text_mf = product.metafields.custom.werk_text -%}
    {%- assign desc_html = product.description -%}

    {% if werk_text_mf != blank or desc_html != blank %}
      <div class="ac-pdp-figma__below">
        <div aria-hidden="true"></div>
        <div class="ac-pdp-figma__body">
          <div class="ac-pdp-figma__desc">
            {% if werk_text_mf != blank %}
              {%- assign t = werk_text_mf | replace: '\r\n', '\n' -%}
              {%- assign t = t | replace: '\n\n', '[[P]]' -%}
              {%- assign t = t | replace: '\n', ' ' -%}
              {%- assign t = t | replace: '[[P]]', '</p><p>' -%}
              <p>{{ t }}</p>
            {% else %}
              {{ desc_html }}
            {% endif %}
          </div>
        </div>
        <div aria-hidden="true"></div>
      </div>
    {% endif %}
  </div>

  {% comment %} Zoom Overlay {% endcomment %}
  <div class="ac-pdp-zoom" data-ac-zoom>
    <button type="button" class="ac-pdp-zoom__close" data-ac-zoom-close aria-label="Close">×</button>
    <div class="ac-pdp-zoom__img">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 2800 | image_tag: alt: product.title }}
      {% endif %}
    </div>
  </div>

  {% comment %} Buy Options Popup {% endcomment %}
  <div class="ac-pdp-buy" data-ac-buy>
    <div class="ac-pdp-buy__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.buy_label }}">
      <div class="ac-pdp-buy__head">
        <h2 class="ac-pdp-buy__title">{{ product.title }}</h2>
        <button type="button" class="ac-pdp-buy__close" data-ac-buy-close aria-label="Close">×</button>
      </div>

      <p class="ac-pdp-buy__subtitle">{{ section.settings.buy_subtitle }}</p>

      {% assign current_variant = product.selected_or_first_available_variant %}
      <p class="ac-pdp-buy__price" data-ac-buy-price>{{ current_variant.price | money_with_currency }}</p>

      {% assign buy_form_id = 'ac-buy-form-' | append: section.id %}
      {% form 'product', product, id: buy_form_id %}
        {% if product.has_only_default_variant == false %}
          <select name="id" data-ac-variant-select>
            {% for variant in product.variants %}
              {% if variant.available %}
                <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %}>{{ variant.title }} – {{ variant.price | money_with_currency }}</option>
              {% else %}
                <option disabled>{{ variant.title }} – {{ 'products.product.sold_out' | t }}</option>
              {% endif %}
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% endif %}

        <button type="submit" class="ac-pdp-buy__add" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
        </button>

        <p class="ac-pdp-buy__note">{{ section.settings.buy_popup_note }}</p>
      {% endform %}
    </div>
  </div>

  <script>
    (function(){
      var root = document.getElementById('ac-pdp-figma-{{ section.id }}');
      if(!root) return;

      var productId = String(root.getAttribute('data-product-id') || '');

      /* ---------- Wishlist (localStorage) ---------- */
      var WISHLIST_KEY = 'ac_wishlist';
      var wishBtn = root.querySelector('[data-ac-wishlist-toggle]');

      function safeParse(json){ try{ return JSON.parse(json); }catch(e){ return null; } }
      function getWishlist(){
        var raw = localStorage.getItem(WISHLIST_KEY);
        var parsed = safeParse(raw);
        if(Array.isArray(parsed)) return parsed.map(String);
        return [];
      }
      function setWishlist(arr){
        localStorage.setItem(WISHLIST_KEY, JSON.stringify(arr));
        window.dispatchEvent(new CustomEvent('ac:wishlist:changed', { detail: { ids: arr } }));
      }
      function isWishlisted(){ return getWishlist().indexOf(productId) !== -1; }
      function renderWishlist(){
        if(!wishBtn) return;
        var active = isWishlisted();
        wishBtn.classList.toggle('is-active', active);
        wishBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
      }
      function toggleWishlist(){
        var list = getWishlist();
        var idx = list.indexOf(productId);
        if(idx >= 0) list.splice(idx, 1);
        else list.push(productId);
        setWishlist(list);
        renderWishlist();
      }
      if(wishBtn) wishBtn.addEventListener('click', toggleWishlist);
      window.addEventListener('storage', function(e){ if(e.key === WISHLIST_KEY) renderWishlist(); });
      window.addEventListener('ac:wishlist:changed', renderWishlist);
      renderWishlist();

      /* ---------- Zoom ---------- */
      var zoomOverlay = root.querySelector('[data-ac-zoom]');
      var zoomClose = root.querySelector('[data-ac-zoom-close]');

      function openZoom(){
        if(!zoomOverlay) return;
        zoomOverlay.classList.add('is-active');
        document.documentElement.style.overflow = 'hidden';
      }
      function closeZoom(){
        if(!zoomOverlay) return;
        zoomOverlay.classList.remove('is-active');
        document.documentElement.style.overflow = '';
      }

      var zoomTriggers = root.querySelectorAll('[data-ac-zoom-trigger]');
      if(zoomTriggers && zoomTriggers.length){
        zoomTriggers.forEach(function(el){ el.addEventListener('click', openZoom); });
      }
      if(zoomClose) zoomClose.addEventListener('click', closeZoom);
      if(zoomOverlay) zoomOverlay.addEventListener('click', function(e){ if(e.target === zoomOverlay) closeZoom(); });

      /* ---------- Buy popup ---------- */
      var buyTrigger = root.querySelector('[data-ac-buy-trigger]');
      var buyOverlay = root.querySelector('[data-ac-buy]');
      var buyClose = root.querySelector('[data-ac-buy-close]');

      function openBuy(){
        if(!buyOverlay) return;
        buyOverlay.classList.add('is-active');
        document.documentElement.style.overflow = 'hidden';
      }
      function closeBuy(){
        if(!buyOverlay) return;
        buyOverlay.classList.remove('is-active');
        document.documentElement.style.overflow = '';
      }

      if(buyTrigger) buyTrigger.addEventListener('click', openBuy);
      if(buyClose) buyClose.addEventListener('click', closeBuy);
      if(buyOverlay) buyOverlay.addEventListener('click', function(e){ if(e.target === buyOverlay) closeBuy(); });

      /* ---------- ESC close ---------- */
      document.addEventListener('keydown', function(e){
        if(e.key !== 'Escape') return;
        if(zoomOverlay && zoomOverlay.classList.contains('is-active')) closeZoom();
        if(buyOverlay && buyOverlay.classList.contains('is-active')) closeBuy();
      });

      /* ---------- Variant price update ---------- */
      var variantSelect = root.querySelector('[data-ac-variant-select]');
      var priceEl = root.querySelector('[data-ac-buy-price]');
      var moneyFormat = {{ shop.money_format | json }};
      var variants = {{ product.variants | json }};

      function formatMoney(cents){
        if(window.Shopify && typeof window.Shopify.formatMoney === 'function'){
          return window.Shopify.formatMoney(cents, moneyFormat);
        }
        return (cents/100).toFixed(2);
      }

      if(variantSelect && priceEl && Array.isArray(variants)){
        variantSelect.addEventListener('change', function(){
          var id = String(variantSelect.value || '');
          var v = variants.find(function(x){ return String(x.id) === id; });
          if(v && typeof v.price === 'number'){ priceEl.textContent = formatMoney(v.price); }
        });
      }
    })();
  </script>
</section>

