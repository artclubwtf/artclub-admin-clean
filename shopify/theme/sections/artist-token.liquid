{% if customer and customer.metafields.custom.role.value == "artist" and customer.metafields.custom.artist_token.value != blank %}
  <style>
    .token-box {
      background: #f8f8f8;
      padding: 1.5rem;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
      max-width: 600px;
      margin: 2rem auto;
      font-family: sans-serif;
    }

    .token-box h2 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .token-display {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: white;
      border: 1px solid #ddd;
      border-radius: 6px;
      padding: 0.75rem 1rem;
      font-family: monospace;
      font-size: 0.95rem;
      word-break: break-all;
    }

    .copy-btn {
      background: #000;
      color: #fff;
      border: none;
      padding: 0.4rem 0.8rem;
      border-radius: 4px;
      cursor: pointer;
      margin-left: 1rem;
      transition: background 0.2s;
    }

    .copy-btn:hover {
      background: #333;
    }

    .copy-confirm {
      color: green;
      font-size: 0.85rem;
      margin-top: 0.5rem;
    }
  </style>

  <div class="token-box">
    <h2>🎟️ Dein Künstler-Token</h2>
    <div class="token-display">
      <span id="artistToken">{{ customer.metafields.custom.artist_token.value }}</span>
      <button class="copy-btn" onclick="copyToken()">Kopieren</button>
    </div>
    <div id="copyMessage" class="copy-confirm" style="display:none;">Token wurde kopiert ✅</div>
  </div>

  <script>
    function copyToken() {
      const tokenText = document.getElementById("artistToken").innerText;
      navigator.clipboard.writeText(tokenText).then(function() {
        document.getElementById("copyMessage").style.display = "block";
        setTimeout(() => {
          document.getElementById("copyMessage").style.display = "none";
        }, 3000);
      });
    }
  </script>
{% endif %}

{% schema %}
  {
    "name": "Artist Token",
    "settings": []
  }
{% endschema %}