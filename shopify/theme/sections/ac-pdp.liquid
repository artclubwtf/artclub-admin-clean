        { "type": "range",  "id": "zone_top",    "label": "Obere Kante (%)",  "min": 0,  "max": 100, "step": 1, "default": 10 },
        { "type": "range",  "id": "zone_width",  "label": "Breite (%)",       "min": 5,  "max": 100, "step": 1, "default": 60 },
        { "type": "range",  "id": "zone_height", "label": "Höhe (%)",         "min": 5,  "max": 100, "step": 1, "default": 75 },

        { "type": "header", "content": "Reale Wandbreite" },
        { "type": "number", "id": "zone_realw_cm", "label": "Wandbreite (cm)", "default": 300 },

        { "type": "header", "content": "Rahmen & Darstellung" },
        { "type": "range",  "id": "art_border",       "label": "Rahmenbreite (px)", "min": 0, "max": 20, "step": 1, "default": 0 },
        { "type": "color",  "id": "art_border_color", "label": "Rahmenfarbe",        "default": "#ffffff" },

        { "type": "header", "content": "Schatten" },
        { "type": "range",  "id": "shadow_deg",      "label": "Richtung (0–36 = 0°–360°)", "min": 0,  "max": 36,  "step": 0.5, "default": 13 },
        { "type": "range",  "id": "shadow_dist_cm",  "label": "Distanz (cm)",              "min": 0,  "max": 10,  "step": 0.5, "default": 1.5 },
        { "type": "range",  "id": "shadow_blur_cm",  "label": "Weichzeichnung (cm)",       "min": 0,  "max": 10,  "step": 0.5, "default": 2.5 },
        { "type": "range",  "id": "shadow_opacity",  "label": "Deckkraft (%)",             "min": 0,  "max": 100, "step": 5,   "default": 35 }
      ]
    }
  ],
  "presets": [
    { "name": "AC Product Artwork (Inline)", "category": "ARTCLUB" }
  ]
}
