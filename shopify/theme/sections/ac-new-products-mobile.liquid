{% comment %}
  AC New Products — MOBILE PDP (separate section)
  - Mobile-first Apple-like PDP
  - Includes the SAME Room Preview Rendering (wallzone + realistic scaling)
  - Configurator: Model -> Finish -> Size (cards), mobile-optimized
  - Sticky Add-to-cart fixed bottom (fullscreen modal)
  - Wishlist (localStorage ac_wishlist)
  - Zoom overlay for product hero
  - Variant schemas supported:
    A) option1=Finish, option2=Size
    B) option1=Model (Print/Edition), option2=Finish, option3=Size
{% endcomment %}

<section
  id="ac-pdp-mobile-{{ section.id }}"
  class="ac-pdp-mobile"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
>
  <style>
    /* ===== Visibility (separate sections approach) ===== */
    #ac-pdp-mobile-{{ section.id }}{ display:block; }
    @media (min-width: 921px){
      #ac-pdp-mobile-{{ section.id }}{ display:none !important; }
    }

    /* ===== Mobile PDP Base ===== */
    #ac-pdp-mobile-{{ section.id }}.ac-pdp-mobile{
      background:#fff;
      padding:18px 0 54px;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__wrap{
      max-width:720px;
      margin:0 auto;
      padding:0 16px;
    }

    /* Top */
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:14px;
      margin-bottom:12px;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__back{
      display:inline-flex;
      gap:8px;
      align-items:center;
      text-decoration:none;
      font-size:13px;
      color:#0b0b0c;
      opacity:.65;
      transition:opacity .16s ease;
      padding:8px 0;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__back:hover{ opacity:.95; }

    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__actions{
      display:flex;
      align-items:center;
      gap:10px;
      flex:0 0 auto;
      padding-top:4px;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__iconBtn{
      width:42px; height:42px; border-radius:999px;
      border:1px solid rgba(0,0,0,0.10); background:#fff;
      display:flex; align-items:center; justify-content:center;
      cursor:pointer;
      transition:transform .16s ease, border-color .16s ease, box-shadow .16s ease;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__iconBtn:hover{
      transform:translateY(-1px);
      border-color:rgba(0,0,0,0.16);
      box-shadow:0 10px 24px rgba(0,0,0,0.08);
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__iconBtn svg{ width:18px; height:18px; display:block; }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__iconBtn.is-active svg path{ fill:#0b0b0c; stroke:#0b0b0c; }

    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__pillBtn{
      height:42px;
      padding:0 16px;
      border-radius:999px;
      border:1px solid rgba(0,0,0,0.10);
      background:#fff;
      color:#0b0b0c;
      font-size:14px;
      font-weight:650;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      white-space:nowrap;
      transition:transform .16s ease, border-color .16s ease, box-shadow .16s ease;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__pillBtn:hover{
      transform:translateY(-1px);
      border-color:rgba(0,0,0,0.16);
      box-shadow:0 10px 24px rgba(0,0,0,0.08);
    }

    /* Title + artist */
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__title{
      font-size:28px;
      line-height:1.06;
      letter-spacing:-0.02em;
      font-weight:700;
      margin:6px 0 10px;
      color:#0b0b0c;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__artistRow{
      display:flex; align-items:center; gap:10px;
      margin:0 0 12px;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__avatar{
      width:34px; height:34px; border-radius:999px;
      overflow:hidden; background:#ececf1;
      border:1px solid rgba(0,0,0,0.06);
      display:flex; align-items:center; justify-content:center;
      flex:0 0 auto;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__avatar img{ width:100%; height:100%; object-fit:cover; display:block; }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__avatarFallback{
      font-size:12px; font-weight:750; letter-spacing:.02em; opacity:.75;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__artistName{
      font-size:15px; font-weight:650; color:#0b0b0c; opacity:.9;
    }

    /* Hero */
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__hero{
      position:relative;
      background:#f1f1f4;
      border-radius:16px;
      overflow:hidden;
      padding:14px;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__heroMedia{
      height: clamp(360px, 56vh, 520px);
      display:flex; align-items:center; justify-content:center;
      background:#fff;
      border-radius:14px;
      overflow:hidden;
      cursor:zoom-in;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__heroMedia img{
      height:100%;
      width:auto;
      max-height:100%;
      max-width:100%;
      object-fit:contain;
      display:block;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__zoomHint{
      position:absolute;
      left:18px;
      bottom:18px;
      font-size:12px;
      padding:8px 12px;
      border-radius:999px;
      background:rgba(255,255,255,0.92);
      border:1px solid rgba(0,0,0,0.08);
      color:#0b0b0c;
      opacity:.92;
      backdrop-filter:blur(8px);
      -webkit-backdrop-filter:blur(8px);
      cursor:pointer;
    }

    /* Desc */
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__desc{
      margin-top:14px;
      font-size:15px;
      line-height:1.65;
      color:#141417;
      opacity:.92;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__desc p{ margin:0 0 14px; }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-mobile__desc p:last-child{ margin-bottom:0; }

    /* ===== Zoom overlay ===== */
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-zoom{
      position:fixed; inset:0; background:rgba(0,0,0,0.9);
      display:none; align-items:center; justify-content:center;
      z-index:9999; padding:16px;
    }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-zoom.is-active{ display:flex; }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-zoom__img{ max-width:95vw; max-height:95vh; }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-zoom__img img{ display:block; max-width:100%; max-height:95vh; object-fit:contain; }
    #ac-pdp-mobile-{{ section.id }} .ac-pdp-zoom__close{
      position:fixed; top:14px; right:14px;
      width:44px; height:44px; border-radius:999px;
      border:1px solid rgba(255,255,255,0.18);
      background:rgba(0,0,0,0.25);
      color:#fff; font-size:20px;
      display:flex; align-items:center; justify-content:center;
      cursor:pointer;
    }

    /* =========================
      ARTCLUB Product Preview Modal (MOBILE)
      ========================= */
    html.artp-modal-open,
    body.artp-modal-open { overflow:hidden !important; }

    #ac-pdp-mobile-{{ section.id }} .artp-modal{
      position:fixed; inset:0; z-index:999999; display:none;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-modal.is-open{ display:block; }

    #ac-pdp-mobile-{{ section.id }} .artp-modal__backdrop{
      position:absolute; inset:0;
      background:rgba(0,0,0,0.28);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    #ac-pdp-mobile-{{ section.id }} .artp-modal__panel{
      position:relative;
      width:100%; height:100%;
      background:#fff;
      overflow:auto;
      -webkit-overflow-scrolling:touch;
      padding:64px 0 calc(18px + 84px + env(safe-area-inset-bottom, 0px));
    }

    #ac-pdp-mobile-{{ section.id }} .artp-modal__close{
      position:fixed; top:12px; right:12px;
      width:44px; height:44px; border-radius:999px;
      border:1px solid rgba(0,0,0,0.10);
      background:rgba(255,255,255,0.88);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      display:grid; place-items:center;
      cursor:pointer;
      z-index:50;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-modal__close:hover{ background:#fff; }

    /* Modal content wrapper */
    #ac-pdp-mobile-{{ section.id }} .artp__wrap{
      max-width:720px;
      margin:0 auto;
      padding:0 16px;
      display:grid;
      gap:14px;
    }

    /* Room preview */
    #ac-pdp-mobile-{{ section.id }} .artp-room{
      position:relative;
      border-radius:16px;
      overflow:hidden;
      background:#f4f4f6;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-room__item{ display:none; position:relative; margin:0; }
    #ac-pdp-mobile-{{ section.id }} .artp-room__item.is-active{ display:block; }
    #ac-pdp-mobile-{{ section.id }} .artp-room__bg{ display:block; width:100%; height:auto; }

    #ac-pdp-mobile-{{ section.id }} .artp-wallzone{
      position:absolute;
      left:var(--zl,0%); top:var(--zt,0%);
      width:var(--zw,100%); height:var(--zh,100%);
      pointer-events:none;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-room__item[data-zone-visible='true'] .artp-wallzone{
      outline:2px dashed rgba(0,0,0,0.22);
      background:rgba(0,0,0,0.03);
    }
    #ac-pdp-mobile-{{ section.id }} .artp-wallzone__label{ display:none !important; }

    #ac-pdp-mobile-{{ section.id }} .artp-art{
      position:absolute;
      left:50%; top:50%;
      transform:translate(-50%,-50%);
      width:40%;
      height:auto;
      background:#fff;
      pointer-events:none;
      z-index:10;
      border: var(--art-border, 0px) solid var(--art-border-color, #fff);
      max-width:none;
      max-height:none;
    }

    #ac-pdp-mobile-{{ section.id }} .artp-frame,
    #ac-pdp-mobile-{{ section.id }} .artp-acryl{
      position:absolute; left:50%; top:50%;
      transform:translate(-50%,-50%);
      pointer-events:none;
    }

    #ac-pdp-mobile-{{ section.id }} .artp-acryl{
      z-index:20;
      border-radius:2px;
      background:
        linear-gradient(135deg, rgba(255,255,255,0.30) 0%, rgba(255,255,255,0.55) 28%, rgba(255,255,255,0.10) 60%),
        linear-gradient(315deg, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0) 45%);
      mix-blend-mode: screen;
      opacity:0.95;
      border:1px solid rgba(255,255,255,0.85);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.10), 0 14px 32px rgba(0,0,0,0.20);
    }

    #ac-pdp-mobile-{{ section.id }} .artp-frame{
      z-index:15;
      background:transparent;
      box-shadow: inset 0 0 0 var(--frame-thick, 20px) var(--frame-color, #111);
    }
    #ac-pdp-mobile-{{ section.id }} .artp-frame::before{
      content:'';
      position:absolute;
      inset: var(--frame-thick, 20px);
      box-shadow: inset 0 0 0 var(--frame-gap, 8px) rgba(0,0,0,0.6), inset 0 12px 20px rgba(0,0,0,0.25);
    }

    #ac-pdp-mobile-{{ section.id }} [hidden]{ display:none !important; }

    /* FIX: themes that do div:empty { display:none } */
    #ac-pdp-mobile-{{ section.id }} .artp-acryl,
    #ac-pdp-mobile-{{ section.id }} .artp-frame{ display:block !important; }
    #ac-pdp-mobile-{{ section.id }} .artp-acryl:empty,
    #ac-pdp-mobile-{{ section.id }} .artp-frame:empty{ display:block !important; }
    #ac-pdp-mobile-{{ section.id }} .artp-acryl[hidden],
    #ac-pdp-mobile-{{ section.id }} .artp-frame[hidden]{ display:none !important; }

    /* Room thumbs */
    #ac-pdp-mobile-{{ section.id }} .artp-room__thumbs{
      display:flex; gap:10px;
      overflow-x:auto;
      -webkit-overflow-scrolling:touch;
      padding:10px 2px 2px;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-room__thumb{
      border:1px solid rgba(0,0,0,0.10);
      border-radius:12px;
      overflow:hidden;
      background:#fff;
      cursor:pointer;
      padding:0;
      height:70px;
      flex:0 0 104px;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-room__thumb img{
      width:100% !important; height:100% !important;
      object-fit:cover; display:block;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-room__thumb.is-active{
      outline:2px solid #0071e3;
      border-color:rgba(0,0,0,0.10);
    }

    /* Configurator card */
    #ac-pdp-mobile-{{ section.id }} .artp-config{
      border:1px solid rgba(0,0,0,0.08);
      border-radius:16px;
      background:#fff;
      padding:14px;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-config__group{ margin-bottom:14px; }
    #ac-pdp-mobile-{{ section.id }} .artp-config__group:last-child{ margin-bottom:0; }

    #ac-pdp-mobile-{{ section.id }} .artp-config__head{
      padding:8px 2px 10px;
      border-bottom:1px solid rgba(0,0,0,0.08);
      margin-bottom:10px;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-config__kicker{
      font:650 12px/1.2 system-ui;
      color:#6b6b6b;
      letter-spacing:0.02em;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-config__title{
      font:750 16px/1.2 system-ui;
      color:#111;
      margin-top:4px;
    }

    #ac-pdp-mobile-{{ section.id }} .artp-choicegrid{
      display:grid;
      gap:10px;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-choice{
      appearance:none;
      border:1px solid rgba(0,0,0,0.14);
      background:#fff;
      border-radius:14px;
      padding:14px;
      cursor:pointer;
      text-align:left;
      display:grid;
      gap:10px;
      transition:border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-choice:hover{ border-color:rgba(0,0,0,0.24); }
    #ac-pdp-mobile-{{ section.id }} .artp-choice.is-active{
      border-color:#0071e3;
      box-shadow:0 0 0 2px rgba(0,113,227,0.20);
    }
    #ac-pdp-mobile-{{ section.id }} .artp-choice[disabled]{ opacity:0.45; cursor:not-allowed; }
    #ac-pdp-mobile-{{ section.id }} .artp-choice__top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-choice__title{
      font:750 15px/1.2 system-ui;
      color:#111;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-choice__sub{
      font:550 12px/1.35 system-ui;
      color:#6b6b6b;
      margin-top:4px;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-choice__price{
      font:800 13px/1.2 system-ui;
      color:#111;
      white-space:nowrap;
    }

    /* Sticky bar (fixed bottom) */
    #ac-pdp-mobile-{{ section.id }} .artp-stickybar{
      position:fixed;
      left:0; right:0; bottom:0;
      z-index:60;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      padding:12px 14px calc(12px + env(safe-area-inset-bottom, 0px));
      background:rgba(255,255,255,0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-top:1px solid rgba(0,0,0,0.08);
    }
    #ac-pdp-mobile-{{ section.id }} .artp-stickybar__inner{
      max-width:720px;
      margin:0 auto;
      width:100%;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-stickybar__title{
      font:800 12px/1.2 system-ui;
      color:#111;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-stickybar__sub{
      font:600 12px/1.25 system-ui;
      color:#6b6b6b;
      margin-top:3px;
      max-width:42vw;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-atc{
      display:inline-flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      border:0;
      border-radius:999px;
      padding:12px 14px;
      background:#0071e3;
      color:#fff;
      font:800 13px/1 system-ui;
      cursor:pointer;
      min-width:170px;
    }
    #ac-pdp-mobile-{{ section.id }} .artp-atc[disabled]{ opacity:0.45; cursor:not-allowed; }
    #ac-pdp-mobile-{{ section.id }} .artp-atc__price{ font-weight:900; white-space:nowrap; }


    /* ===== MOBILE FIX: prevent horizontal clipping ===== */
#ac-pdp-mobile-{{ section.id }},
#ac-pdp-mobile-{{ section.id }} * ,
#ac-pdp-mobile-{{ section.id }} *::before,
#ac-pdp-mobile-{{ section.id }} *::after{
  box-sizing:border-box !important;
}

#ac-pdp-mobile-{{ section.id }} .artp-modal__panel{
  overflow-x:hidden !important;
}

/* wrappers must never exceed viewport */
#ac-pdp-mobile-{{ section.id }} .artp__wrap,
#ac-pdp-mobile-{{ section.id }} .artp-config{
  max-width:100% !important;
  width:100% !important;
}

/* stickybar: allow shrinking instead of pushing out of screen */
#ac-pdp-mobile-{{ section.id }} .artp-stickybar__inner{
  max-width:100% !important;
  width:100% !important;
}

#ac-pdp-mobile-{{ section.id }} .artp-stickybar__meta{
  flex:1 1 auto !important;
  min-width:0 !important; /* critical for ellipsis + no overflow */
}

#ac-pdp-mobile-{{ section.id }} .artp-stickybar__form{
  flex:0 0 auto !important;
}

#ac-pdp-mobile-{{ section.id }} .artp-atc{
  min-width:0 !important; /* remove the "pushing" effect */
}

/* ===== MOBILE: Room image must NEVER be wider than the viewport/container ===== */
@media (max-width: 820px){
  #ac-pdp-mobile-{{ section.id }} .artp__left,
  #ac-pdp-mobile-{{ section.id }} .artp-room,
  #ac-pdp-mobile-{{ section.id }} .artp-room__item{
    width:100% !important;
    max-width:100% !important;
    min-width:0 !important;
  }

  #ac-pdp-mobile-{{ section.id }} .artp-room__item{
    margin:0 !important; /* kills negative margin bugs */
  }

  #ac-pdp-mobile-{{ section.id }} .artp-room__bg{
    display:block !important;
    width:100% !important;     /* <- critical */
    max-width:100% !important; /* <- critical */
    height:auto !important;
  }

  /* safety: if any wrapper still overflows */
  #ac-pdp-mobile-{{ section.id }} .artp-modal__panel{
    overflow-x:hidden !important;
  }
}

@media (max-width: 920px){
  /* thumbs container darf nie über den inneren wrap hinaus */
  #ac-pdp-mobile-{{ section.id }} .artp-room__thumbs{
    width:100% !important;
    max-width:100% !important;
    overflow-x:auto !important;
    overflow-y:hidden !important;
    -webkit-overflow-scrolling:touch;
    padding:10px 0 2px !important;  /* statt 10px 2px 2px */
    margin:0 !important;
    gap:10px !important;
  }

  /* WICHTIG: weg von fixen 104px / 70px -> responsive + proportional */
  #ac-pdp-mobile-{{ section.id }} .artp-room__thumb{
    flex: 0 0 auto !important;
    width: clamp(72px, 24vw, 98px) !important;  /* passt sicher in 3er-Reihe */
    height: auto !important;
    aspect-ratio: 4 / 3 !important;
    padding:0 !important;
  }

  #ac-pdp-mobile-{{ section.id }} .artp-room__thumb img{
    width:100% !important;
    height:100% !important;
    object-fit:cover !important;
    display:block !important;
  }
}

#ac-pdp-mobile-{{ section.id }} .container-thumbnail{
    max-width: 100vw;
    position: sticky;
    top: 0;
    backdrop-filter: blur(10px);
    background: #ffffff8c;
    padding-bottom: 16px;
    margin-left: -16px;
    margin-right: -16px;
    padding-left: 16px;
    padding-right: 16px;
}


  </style>

  {%- assign back_url = section.settings.back_url -%}
  {%- if back_url == blank and collection -%}{%- assign back_url = collection.url -%}{%- endif -%}
  {%- if back_url == blank -%}{%- assign back_url = '/collections/all' -%}{%- endif -%}

  {%- assign artist_name = product.metafields.custom.kunstler.name | default: product.vendor -%}
  {%- assign artist_avatar = product.metafields.custom.kunstler.bilder -%}

  <div class="ac-pdp-mobile__wrap">
    <div class="ac-pdp-mobile__top">
      <div>
        {% if section.settings.show_back %}
          <a class="ac-pdp-mobile__back" href="{{ back_url }}"><span aria-hidden="true">←</span>{{ section.settings.back_label }}</a>
        {% endif %}
      </div>

      <div class="ac-pdp-mobile__actions">
        <button type="button" class="ac-pdp-mobile__iconBtn" aria-label="{{ section.settings.wishlist_label }}" aria-pressed="false" data-ac-wishlist-toggle>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 20.5s-7-4.3-9.4-8.2C.6 8.7 2.6 5.5 6 5.5c1.9 0 3.3 1 4 2.1.7-1.1 2.1-2.1 4-2.1 3.4 0 5.4 3.2 3.4 6.8C19 16.2 12 20.5 12 20.5z" stroke="#0b0b0c" stroke-width="1.6" fill="transparent" />
          </svg>
        </button>

        <button type="button" class="ac-pdp-mobile__pillBtn" data-artp-open="artp-modal-m-{{ section.id }}">
          {{ section.settings.buy_label }}
        </button>
      </div>
    </div>

    <h1 class="ac-pdp-mobile__title">{{ product.title }}</h1>

    <div class="ac-pdp-mobile__artistRow">
      <div class="ac-pdp-mobile__avatar" aria-hidden="true">
        {% if artist_avatar != blank %}
          {{ artist_avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: artist_name }}
        {% else %}
          <div class="ac-pdp-mobile__avatarFallback">{{ artist_name | slice: 0, 1 | upcase }}</div>
        {% endif %}
      </div>
      {% if artist_name != blank %}<div class="ac-pdp-mobile__artistName">{{ artist_name }}</div>{% endif %}
    </div>

    <div class="ac-pdp-mobile__hero">
      <div class="ac-pdp-mobile__heroMedia" data-ac-zoom-trigger>
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 2400 | image_tag: loading: 'lazy', alt: product.title }}
        {% endif %}
      </div>
      <button type="button" class="ac-pdp-mobile__zoomHint" data-ac-zoom-trigger>{{ section.settings.zoom_hint }}</button>
    </div>

    {%- assign werk_text_mf = product.metafields.custom.werk_text -%}
    {%- assign desc_html = product.description -%}
    {% if werk_text_mf != blank or desc_html != blank %}
      <div class="ac-pdp-mobile__desc">
        {% if werk_text_mf != blank %}
          {%- assign t = werk_text_mf | replace: '\r\n', '\n' -%}
          {%- assign t = t | replace: '\n\n', '[[P]]' -%}
          {%- assign t = t | replace: '\n', ' ' -%}
          {%- assign t = t | replace: '[[P]]', '</p><p>' -%}
          <p>{{ t }}</p>
        {% else %}
          {{ desc_html }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  <!-- Zoom Overlay -->
  <div class="ac-pdp-zoom" data-ac-zoom>
    <button type="button" class="ac-pdp-zoom__close" data-ac-zoom-close aria-label="Close">×</button>
    <div class="ac-pdp-zoom__img">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 2800 | image_tag: alt: product.title }}
      {% endif %}
    </div>
  </div>

  {%- assign tags_lc = product.tags | join: ',' | downcase -%}
  {%- assign title_lc = product.title | downcase -%}
  {%- assign force_original_only = false -%}
  {%- if product.has_only_default_variant -%}
    {%- if tags_lc contains 'original' or title_lc contains 'original' or product.metafields.custom.height != blank or product.metafields.custom.breite_cm_ != blank -%}
      {%- assign force_original_only = true -%}
    {%- endif -%}
  {%- endif -%}

  {%- capture variants_json -%}[{% for v in product.variants %}{% if forloop.first == false %},{% endif %}{
    "id": {{ v.id }},
    "title": {{ v.title | json }},
    "sku": {{ v.sku | json }},
    "price": {{ v.price | json }},
    "available": {{ v.available | json }},
    "option1": {{ v.option1 | json }},
    "option2": {{ v.option2 | json }},
    "option3": {{ v.option3 | json }},
    "img": {% if v.featured_media %}{{ v.featured_media | image_url: width: 1600 | json }}{% else %}null{% endif %}
  }{% endfor %}]{%- endcapture -%}

  {%- assign art_default_img = product.featured_media | default: product.media.first -%}
  {%- assign art_default_src = art_default_img | image_url: width: 1600 -%}

  <!-- Buy Options Modal (Mobile) -->
  <div class="artp-modal" id="artp-modal-m-{{ section.id }}" aria-hidden="true">
    <div class="artp-modal__backdrop" data-artp-close></div>

    <div class="artp-modal__panel" role="dialog" aria-modal="true" aria-label="{{ product.title | escape }}" tabindex="-1">
      <button type="button" class="artp-modal__close" data-artp-close aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      <div class="artp__wrap" data-artp data-section-id="{{ section.id }}">
        <!-- Room preview -->
        <div class="container-thumbnail">
          {% if section.blocks.size > 0 %}
            <div class="artp-room">
              {% for b in section.blocks %}
                {% if b.type == 'room' and b.settings.image != blank %}
                  <figure
                    class="artp-room__item{% if forloop.first %} is-active{% endif %}"
                    data-room-idx="{{ forloop.index0 }}"
                    style="--zl:{{ b.settings.zone_left }}%;--zt:{{ b.settings.zone_top }}%;--zw:{{ b.settings.zone_width }}%;--zh:{{ b.settings.zone_height }}%;"
                    data-zone-realw="{{ b.settings.zone_realw_cm }}"
                    data-shadow-deg="{{ b.settings.shadow_deg | times: 10 }}"
                    data-shadow-dist="{{ b.settings.shadow_dist_cm }}"
                    data-shadow-blur="{{ b.settings.shadow_blur_cm }}"
                    data-shadow-op="{{ b.settings.shadow_opacity | divided_by: 100.0 }}"
                    data-zone-visible="{{ b.settings.show_zone | default: true }}"
                    data-art-border="{{ b.settings.art_border }}"
                    data-art-border-color="{{ b.settings.art_border_color }}"
                  >
                    {{ b.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', class: 'artp-room__bg', alt: product.title }}

                    <div class="artp-wallzone" aria-hidden="true">
                      <span class="artp-wallzone__label">Wandbereich</span>
                    </div>

                    {% if art_default_src %}
                      <img data-art-img src="{{ art_default_src }}" alt="{{ product.title | escape }}" class="artp-art">
                      <div class="artp-frame" data-frame hidden></div>
                      <div class="artp-acryl" data-acryl hidden></div>
                    {% endif %}
                  </figure>
                {% endif %}
              {% endfor %}
            </div>

            {% if section.blocks.size > 1 %}
              <div class="artp-room__thumbs">
                {% for b in section.blocks %}
                  {% if b.type == 'room' and b.settings.image != blank %}
                    <button class="artp-room__thumb{% if forloop.first %} is-active{% endif %}" data-room-go="{{ forloop.index0 }}" type="button">
                      {{ b.settings.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: product.title }}
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          {% else %}
            <div style="border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:14px;">
              Bitte füge mindestens ein „Room Preview“ Blockbild hinzu.
            </div>
          {% endif %}
        </div>

        <!-- Configurator -->
        <div class="artp-config" data-ac-config>
          <div class="artp-config__group" data-group="model">
            <div class="artp-config__head">
              <div class="artp-config__kicker">Ausführung</div>
              <div class="artp-config__title">Was passt zu dir?</div>
            </div>
            <div class="artp-choicegrid" data-model-choices></div>
          </div>

          <div class="artp-config__group" data-group="finish" hidden>
            <div class="artp-config__head">
              <div class="artp-config__kicker">Finish</div>
              <div class="artp-config__title">Rahmen / Oberfläche</div>
            </div>
            <div class="artp-choicegrid" data-finish-choices></div>
          </div>

          <div class="artp-config__group" data-group="size" hidden>
            <div class="artp-config__head">
              <div class="artp-config__kicker">Größe</div>
              <div class="artp-config__title">Welche Size?</div>
            </div>
            <div class="artp-choicegrid" data-size-choices></div>
          </div>
        </div>
      </div>

      <!-- Stickybar (fixed bottom) -->
      <div class="artp-stickybar" data-stickybar>
        <div class="artp-stickybar__inner">
          <div class="artp-stickybar__meta">
            <div class="artp-stickybar__title">{{ product.title }}</div>
            <div class="artp-stickybar__sub" data-selection-summary>Bitte auswählen</div>
          </div>

          <form method="post" action="/cart/add" class="artp-stickybar__form" data-atc-form>
            <input type="hidden" name="id" value="" data-atc-variant>
            <button class="artp-atc" type="submit" disabled data-atc-btn>
              <span>Add to Cart</span>
              <span class="artp-atc__price" data-atc-price></span>
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>

  <script>
    (function(){
      var root = document.getElementById('ac-pdp-mobile-{{ section.id }}');
      if(!root) return;

      /* -------------------- Data -------------------- */
      var PRODUCT_ID = String(root.getAttribute('data-product-id') || '');
      var VARIANTS = {{ variants_json | strip_newlines }};
      var FORCE_ORIGINAL_ONLY = {{ force_original_only | json }};
      var DEFAULT_ART = {{ art_default_src | default: '' | json }};
      var CURRENCY = {{ shop.currency | json }};

      var ORIGINAL_SIZE_LABEL = (function(){
        {% if product.metafields.custom.height and product.metafields.custom.breite_cm_ %}
          return "{{ product.metafields.custom.height | round: 0 }}x{{ product.metafields.custom.breite_cm_ | round: 0 }}";
        {% else %}
          return "60x40";
        {% endif %}
      })();

      function fmtMoney(cents){
        try { return new Intl.NumberFormat("de-DE", { style:"currency", currency:CURRENCY }).format((cents||0)/100); }
        catch(e){ return ((cents||0)/100).toFixed(2); }
      }

      function isOriginalVariant(v){
        var o1 = String(v && v.option1 || '');
        var t  = String(v && v.title || '');
        return /original/i.test(o1) || /original/i.test(t);
      }

      var ORIGINAL = FORCE_ORIGINAL_ONLY ? (VARIANTS[0] || null) : (VARIANTS.find(isOriginalVariant) || null);
      var EDITIONS = FORCE_ORIGINAL_ONLY ? [] : VARIANTS.filter(function(v){ return !isOriginalVariant(v); });

      // Variant schema helpers
      function finishKey(v){
        var o1 = String(v.option1 || '');
        var o2 = String(v.option2 || '');
        var o3 = String(v.option3 || '');
        if (o3 && /print|edition/i.test(o1)) return o2 || '';
        return o1 || '';
      }
      function sizeKey(v){
        var o1 = String(v.option1 || '');
        var o2 = String(v.option2 || '');
        var o3 = String(v.option3 || '');
        if (o3 && /print|edition/i.test(o1)) return o3 || '';
        return o2 || '';
      }

      function uniq(arr){
        var out = [];
        (arr||[]).forEach(function(x){
          if(!x) return;
          if(out.indexOf(x) === -1) out.push(x);
        });
        return out;
      }

      /* -------------------- Wishlist (localStorage) -------------------- */
      var WISHLIST_KEY = 'ac_wishlist';
      var wishBtn = root.querySelector('[data-ac-wishlist-toggle]');

      function safeParse(json){ try{ return JSON.parse(json); }catch(e){ return null; } }
      function getWishlist(){
        var raw = localStorage.getItem(WISHLIST_KEY);
        var parsed = safeParse(raw);
        if(Array.isArray(parsed)) return parsed.map(String);
        return [];
      }
      function setWishlist(arr){
        localStorage.setItem(WISHLIST_KEY, JSON.stringify(arr));
        window.dispatchEvent(new CustomEvent('ac:wishlist:changed', { detail: { ids: arr } }));
      }
      function isWishlisted(){ return getWishlist().indexOf(PRODUCT_ID) !== -1; }
      function renderWishlist(){
        if(!wishBtn) return;
        var active = isWishlisted();
        wishBtn.classList.toggle('is-active', active);
        wishBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
      }
      function toggleWishlist(){
        var list = getWishlist();
        var idx = list.indexOf(PRODUCT_ID);
        if(idx >= 0) list.splice(idx, 1);
        else list.push(PRODUCT_ID);
        setWishlist(list);
        renderWishlist();
      }
      if(wishBtn) wishBtn.addEventListener('click', toggleWishlist);
      window.addEventListener('storage', function(e){ if(e.key === WISHLIST_KEY) renderWishlist(); });
      window.addEventListener('ac:wishlist:changed', renderWishlist);
      renderWishlist();

      /* -------------------- PDP Zoom -------------------- */
      var zoomOverlay = root.querySelector('[data-ac-zoom]');
      var zoomClose = root.querySelector('[data-ac-zoom-close]');
      function openZoom(){
        if(!zoomOverlay) return;
        zoomOverlay.classList.add('is-active');
        document.documentElement.style.overflow = 'hidden';
      }
      function closeZoom(){
        if(!zoomOverlay) return;
        zoomOverlay.classList.remove('is-active');
        document.documentElement.style.overflow = '';
      }
      var zoomTriggers = root.querySelectorAll('[data-ac-zoom-trigger]');
      if(zoomTriggers && zoomTriggers.length){
        zoomTriggers.forEach(function(el){ el.addEventListener('click', openZoom); });
      }
      if(zoomClose) zoomClose.addEventListener('click', closeZoom);
      if(zoomOverlay) zoomOverlay.addEventListener('click', function(e){ if(e.target === zoomOverlay) closeZoom(); });

      /* -------------------- Modal Open/Close -------------------- */
      var MODAL_ID = 'artp-modal-m-{{ section.id }}';
      var modal = document.getElementById(MODAL_ID);
      if(!modal) return;
      var panel = modal.querySelector('.artp-modal__panel');
      var lastFocus = null;

      function openModal(fromEl){
        if(modal.classList.contains('is-open')) return;
        lastFocus = fromEl || document.activeElement;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden','false');
        document.documentElement.classList.add('artp-modal-open');
        document.body.classList.add('artp-modal-open');

        requestAnimationFrame(function(){
          if(panel) panel.focus();
          requestAnimationFrame(renderOverlayForState);
          setTimeout(renderOverlayForState, 120);
          setTimeout(renderOverlayForState, 320);
        });
      }
      function closeModal(){
        if(!modal.classList.contains('is-open')) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden','true');
        document.documentElement.classList.remove('artp-modal-open');
        document.body.classList.remove('artp-modal-open');
        if(lastFocus && lastFocus.focus) lastFocus.focus();
      }

      document.addEventListener('click', function(e){
        var opener = e.target.closest('[data-artp-open="' + MODAL_ID + '"]');
        if(opener){
          e.preventDefault();
          openModal(opener);
          return;
        }
        if(!modal.classList.contains('is-open')) return;
        var closer = e.target.closest('[data-artp-close]');
        if(closer){
          e.preventDefault();
          closeModal();
        }
      });

      document.addEventListener('keydown', function(e){
        if(e.key === 'Escape'){
          if(zoomOverlay && zoomOverlay.classList.contains('is-active')) closeZoom();
          if(modal.classList.contains('is-open')) closeModal();
        }
      });

      /* -------------------- Room Switcher -------------------- */
      function $all(sel, r){ return Array.prototype.slice.call((r||document).querySelectorAll(sel)); }
      function getActiveRoom(){ return modal.querySelector('.artp-room__item.is-active'); }

      var roomThumbBtns = $all('.artp-room__thumb[data-room-go]', modal);
      var roomFigures   = $all('.artp-room__item[data-room-idx]', modal);

      roomFigures.forEach(function(fig){
        var bg = fig.querySelector('.artp-room__bg');
        if(bg && !bg.complete){
          bg.addEventListener('load', function(){
            if(fig.classList.contains('is-active')) renderOverlayForState();
          }, { once:true });
        }
      });

      function setActiveRoom(idx){
        var key = String(idx);
        roomFigures.forEach(function(fig){
          fig.classList.toggle('is-active', String(fig.dataset.roomIdx) === key);
        });
        roomThumbBtns.forEach(function(btn){
          btn.classList.toggle('is-active', String(btn.dataset.roomGo) === key);
        });

        var fig = roomFigures.find(function(f){ return String(f.dataset.roomIdx) === key; });
        if(!fig) return;

        var bg = fig.querySelector('.artp-room__bg');
        var rerender = function(){
          requestAnimationFrame(renderOverlayForState);
          setTimeout(renderOverlayForState, 80);
        };
        if(bg && !bg.complete) bg.addEventListener('load', rerender, { once:true });
        else rerender();
      }

      roomThumbBtns.forEach(function(btn){
        btn.addEventListener('click', function(e){
          e.preventDefault();
          setActiveRoom(btn.getAttribute('data-room-go'));
        });
      });

      /* -------------------- Geometry Helpers -------------------- */
      function parseSize(label){
        var m = String(label||'').match(/(\d+(?:[\.,]\d+)?)\s*[x×]\s*(\d+(?:[\.,]\d+)?)/i);
        if(!m) return {H:50, B:40};
        return {H: parseFloat(m[1].replace(',','.')), B: parseFloat(m[2].replace(',','.'))};
      }

      function getPpcm(fig){
        var zone = fig && fig.querySelector('.artp-wallzone');
        if(!zone) return 0;
        var realW = parseFloat(fig.dataset.zoneRealw || '0');
        if(!realW) return 0;
        var r = zone.getBoundingClientRect();
        return r.width / realW;
      }

      function applyShadow(fig, img){
        var ppcm = getPpcm(fig) || 1;
        var deg = (parseFloat(fig.dataset.shadowDeg || '0') || 0) * Math.PI / 180;
        var dist = (parseFloat(fig.dataset.shadowDist || '0') || 0) * ppcm;
        var blur = (parseFloat(fig.dataset.shadowBlur || '0') || 0) * ppcm;
        var op = parseFloat(fig.dataset.shadowOp || '0.3') || 0.3;
        var dx = Math.cos(deg) * dist, dy = Math.sin(deg) * dist;
        img.style.filter = 'drop-shadow(' + dx.toFixed(1) + 'px ' + dy.toFixed(1) + 'px ' + blur.toFixed(1) + 'px rgba(0,0,0,' + op + '))';
      }

      function isAcrylic(name){
        name = String(name||'');
        return /(acryl|acrylic|acrylglas|acrylic\s*glas|acrylic\s*glass|mounted\s*under\s*acrylic|mounted\s*under\s*acryl|plexi|plexiglas|kasch|kaschiert|dibond)/i.test(name);
      }

      function isFloater(name){
        name = String(name||'');
        return /(floater|floater\s*frame|shadow\s*gap|schattenfuge|float\s*frame)/i.test(name);
      }

      /* -------------------- Overlay Renderer -------------------- */
      var activeView = (ORIGINAL ? 'original' : 'editions');
      var currentFinishName = null;
      var selectedEditionSize = null;
      var selectedVariant = null;

      function layoutArtwork(fig, sizeLabel, finishName, detectStr){
        if(!fig) return;

        var zone  = fig.querySelector('.artp-wallzone');
        var img   = fig.querySelector('[data-art-img]');
        var acryl = fig.querySelector('[data-acryl]');
        var frame = fig.querySelector('[data-frame]');
        if(!zone || !img) return;

        var ppcm = getPpcm(fig);
        if(!ppcm) return;

        var s = parseSize(sizeLabel);
        var pxW = (s.B * ppcm);
        var pxH = (s.H * ppcm);

        var zr = zone.getBoundingClientRect();
        var fr = fig.getBoundingClientRect();

        var fit = Math.min(zr.width / pxW, zr.height / pxH);
        var boost = 1.25; /* always mobile */
        var scale = Math.min(fit * boost, 2.0);

        var artW = pxW * scale;
        var artH = pxH * scale;

        img.style.setProperty('--art-border', (parseFloat(fig.dataset.artBorder || '0') || 0) + 'px');
        img.style.setProperty('--art-border-color', fig.dataset.artBorderColor || '#fff');

        img.style.width  = artW.toFixed(1) + 'px';
        img.style.height = artH.toFixed(1) + 'px';
        img.style.maxWidth = 'none';
        img.style.maxHeight = 'none';

        var cx = (zr.left - fr.left) + zr.width/2;
        var cy = (zr.top  - fr.top ) + zr.height/2;

        img.style.left = (cx / fr.width) * 100 + '%';
        img.style.top  = (cy / fr.height) * 100 + '%';
        img.style.transform = 'translate(-50%,-50%)';

        applyShadow(fig, img);

        var key = (String(finishName||'') + ' ' + String(detectStr||'')).trim();
        var acrylic = isAcrylic(key);
        var floater = isFloater(key);

        if(acryl){ acryl.hidden = true; }
        if(frame){ frame.hidden = true; }

        if(acrylic && acryl){
          acryl.style.width  = artW.toFixed(1) + 'px';
          acryl.style.height = artH.toFixed(1) + 'px';
          acryl.style.left = img.style.left;
          acryl.style.top  = img.style.top;
          acryl.hidden = false;
        }

        if(floater && frame){
          var FRAME_CM = 0.9;
          var GAP_CM   = 0.5;

          var tPx = FRAME_CM * ppcm;
          var gPx = GAP_CM   * ppcm;

          tPx = Math.max(6, Math.min(tPx, 14));
          gPx = Math.max(4, Math.min(gPx, 10));

          var outerW = artW + 2*(tPx + gPx);
          var outerH = artH + 2*(tPx + gPx);

          frame.style.setProperty('--frame-thick', tPx.toFixed(2) + 'px');
          frame.style.setProperty('--frame-gap',   gPx.toFixed(2) + 'px');
          frame.style.width  = outerW.toFixed(1) + 'px';
          frame.style.height = outerH.toFixed(1) + 'px';
          frame.style.left = img.style.left;
          frame.style.top  = img.style.top;

          frame.hidden = false;
        }
      }

      function pickEditionVariant(finish, size){
        var list = EDITIONS.slice();
        function match(v){
          return String(finishKey(v)) === String(finish) && String(sizeKey(v)) === String(size);
        }
        return list.find(function(v){ return match(v) && v.available; }) || list.find(match) || null;
      }

      function renderOverlayForState(){
        var fig = getActiveRoom();
        if(!fig) return;

        var img = fig.querySelector('[data-art-img]');
        if(!img) return;

        if(activeView === 'original'){
          selectedVariant = ORIGINAL;
          img.src = (ORIGINAL && ORIGINAL.img) ? ORIGINAL.img : DEFAULT_ART;
          layoutArtwork(fig, ORIGINAL_SIZE_LABEL, null, (ORIGINAL && ORIGINAL.title) || '');
          return;
        }

        var chosen = null;
        if(currentFinishName && selectedEditionSize){
          chosen = pickEditionVariant(currentFinishName, selectedEditionSize);
        } else if(currentFinishName){
          chosen = EDITIONS.find(function(v){ return String(finishKey(v)) === String(currentFinishName) && v.available; })
                || EDITIONS.find(function(v){ return String(finishKey(v)) === String(currentFinishName); })
                || null;
        } else if(EDITIONS.length === 1){
          chosen = EDITIONS[0];
        }

        selectedVariant = chosen;

        var src = (chosen && chosen.img) ? chosen.img : DEFAULT_ART;
        img.src = src;

        var sizeToUse = selectedEditionSize || (chosen ? sizeKey(chosen) : null);
        if(!sizeToUse){
          var any = EDITIONS[0];
          sizeToUse = any ? (sizeKey(any) || ORIGINAL_SIZE_LABEL) : ORIGINAL_SIZE_LABEL;
        }

        var finishToUse = (chosen ? finishKey(chosen) : currentFinishName) || '';
        layoutArtwork(fig, sizeToUse, finishToUse, (chosen && chosen.title) || '');
      }

      /* -------------------- Configurator UI -------------------- */
      var configRoot = modal.querySelector('[data-ac-config]');
      var modelWrap  = configRoot.querySelector('[data-model-choices]');
      var finishWrap = configRoot.querySelector('[data-finish-choices]');
      var sizeWrap   = configRoot.querySelector('[data-size-choices]');
      var groupFinish = configRoot.querySelector('[data-group="finish"]');
      var groupSize   = configRoot.querySelector('[data-group="size"]');

      var atcVariant = modal.querySelector('[data-atc-variant]');
      var atcBtn     = modal.querySelector('[data-atc-btn]');
      var atcPrice   = modal.querySelector('[data-atc-price]');
      var summaryEl  = modal.querySelector('[data-selection-summary]');

      var mode = (ORIGINAL && ORIGINAL.available) ? 'original' : (EDITIONS.length ? 'edition' : 'original');
      var finish = null;
      var size = null;

      function choiceCard(opts){
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'artp-choice' + (opts.active ? ' is-active' : '');
        if(opts.disabled) b.disabled = true;

        b.innerHTML =
          '<div class="artp-choice__top">' +
            '<div>' +
              '<div class="artp-choice__title">' + (opts.title || '') + '</div>' +
              (opts.sub ? '<div class="artp-choice__sub">' + opts.sub + '</div>' : '') +
            '</div>' +
            (opts.price ? '<div class="artp-choice__price">' + opts.price + '</div>' : '') +
          '</div>';

        b.addEventListener('click', function(){ if(!b.disabled && typeof opts.onClick === 'function') opts.onClick(); });
        return b;
      }

      function setATC(v, summaryText){
        if(summaryEl) summaryEl.textContent = summaryText || 'Bitte auswählen';

        if(!atcVariant || !atcBtn || !atcPrice) return;

        if(!v || !v.id){
          atcVariant.value = '';
          atcBtn.disabled = true;
          atcPrice.textContent = '';
          return;
        }

        atcVariant.value = v.id;
        atcBtn.disabled = !v.available;
        atcPrice.textContent = fmtMoney(v.price);
      }

      function finishesList(){
        return uniq(EDITIONS.map(function(v){ return String(finishKey(v)||''); }).filter(Boolean));
      }

      function finishMinPrice(f){
        var list = EDITIONS.filter(function(v){ return String(finishKey(v)) === String(f); });
        if(!list.length) return null;
        var avail = list.filter(function(v){ return v.available; });
        var pick = (avail.length ? avail : list);
        var min = pick.reduce(function(m,v){ return Math.min(m, Number(v.price||0)); }, Number.POSITIVE_INFINITY);
        return Number.isFinite(min) ? min : null;
      }

      function sizesForFinish(f){
        var sizes = uniq(EDITIONS.filter(function(v){ return String(finishKey(v)) === String(f); }).map(function(v){ return String(sizeKey(v)||''); }).filter(Boolean));
        function area(s){
          var m = String(s||'').match(/(\d+(?:[.,]\d+)?)\s*[x×]\s*(\d+(?:[.,]\d+)?)/i);
          if(!m) return 0;
          var h = parseFloat(m[1].replace(',','.'));
          var w = parseFloat(m[2].replace(',','.'));
          return h*w;
        }
        return sizes.slice().sort(function(a,b){ return area(a)-area(b); });
      }

      function renderModel(){
        modelWrap.innerHTML = '';

        if(ORIGINAL){
          var origDisabled = (ORIGINAL.available === false);
          var sizeTxt = ORIGINAL_SIZE_LABEL ? ('Originalgröße ' + String(ORIGINAL_SIZE_LABEL).replace('x','×') + ' cm') : '';
          modelWrap.appendChild(choiceCard({
            title: 'Original',
            sub: origDisabled ? (sizeTxt ? (sizeTxt + ' · Verkauft') : 'Verkauft') : sizeTxt,
            price: ORIGINAL ? fmtMoney(ORIGINAL.price) : '',
            active: mode === 'original',
            disabled: origDisabled,
            onClick: function(){
              mode = 'original';
              activeView = 'original';
              currentFinishName = null;
              selectedEditionSize = null;
              finish = null; size = null;
              groupFinish.hidden = true;
              groupSize.hidden = true;
              setATC(ORIGINAL, 'Original');
              renderModel();
              renderFinish();
              renderSize();
              requestAnimationFrame(renderOverlayForState);
            }
          }));
        }

        if(EDITIONS.length){
          var avail = EDITIONS.filter(function(v){ return v.available; });
          var pick = (avail.length ? avail : EDITIONS);
          var min = pick.reduce(function(m,v){ return Math.min(m, Number(v.price||0)); }, Number.POSITIVE_INFINITY);

          modelWrap.appendChild(choiceCard({
            title: 'Print / Edition',
            sub: 'Wähle Finish & Größe',
            price: Number.isFinite(min) ? ('ab ' + fmtMoney(min)) : '',
            active: mode === 'edition',
            disabled: EDITIONS.every(function(v){ return !v.available; }),
            onClick: function(){
              mode = 'edition';
              activeView = 'editions';
              groupFinish.hidden = false;
              groupSize.hidden = true;
              finish = finish || finishesList()[0] || null;
              size = null;
              currentFinishName = finish;
              selectedEditionSize = null;
              setATC(null, finish ? ('Edition · ' + finish) : 'Edition');
              renderModel();
              renderFinish();
              renderSize();
              requestAnimationFrame(renderOverlayForState);
            }
          }));
        }
      }

      function renderFinish(){
        finishWrap.innerHTML = '';
        if(mode !== 'edition'){ groupFinish.hidden = true; return; }
        groupFinish.hidden = false;

        var fins = finishesList();
        fins.forEach(function(f){
          var p = finishMinPrice(f);
          finishWrap.appendChild(choiceCard({
            title: f,
            sub: '',
            price: (p != null) ? ('ab ' + fmtMoney(p)) : '',
            active: String(finish) === String(f),
            disabled: false,
            onClick: function(){
              finish = f;
              currentFinishName = f;
              size = null;
              selectedEditionSize = null;
              groupSize.hidden = false;
              setATC(null, 'Edition · ' + f);
              renderFinish();
              renderSize();
              requestAnimationFrame(renderOverlayForState);
            }
          }));
        });
      }

      function renderSize(){
        sizeWrap.innerHTML = '';
        if(mode !== 'edition' || !finish){ groupSize.hidden = true; return; }
        groupSize.hidden = false;

        sizesForFinish(finish).forEach(function(sz){
          var v = pickEditionVariant(finish, sz);
          var disabled = !v || !v.available;

          sizeWrap.appendChild(choiceCard({
            title: 'Size ' + sz,
            sub: disabled ? 'Nicht verfügbar' : '',
            price: v ? fmtMoney(v.price) : '',
            active: String(size) === String(sz),
            disabled: disabled,
            onClick: function(){
              var chosen = pickEditionVariant(finish, sz);
              if(!chosen || !chosen.available) return;
              size = sz;
              selectedEditionSize = sz;
              activeView = 'editions';
              currentFinishName = finish;
              setATC(chosen, 'Edition · ' + finish + ' · ' + sz);
              renderSize();
              requestAnimationFrame(renderOverlayForState);
            }
          }));
        });
      }

      // Init state
      if(mode === 'original' && ORIGINAL && ORIGINAL.available){
        activeView = 'original';
        groupFinish.hidden = true;
        groupSize.hidden = true;
        setATC(ORIGINAL, 'Original');
      } else if(EDITIONS.length){
        mode = 'edition';
        activeView = 'editions';
        finish = finishesList()[0] || null;
        currentFinishName = finish;
        groupFinish.hidden = false;
        groupSize.hidden = true;
        setATC(null, finish ? ('Edition · ' + finish) : 'Edition');
      } else {
        activeView = 'original';
        groupFinish.hidden = true;
        groupSize.hidden = true;
        setATC(ORIGINAL, 'Original · Verkauft');
      }

      renderModel();
      renderFinish();
      renderSize();

      requestAnimationFrame(function(){
        renderOverlayForState();
        setTimeout(renderOverlayForState, 160);
      });

      window.addEventListener('resize', function(){
        if(modal.classList.contains('is-open')) renderOverlayForState();
      });

    })();
  </script>

