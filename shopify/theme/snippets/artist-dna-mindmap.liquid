{%- comment -%}
  ARTCLUB — Artist DNA Mindmap (BETA v1.0 — 2025)
  Hotfix: Scoped CSS + Lazy Mount (nur wenn Modal .is-open ist).
{%- endcomment -%}

<style>
  /* ===== Scope ALLES auf #dnaModal ===== */
  #dnaModal .dna-app {
    all: initial;
    font-family: ui-sans-serif, system-ui, -apple-system, Inter, Segoe UI, Roboto, 'Helvetica Neue', Arial;
  }

  /* ---- lokale Variablen auf .dna-app (nicht :root!) ---- */
  #dnaModal .dna-app {
    --bg-0: #0b0f14;
    --bg-1: #0d1218;
    --ink: #eaf2ff;
    --muted: #93a0b1;
    --line: rgba(255, 255, 255, 0.06);

    --brand-a: #ff8a00; /* wird per JS überschrieben */
    --brand-b: #ffcc00;

    --c-ident: #ffa84c;
    --c-story: #b48cff;
    --c-social: #48e9b6;
    --c-brand: #ff7aa8;
    --c-aud: #5ab5ff;
    --c-vision: #7fd2ff;

    --r: 14px;
    --shadow: drop-shadow(0 6px 26px rgba(0, 0, 0, 0.35));
  }

  /* ---- die App belegt den Modal-Inhalt, nicht das ganze Dokument ---- */
  #dnaModal .dna-app {
    position: absolute;
    inset: 0;
    display: none; /* lazy mount: erst sichtbar, wenn Modal open */
    color: var(--ink);
    background: radial-gradient(1200px 1200px at 50% 45%, var(--bg-1), var(--bg-0) 60%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(0, 0, 0, 0));
    overflow: hidden;
    z-index: 1; /* bleibt IM Modal */
  }

  /* Kopf/Bedienelemente */
  #dnaModal .dna-head {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    gap: 10px;
    align-items: center;
    z-index: 2;
  }
  #dnaModal .dna-badge {
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: #bcd;
    backdrop-filter: blur(4px) saturate(120%);
    background: rgba(255, 255, 255, 0.04);
  }
  #dnaModal .dna-spacer {
    flex: 1;
  }
  #dnaModal .dna-ctrls {
    display: flex;
    gap: 8px;
    align-items: center;
    border: 1px solid var(--line);
    padding: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(6px) saturate(120%);
  }
  #dnaModal .dna-btn {
    appearance: none;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.06);
    color: #dfe8ff;
    padding: 6px 10px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
  }
  #dnaModal .dna-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  #dnaModal .dna-progress {
    width: 160px;
    height: 8px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
  }
  #dnaModal .dna-progress > span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #27b0ff, #2dffb8);
  }
  #dnaModal .dna-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 3;
  }

  /* Bühne */
  #dnaModal .dna-stage {
    position: absolute;
    inset: 0;
  }
  #dnaModal .dna-stage svg {
    width: 100%;
    height: 100%;
    filter: var(--shadow);
  }
  #dnaModal .edge {
    stroke: rgba(255, 255, 255, 0.09);
    stroke-width: 2.2;
    vector-effect: non-scaling-stroke;
  }

  #dnaModal .node {
    cursor: pointer;
  }
  #dnaModal .bubble {
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.35));
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  #dnaModal .node text {
    fill: #fff;
    font-weight: 800;
    letter-spacing: 0.2px;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.35), 0 2px 8px rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }
  #dnaModal .node .sub {
    fill: #eaf2ff;
    opacity: 0.92;
    font-weight: 800;
  }
  #dnaModal .node:hover .bubble {
    transform: scale(1.06);
  }
  #dnaModal .node.dim .bubble,
  #dnaModal .node.dim text {
    opacity: 0.35;
  }

  /* Seitentafel */
  #dnaModal .dna-panel {
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: min(480px, 36vw);
    max-height: 70vh;
    overflow: auto;
    background: rgba(10, 14, 20, 0.78);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 14px 16px;
    color: #dfe8ff;
    backdrop-filter: blur(10px) saturate(120%);
    box-shadow: 0 22px 70px rgba(0, 0, 0, 0.35);
    z-index: 2;
  }
  #dnaModal .dna-panel h3 {
    margin: 0.3rem 0 0.4rem;
    font-size: 15px;
    opacity: 0.92;
  }
  #dnaModal .dna-panel h4 {
    margin: 0.6rem 0 0.2rem;
    font-size: 13px;
    color: #b7c8e0;
  }
  #dnaModal .dna-ul {
    margin: 0.2rem 0 0.6rem;
    padding-left: 1.1rem;
  }
  #dnaModal .dna-ul li {
    margin: 0.25rem 0;
  }
  #dnaModal .dna-kv {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 12px;
    color: #b9c6d8;
    border-bottom: 1px dashed var(--line);
    padding: 6px 0;
  }
  #dnaModal .dna-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--line);
    margin: 2px 4px 0 0;
    font-size: 11px;
  }

  /* Tooltip */
  #dnaModal .tip {
    position: fixed;
    z-index: 5;
    pointer-events: none;
    background: rgba(9, 13, 18, 0.92);
    color: #eaf2ff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 12px;
    max-width: 320px;
    filter: var(--shadow);
  }
</style>

