  <!-- JS: Tabs & Missions (✓-Badge je Tab via localStorage) -->
  <script>
    (function(){
      const root = document.getElementById('mkGuide'); if(!root) return;
      const cid = root.dataset.customer || 'guest';
      const key = id => `ac_mk_${id}_${cid}`;

      // Tab switch
      root.querySelectorAll('.tab').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          const id = btn.dataset.tab;
          root.querySelectorAll('.tab').forEach(b=>b.setAttribute('aria-selected','false'));
          btn.setAttribute('aria-selected','true');
          root.querySelectorAll('.pane').forEach(p=>p.classList.remove('active'));
          const pane = root.querySelector(`#pane-${id}`);
          pane?.classList.add('active');
          pane?.scrollIntoView({behavior:'smooth', block:'start'});
        });
      });

      // Load/save tasks per pane
      root.querySelectorAll('.pane').forEach(pane=>{
        const pid = pane.id.replace('pane-','');
        const saved = load(pid);
        pane.querySelectorAll('input[type="checkbox"][data-task]').forEach(cb=>{
          cb.checked = !!saved[cb.dataset.task];
          cb.addEventListener('change', ()=>{
            const s = load(pid); s[cb.dataset.task] = cb.checked; save(pid, s);
            updateTabDone(pid);
          });
        });
        updateTabDone(pid);
      });

      function load(id){ try { return JSON.parse(localStorage.getItem(key(id))||'{}'); } catch(e){ return {}; } }
      function save(id, obj){ localStorage.setItem(key(id), JSON.stringify(obj)); }
      function updateTabDone(id){
        const pane = root.querySelector(`#pane-${id}`);
        const all = pane.querySelectorAll('input[type="checkbox"][data-task]');
        const done = all.length>0 && [...all].every(c=>c.checked);
        root.querySelector(`#tab-${id}`)?.classList.toggle('done', done);
      }
    })();
  </script>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // Copy buttons
  document.querySelectorAll('#pane-found [data-copy]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const sel = btn.getAttribute('data-copy');
      const el = document.querySelector('#pane-found ' + sel);
      if (!el) return;
      el.select(); document.execCommand('copy');
      btn.textContent = 'Kopiert ✓'; setTimeout(()=>btn.textContent='Kopieren',1200);
    });
  });
  // Platform segmented control
  const seg = document.getElementById('fSeg');
  if (seg){
    const panes = { ig:'fp-ig', tt:'fp-tt', li:'fp-li', pi:'fp-pi' };
    seg.querySelectorAll('button').forEach(b=>{
      b.addEventListener('click', ()=>{
        seg.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed','false'));
        b.setAttribute('aria-pressed','true');
        Object.values(panes).forEach(id=>document.getElementById(id)?.classList.remove('active'));
        document.getElementById(panes[b.dataset.p])?.classList.add('active');
      });
    });
  }
});
</script>


<script>
document.addEventListener('DOMContentLoaded', function () {
  // Copy buttons (pane-agnostisch)
  document.querySelectorAll('.pane [data-copy]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const pane = btn.closest('.pane');
      const sel = btn.getAttribute('data-copy');
      const el = pane.querySelector(sel);
      if (!el) return;
      el.select(); document.execCommand('copy');
      const txt = btn.textContent;
      btn.textContent = 'Kopiert ✓';
      setTimeout(()=>btn.textContent = txt, 1200);
    });
  });

  // Segmented controls (pane-agnostisch)
  document.querySelectorAll('.pane .f-seg').forEach(seg=>{
    const buttons = seg.querySelectorAll('button');
    buttons.forEach(b=>{
      b.addEventListener('click', ()=>{
        buttons.forEach(x=>x.setAttribute('aria-pressed','false'));
        b.setAttribute('aria-pressed','true');
        // Panes in demselben Abschnitt schalten
        const container = seg.closest('.f-body');
        container.querySelectorAll('.f-pane').forEach(p=>p.classList.remove('active'));
        const id = (seg.id === 'rSeg')
          ? `rp-${b.dataset.p}`     // Reels-Panes
          : b.dataset.target;       // generisch
        container.querySelector(`#${id}`)?.classList.add('active');
      });
    });
  });
});
</script>


<script>
document.addEventListener('DOMContentLoaded', () => {
  const root = document.querySelector('#pane-copy');
  if (!root) return;

  // Copy-Buttons
  root.querySelectorAll('[data-copy]').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const sel = btn.getAttribute('data-copy');
      const el = root.querySelector(sel);
      if (!el) return;
      el.select(); document.execCommand('copy');
      btn.textContent = 'Kopiert ✓';
      setTimeout(()=>btn.textContent='Kopieren',1000);
    });
  });

  // Segmented Control
  const seg = root.querySelector('#cSeg');
  if (seg){
    const panes = {
      hooks: root.querySelector('#cp-hooks'),
      structure: root.querySelector('#cp-structure'),
      tone: root.querySelector('#cp-tone')
    };
    seg.querySelectorAll('button').forEach(b=>{
      b.addEventListener('click',()=>{
        seg.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed','false'));
        b.setAttribute('aria-pressed','true');
