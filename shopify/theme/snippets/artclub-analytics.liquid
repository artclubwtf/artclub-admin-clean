{% comment %}
  ARTCLUB Shopify analytics snippet.

  Expected optional data attributes on artist/profile modules and artwork cards:
  - data-artclub-track-impression="artist|artwork"
  - data-artclub-track-click="artwork|shopify_product"
  - data-artclub-page-handle="{{ page.handle }}"
  - data-artclub-page-url="{{ page.url }}"
  - data-artclub-artist-id="{{ canonical_artist_id }}"
  - data-artclub-artist-slug="{{ artist_slug }}"
  - data-artclub-artist-metaobject-id="{{ artist_metaobject_id }}"
  - data-artclub-artist-name="{{ artist_name }}"
  - data-artclub-product-id="{{ canonical_product_id }}"
  - data-artclub-product-key="{{ product_key }}"
  - data-artclub-shopify-product-id="{{ product.id }}"
  - data-artclub-product-handle="{{ product.handle }}"

  Replace `artclub_admin_base_url` with the deployed admin base URL that serves:
  - /shopify/artclub-analytics.js
  - /api/analytics/track
{% endcomment %}

{%- liquid
  assign artclub_admin_base_url = settings.artclub_admin_base_url | default: 'https://coral-app-tsv6g.ondigitalocean.app'
  assign artclub_artist_slug_value = artist_slug | default: blank
  assign artclub_artist_name_value = artist_name | default: blank
  assign artclub_artist_metaobject_id_value = artist_metaobject_id | default: blank
  assign artclub_page_handle_value = page.handle | default: blank
  assign artclub_page_url_value = page.url | default: blank

  if product != blank and product.metafields.custom.kunstler != blank and product.metafields.custom.kunstler.value != blank
    assign artclub_product_artist = product.metafields.custom.kunstler.value
    if artclub_artist_slug_value == blank
      assign artclub_artist_slug_value = artclub_product_artist.system.handle
    endif
    if artclub_artist_name_value == blank
      assign artclub_artist_name_value = artclub_product_artist.name | default: artclub_product_artist.system.title
    endif
    if artclub_artist_metaobject_id_value == blank
      assign artclub_artist_metaobject_id_value = artclub_product_artist.system.id
    endif
  endif
-%}

<script>
  window.ARTCLUB_ANALYTICS_CONFIG = {
    endpoint: {{ artclub_admin_base_url | append: '/api/analytics/track' | json }},
    pageHandle: {{ artclub_page_handle_value | json }},
    pageUrl: {{ artclub_page_url_value | json }},
    canonicalArtistId: {{ canonical_artist_id | default: blank | json }},
    artistSlug: {{ artclub_artist_slug_value | json }},
    artistMetaobjectId: {{ artclub_artist_metaobject_id_value | json }},
    artistName: {{ artclub_artist_name_value | json }},
    canonicalProductId: {{ canonical_product_id | default: blank | json }},
    productKey: {{ product_key | default: blank | json }},
    shopifyProductId: {{ product.id | default: blank | json }},
    productHandle: {{ product.handle | default: blank | json }}
  };
</script>
<script src="{{ artclub_admin_base_url }}/shopify/artclub-analytics.js" defer crossorigin="anonymous"></script>
