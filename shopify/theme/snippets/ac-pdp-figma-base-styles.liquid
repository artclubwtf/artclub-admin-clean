/* Shared base styles for the section-scoped Figma PDP variants. */
#ac-pdp-figma-{{ section_id }}.ac-pdp-figma{ background:#fff; padding:56px 0 90px; }
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__wrap{ max-width:1280px; margin:0 auto; padding:0 24px; }

#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__top{
  display:flex; align-items:flex-start; justify-content:space-between; gap:24px; margin-bottom:26px;
}
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__back{
  margin-top:10px; display:inline-flex; gap:8px; align-items:center; text-decoration:none;
  font-size:13px; color:#0b0b0c; opacity:.6; transition:opacity .18s ease;
}
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__back:hover{ opacity:.95; }
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__title{
  font-size:clamp(34px, 5vw, 58px); line-height:1.02; letter-spacing:-0.02em;
  font-weight:650; margin:0 0 14px; color:#0b0b0c;
}
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__artistRow{ display:flex; align-items:center; gap:12px; margin-top:2px; }
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__avatar{
  width:40px; height:40px; border-radius:999px; overflow:hidden; background:#e9e9ee; flex:0 0 auto;
  display:flex; align-items:center; justify-content:center; border:1px solid rgba(0,0,0,0.06);
}
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__avatar img{ width:100%; height:100%; object-fit:cover; display:block; }
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__avatarFallback{
  font-size:12px; color:#111; opacity:.7; font-weight:{{ avatar_font_weight }}; letter-spacing:.02em;
}
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__artistName{ font-size:18px; font-weight:600; color:#0b0b0c; opacity:.92; margin:0; }

#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__actions{
  display:flex; align-items:center; gap:12px; margin-top:10px; flex:0 0 auto;
}
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__iconBtn{
  width:44px; height:44px; border-radius:999px; border:1px solid rgba(0,0,0,0.10); background:#fff;
  display:flex; align-items:center; justify-content:center; cursor:pointer;
  transition:transform .16s ease, border-color .16s ease, box-shadow .16s ease;
}
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__iconBtn:hover{
  transform:translateY(-1px); border-color:rgba(0,0,0,0.16); box-shadow:0 10px 26px rgba(0,0,0,0.08);
}
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__iconBtn svg{ width:18px; height:18px; display:block; }
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__iconBtn.is-active svg path{ fill:#0b0b0c; stroke:#0b0b0c; }

#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__pillBtn{
  height:44px; padding:0 18px; border-radius:999px; border:1px solid rgba(0,0,0,0.10); background:#fff;
  color:#0b0b0c; font-size:14px; font-weight:600; cursor:pointer;
  transition:transform .16s ease, border-color .16s ease, box-shadow .16s ease;
  display:inline-flex; align-items:center; justify-content:center; white-space:nowrap;
}
#ac-pdp-figma-{{ section_id }} .ac-pdp-figma__pillBtn:hover{
  transform:translateY(-1px); border-color:rgba(0,0,0,0.16); box-shadow:0 10px 26px rgba(0,0,0,0.08);
}
