r Countdown beendet ist, zeige einen Text\n  if (distance < 0) {\n    clearInterval(x);\n    document.getElementById(\"timer\").innerHTML = \"EXPIRED\";\n  }\n}, 1000);\n<\/script>\n<\/div>"}},"price_8jbhtN":{"type":"price","settings":{}},"buy_buttons_DWJkrj":{"type":"buy_buttons","settings":{"show_dynamic_checkout":true,"show_gift_card_recipient":true}},"share_EDPbRw":{"type":"share","settings":{"share_label":"Share"}}},"block_order":["text_kYyYih","custom_liquid_VAn6By","price_8jbhtN","buy_buttons_DWJkrj","share_EDPbRw"],"disabled":true,"settings":{"product":"fan_06","color_scheme":"","secondary_background":false,"media_size":"medium","constrain_to_viewport":true,"media_fit":"contain","media_position":"left","image_zoom":"lightbox","hide_variants":false,"enable_video_looping":false,"padding_top":36,"padding_bottom":36}},"featured_collection_BB8PML":{"type":"featured-collection","disabled":true,"custom_css":[".card__content {max-height: 120px;}",".card__inner.color-background-1.gradient.ratio {height: calc(100% - 120px); background: #f1f1f1; align-content: center; justify-content: center;}",".media.media--transparent.media--hover-effect {background: #f1f1f1;}",".card__media .media img {width: 100% !important; height: 100% !important; object-fit: contain !important; padding: 1rem 0.5rem; mix-blend-mode: darken;}"],"settings":{"title":"Heruntergesetzte Kunstoriginale","heading_size":"h2","description":"<p><em><strong>ZAHLE BIS ZU 30% WENIGER | RABATT KOMBINIERBAR MIT 20% SALE<\/strong><\/em><\/p>","show_description":false,"description_style":"body","collection":"sale-produkte","products_to_show":4,"columns_desktop":4,"full_width":false,"show_view_all":true,"view_all_style":"solid","enable_desktop_slider":false,"color_scheme":"","image_ratio":"adapt","image_shape":"default","show_secondary_image":false,"show_vendor":false,"show_rating":false,"enable_quick_add":false,"columns_mobile":"2","swipe_on_mobile":false,"padding_top":36,"padding_bottom":36}},"featured_collectio